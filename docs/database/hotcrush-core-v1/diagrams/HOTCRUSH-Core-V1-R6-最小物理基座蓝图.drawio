Color=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="supplier_item_id → supplier_item_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_scm_supplier_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_replenishment_title" target="scm_replenishment_tbl_scm_replenishment_run"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_replenishment_title" label="补货建议、批准量与原因&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05F｜补货建议、批准量与原因 · 本页覆盖 2 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="200.24" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_replenishment_tbl_scm_replenishment_run" label="&lt;b&gt;scm_replenishment_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、可用库存、在途、安全量、MOQ和提前期转换为建议订货。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 需求日期 × 一次补货计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="702.01" y="484.24" width="340.00" height="237.00" as="geometry"/></mxCell></object><object id="scm_replenishment_tbl_scm_replenishment_line" label="&lt;b&gt;scm_replenishment_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 供应商商品版本候选一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_run.replenishment_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND replenishment_run_id + material_id + supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps计算；采购人员批准&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="702.01" y="108.24" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="scm_replenishment_view_v_scm_replenishment_trace" label="&lt;b&gt;v_scm_replenishment_trace&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：replenishment_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:PROCUREMENT_AND_INVENTORY&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、库存、在途、安全量、建议量、批准量、PO和收货串成一行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 可选供应商商品版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_replenishment_run / scm_replenishment_line / scm_supplier_item / scm_purchase_order_line / scm_purchase_order_revision / scm_goods_receipt_line&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• replenishment_line_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_item_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• required_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• available_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• in_transit_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• suggested_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1144.98" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="79.00" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1038.98" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="719.01" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1359.02" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_material_requirement_run" label="&lt;b&gt;REF · scm_material_requirement_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;把已发布生产计划按生效配方展开成原料需求，并冻结输入版本。&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="399.00" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_supplier_item" label="&lt;b&gt;REF · scm_supplier_item&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1678.98" y="793.24" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1629.51" y="150.24" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-31-scm-purchase-order" name="05G｜采购单版本与订单行"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2311" pageHeight="1007" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="713.01" y="82.71" width="390.00" height="723.51" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1234.97" y="59.21" width="362.00" height="369.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52.00" y="828.22" width="2222.01" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1842.47" y="116.21" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="supplier_id → supplier_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_ref_scm_supplier"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="deliver_to_location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="based_on_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="purchase_order_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="supplier_item_id → supplier_item_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_supplier_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="replenishment_line_id → replenishment_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_replenishment_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="order_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_purchase_order_title" target="scm_purchase_order_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_purchase_order_title" label="采购单版本与订单行&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05G｜采购单版本与订单行 · 本页覆盖 2 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="97.00" y="200.21" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_tbl_scm_purchase_order_revision" label="&lt;b&gt;scm_purchase_order_revision&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：直接保留某采购单号每次草稿、审批、发送、供应商确认或取消，不再另建空壳采购主单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购单号 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier.supplier_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; deliver_to_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_code + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程；审批人改变状态&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="729.01" y="484.22" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_tbl_scm_purchase_order_line" label="&lt;b&gt;scm_purchase_order_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存采购版本中已确认的供应商商品版本、订购包装数量、单位价格和来源补货行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购版本 × 供应商商品版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_line.replenishment_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_revision_id + supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="747.01" y="116.71" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_view_v_scm_purchase_order_reconciliation" label="&lt;b&gt;v_scm_purchase_order_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:PROCUREMENT_AND_INVENTORY&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较采购单批准版本的冻结单头金额与最小采购行汇总，保留正式单据同时证明合计没有漂移。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购订单版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_purchase_order_revision / scm_purchase_order_line&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• purchase_order_revision_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• purchase_order_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• revision_no : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_subtotal_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• line_amount_sum : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• subtotal_difference : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_tax_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_total_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1250.97" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1028.03" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="707.99" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="68.00" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1348.00" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_replenishment_line" label="&lt;b&gt;REF · scm_replenishment_line&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1667.97" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_supplier" label="&lt;b&gt;REF · scm_supplier&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;维护供应商稳定身份、采购币种、付款条件和状态。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="388.00" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_supplier_item" label="&lt;b&gt;REF · scm_supplier_item&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1988.01" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1858.47" y="150.21" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
