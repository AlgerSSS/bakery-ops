<diagram id="hotcrush-foundation-3" name="03 新模块快速接入">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="group_0" value="01 新模块接入九步" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="56" y="96" width="298" height="1340" as="geometry" />
        </mxCell>
        <mxCell id="group_1" value="02 联动边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontColor=#82b366;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="356" y="1126" width="968" height="166" as="geometry" />
        </mxCell>
        <mxCell id="group_2" value="03 扩展结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="636" y="1446" width="418" height="336" as="geometry" />
        </mxCell>
        <mxCell id="p3-title" value="未来新模块 X：按固定接入流程获得跨模块联动能力" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#1f2937;strokeColor=#111827;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;fontColor=#ffffff;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="420" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3-owner" value="1｜声明唯一写者&#10;确定 &lt;domain&gt;_ 前缀&#10;列出允许写入的表" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="44" y="24" width="220" height="106" as="geometry" />
        </mxCell>
        <mxCell id="p3-anchor" value="2｜选择共享锚点&#10;location / business_day&#10;product / employment / material…" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="164" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-table" value="3｜建立强类型表&#10;一表一个事实粒度&#10;PK、FK、唯一约束、状态约束" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="314" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-source" value="4｜接入来源与追溯&#10;批次、外部 ID、hash&#10;解析版本与质量状态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="464" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-bridge" value="5｜增加必要关系桥&#10;只连接真实业务关系&#10;有效期、证据、确认人" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="604" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-view" value="6｜发布契约视图&#10;稳定字段、粒度、单位&#10;缺失与估算状态显式输出" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="754" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-event" value="7｜发布分域事件&#10;outbox 与事实同事务&#10;带 causation_id 与 payload_version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="24" y="904" width="245" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-index" value="8｜加入统一只读索引&#10;关系导航、业务时间线&#10;质量状态与来源追踪" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="1054" width="235" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-security" value="9｜收口权限并验收&#10;角色 / RLS / FK 索引&#10;契约测试、重放、幂等与对账" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="1204" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p3-write" value="写入路径&#10;新模块只写 &lt;domain&gt;_* 与本域 outbox&#10;需要改变别的域 → 发布请求事件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="654" y="24" width="290" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p3-read" value="读取路径&#10;共享身份 + 分域契约视图&#10;统一关系索引与时间线仅用于发现 / 查询" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="344" y="24" width="290" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p3-no-copy" value="不允许&#10;复制一套自己的门店 / 产品 / 员工主数据&#10;直接读取其他域内部表并依赖私有列" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="24" y="24" width="300" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p3-result" value="接入完成后的能力&#10;立即按地点、经营日和稳定身份联动既有模块&#10;内部实现可独立演进，不破坏其他消费者" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_2">
          <mxGeometry x="34" y="24" width="360" height="128" as="geometry" />
        </mxCell>
        <mxCell id="p3-mart" value="需要新报表 / AI / 自动化时&#10;基于契约视图建立专用 view / materialized view / mart&#10;不反向污染权威事实层" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ecfccb;strokeColor=#65a30d;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_2">
          <mxGeometry x="24" y="184" width="370" height="128" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="html=1;rounded=0;" edge="1" parent="1" source="p3-title" target="p3-owner">
