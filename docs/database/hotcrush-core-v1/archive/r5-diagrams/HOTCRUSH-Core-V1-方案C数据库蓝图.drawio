urce="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="recipe_version_id → recipe_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_tbl_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="input_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="cost_recipe_title" target="cost_recipe_tbl_cost_card_recipe"><mxGeometry relative="1" as="geometry"/></mxCell><object id="cost_recipe_title" label="配方、版本与组成展开&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;06A｜配方、版本与组成展开 · 本页覆盖 3 张表、2 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="576.75" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="cost_recipe_tbl_cost_card_recipe" label="&lt;b&gt;cost_card_recipe&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：提供一个稳定配方身份；具体产出对象、用量和有效期放在版本表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个企业配方一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="897.25" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="cost_recipe_tbl_cost_card_recipe_version" label="&lt;b&gt;cost_card_recipe_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结配方产出对象、批产量、生效区间、售价参考和发布状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe.recipe_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; yield_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; effective_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(recipe_id, tstzrange(effective_from, effective_to, &amp;#x27;[)&amp;#x27;)) WHERE status = &amp;#x27;PUBLI…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="433.25" width="340.00" height="392.00" as="geometry"/></mxCell></object><object id="cost_recipe_tbl_cost_card_recipe_component" label="&lt;b&gt;cost_card_recipe_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存配方版本的统一原料用量、损耗和净得率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方版本 × 原料 × 序号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; input_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_version_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="99.75" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="cost_recipe_view_v_cost_card_recipe_current" label="&lt;b&gt;v_cost_card_recipe_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按时点选择产品或半成品当前已发布配方版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：产品或半成品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_recipe / cost_card_recipe_version&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• batch_yield_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• effective_from : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• effective_to : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1091.99" y="101.75" width="330.00" height="251.00" as="geometry"/></mxCell></object><object id="cost_recipe_view_v_cost_card_recipe_expanded" label="&lt;b&gt;v_cost_card_recipe_expanded&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：递归展开产品和半成品配方到最终统一原料，并保留路径和累计用量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：顶层配方版本 × 路径 × 最终原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_recipe_version / cost_card_recipe_component / scm_material&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• root_recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• path_recipe_version_ids : uuid[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• path_component_ids : uuid[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• base_unit_quantity_per_output : numeric(18,10)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• depth : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1472.01" y="93.25" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1206.02" y="1190.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="566.00" y="1190.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_ops_product" label="&lt;b&gt;REF · ops_product&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护 HOT CRUSH 可销售、可生产产品的稳定身份，不等同于某门店 POS listing。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="885.98" y="1190.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1525.98" y="1190.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1846.02" y="1190.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1851.48" y="134.25" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
