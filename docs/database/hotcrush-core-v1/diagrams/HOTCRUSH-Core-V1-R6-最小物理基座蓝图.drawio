mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_question" target="chain_05_tbl_ops_forecast_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="forecast_run_id → forecast_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_forecast_run" target="chain_05_tbl_ops_production_plan_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="production_plan_version_id → production_plan_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_version" target="chain_05_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="production_plan_line_id → production_plan_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_line" target="chain_05_tbl_ops_production_plan_slot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_slot" target="chain_05_tbl_ops_workload_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="workload_run_id → workload_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_workload_run" target="chain_05_tbl_ops_workload_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="workload_line_id → workload_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_workload_line" target="chain_05_tbl_ops_shift_requirement"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_shift_requirement" target="chain_05_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_joins" target="chain_05_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_05_title" label="端到端 05 · 预测到排产工作量与班表需求&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E05｜预测到排产工作量与班表需求 · 明日预计销量怎样变成分时生产量、工作分钟和关键岗位人数？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="307.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_05_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;明日预计销量怎样变成分时生产量、工作分钟和关键岗位人数？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="314.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_forecast_run" label="&lt;b&gt;ops_forecast_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结一次预测使用的目标日期、算法、输入清单和结果状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 目标营业日 × 一次算法运行一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_DECISION_OUTPUT · PASS_HISTORICAL_DECISION_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 预测任务&lt;/font&gt;" link="data:page/id,detail-05-ops-forecast"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="250.00" width="310.00" height="220.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_version" label="&lt;b&gt;ops_production_plan_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：直接保留某地点某营业日每次预测建议、人工调整、审批、发布或取消，不再为同一自然键另建空壳主单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：生产地点 × 计划营业日 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_DECISION_OUTPUT · PASS_HISTORICAL_DECISION_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_run.forecast_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + plan_business_date + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps；审批人改变状态&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_DECISION_OUTPUT · PASS_HISTORICAL_DECISION_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; suggested_by_ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_slot" label="&lt;b&gt;ops_production_plan_slot&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PRODUCTION_EXECUTION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把产品总计划拆到具体生产时段，解决总量正确但时段断货的问题。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：计划产品行 × 生产时段一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_slot_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; planned_quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_line_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="249.50" width="310.00" height="221.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_workload_run" label="&lt;b&gt;ops_workload_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION SHIFT_AND_WORKFORCE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把已发布生产计划和预测销售转换为岗位/工位所需分钟，作为班表显式上游。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 一次工作量计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; workload_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工作量任务&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2701.98" y="233.00" width="310.00" height="254.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_workload_line" label="&lt;b&gt;ops_workload_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION SHIFT_AND_WORKFORCE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某工作量运行对岗位、工位及可选产品的需求分钟和数量依据。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：工作量运行 × 岗位 × 工位 × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; workload_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; workload_run_id &lt;font color='#64748B'&gt;: uuid → ops_workload_run.workload_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND workload_run_id + role_id + station_id + product_id + workload_unit&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工作量任务&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3077.02" y="232.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_shift_requirement" label="&lt;b&gt;ops_shift_requirement&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION SHIFT_AND_WORKFORCE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：明确每个时段需要的岗位、工位、人数和关键岗位属性。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：班表版本 × 时段 × 岗位 × 工位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; shift_requirement_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; shift_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_shift_plan_version.shift_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; workload_line_id &lt;font color='#64748B'&gt;: uuid → ops_workload_line.workload_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND shift_plan_version_id + shift_start + shift_end + role_id + station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 排班流程&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3452.00" y="232.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_05_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 计划版本记录 forecast_run_id，但允许人工计划独立存在&lt;br&gt;2. 计划行和分时槽均使用 product_id；workload_line 回指 plan_line_id&lt;br&gt;3. shift_requirement 通过 workload_run_id + role_id + station_id 说明关键岗位需求"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3827.02" y="272.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_05_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;预测、批准计划、工作量计算和排班需求是四种不同事实，不能压在一张表的一行里。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4392.00" y="304.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_05_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="167.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-06" name="E06｜排产到原料毛需求"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4589" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="336.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="232.00" width="2237.03" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3455.98" y="294.00" width="1096.99" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="274.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_06_title" target="chain_06_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_question" target="chain_06_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_ops_production_plan_line" target="chain_06_tbl_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="recipe_version_id → recipe_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_cost_card_recipe_version" target="chain_06_tbl_cost_card_recipe_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_cost_card_recipe_component" target="chain_06_tbl_scm_material_requirement_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="material_requirement_run_id → material_requirement_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_scm_material_requirement_run" target="chain_06_tbl_scm_material_requirement_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_scm_material_requirement_component" target="chain_06_view_v_scm_material_requirement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_view_v_scm_material_requirement_line" target="chain_06_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_joins" target="chain_06_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_06_title" label="端到端 06 · 排产到原料毛需求&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E06｜排产到原料毛需求 · 计划生产多少产品，为什么需要订多少某种原料？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="363.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_06_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;计划生产多少产品，为什么需要订多少某种原料？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="370.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_DECISION_OUTPUT · PASS_HISTORICAL_DECISION_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; suggested_by_ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="271.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_cost_card_recipe_version" label="&lt;b&gt;cost_card_recipe_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：一行冻结一个配方代码版本的名称、产出对象、批产量、生效区间、售价参考和发布状态；不再为只有版本表引用的配方另建主档。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方代码 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; yield_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_code + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(recipe_code, tstzrange(effective_from, effective_to, &amp;#x27;[)&amp;#x27;)) WHERE status = &amp;#x27;PUB…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="266.00" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_cost_card_recipe_component" label="&lt;b&gt;cost_card_recipe_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存配方版本的统一原料用量、损耗和净得率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方版本 × 原料 × 序号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; input_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_version_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="288.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_scm_material_requirement_run" label="&lt;b&gt;scm_material_requirement_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把已发布生产计划按生效配方展开成原料需求，并冻结输入版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 计划营业日 × 一次需求计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="297.50" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_scm_material_requirement_component" label="&lt;b&gt;scm_material_requirement_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保留需求运行中每个计划产品行展开出的一个原料贡献或一个明确质量阻断；原料总需求只从这些最细行汇总。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：需求运行 × 计划产品行 × 展开序号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_component.recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_requirement_run_id + production_plan_line_id + component_index&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2701.98" y="280.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_06_view_v_scm_material_requirement_line" label="&lt;b&gt;v_scm_material_requirement_line&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：material_requirement_key&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:PROCUREMENT_AND_INVENTORY&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从最细需求组成行按运行和原料汇总毛需求、基础单位与运行质量，不保存第二份汇总事实。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：需求运行 × 原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_material_requirement_run / scm_material_requirement_component / scm_material&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_requirement_key : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_requirement_run_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• requirement_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3077.03" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_06_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. plan_line 选择发生日有效且已批准的 recipe_version_id&lt;br&gt;2. 每个配方组件用 material_id + input_quantity + input_unit_id + 已冻结单位换算展开；base_unit_quantity 由此派生&lt;br&gt;3. requirement_component 同时保留 run_id、plan_line_id、recipe_component_id、material_id 和质量状态；按 run_id + material_id 派生汇总需求"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3471.98" y="328.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_06_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;必须能从一克原料需求反查到哪张计划、哪个产品和哪个配方版本；单位不明则阻断。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4036.97" y="360.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_06_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="224.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-07" name="E07｜原料需求到建议订货、采购单和收货"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5339" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="297.99" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.01" y="193.99" width="2986.98" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4206.01" y="241.99" width="1096.98" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_07_title" target="chain_07_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_question" target="chain_07_view_v_scm_material_requirement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_view_v_scm_material_requirement_line" target="chain_07_tbl_scm_replenishment_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="replenishment_run_id → replenishment_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_replenishment_run" target="chain_07_tbl_scm_replenishment_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="supplier_item_id → supplier_item_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_replenishment_line" target="chain_07_tbl_scm_supplier_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_supplier_item" target="chain_07_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="purchase_order_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_purchase_order_revision" target="chain_07_tbl_scm_purchase_order_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="purchase_order_line_id → purchase_order_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_purchase_order_line" target="chain_07_tbl_scm_goods_receipt_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="material_id + currency" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_goods_receipt_line" target="chain_07_tbl_scm_inventory_movement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_inventory_movement_line" target="chain_07_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_joins" target="chain_07_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_07_title" label="端到端 07 · 原料需求到建议订货、采购单和收货&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E07｜原料需求到建议订货、采购单和收货 · 未来订货量为何增减，最终批准、下单和收到多少？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_07_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;未来订货量为何增减，最终批准、下单和收到多少？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="331.99" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_07_view_v_scm_material_requirement_line" label="&lt;b&gt;v_scm_material_requirement_line&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：material_requirement_key&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:PROCUREMENT_AND_INVENTORY&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从最细需求组成行按运行和原料汇总毛需求、基础单位与运行质量，不保存第二份汇总事实。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：需求运行 × 原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_material_requirement_run / scm_material_requirement_component / scm_material&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_requirement_key : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_requirement_run_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• requirement_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1202.01" y="243.99" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_replenishment_run" label="&lt;b&gt;scm_replenishment_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、可用库存、在途、安全量、MOQ和提前期转换为建议订货。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 需求日期 × 一次补货计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1596.99" y="259.49" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_replenishment_line" label="&lt;b&gt;scm_replenishment_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 供应商商品版本候选一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_run.replenishment_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND replenishment_run_id + material_id + supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps计算；采购人员批准&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1971.97" y="233.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_supplier_item" label="&lt;b&gt;scm_supplier_item&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商 × 外部SKU × 生效版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier.supplier_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; confirmed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ supplier_id + supplier_sku + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(supplier_id, supplier_sku, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WHERE mapping…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据流程&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2347.02" y="227.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_purchase_order_revision" label="&lt;b&gt;scm_purchase_order_revision&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：直接保留某采购单号每次草稿、审批、发送、供应商确认或取消，不再另建空壳采购主单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购单号 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier.supplier_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; deliver_to_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_code + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程；审批人改变状态&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2721.99" y="233.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_purchase_order_line" label="&lt;b&gt;scm_purchase_order_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存采购版本中已确认的供应商商品版本、订购包装数量、单位价格和来源补货行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购版本 × 供应商商品版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_line.replenishment_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_revision_id + supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3096.97" y="241.99" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3472.02" y="250.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_inventory_movement_line" label="&lt;b&gt;scm_inventory_movement_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存库存事件中每种原料、批号和数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：库存移动单 × 原料 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; inventory_movement_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; inventory_movement_id &lt;font color='#64748B'&gt;: uuid → scm_inventory_movement.inventory_movement_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND inventory_movement_id + material_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链库存服务&lt;/font&gt;" link="data:page/id,detail-28-scm-movement"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3846.99" y="250.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_07_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 补货建议以 material_id + destination_location_id + need_by_date 连接需求&lt;br&gt;2. 建议量和批准量分字段保留；差异量由视图计算，调整原因保留为人工决定事实&lt;br&gt;3. 正式补货和PO锁定有效期供应商商品版本 supplier_item_id，避免供应商改包装后重解释历史&lt;br&gt;4. PO 行通过 replenishment_line_id 追建议；收货行通过 purchase_order_line_id 追订单"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4222.01" y="275.99" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_07_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;在途、现存、安全量、MOQ 和订货倍数均为计算输入；人工改量必须写理由，不能覆盖 suggested_quantity。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4786.99" y="321.99" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_07_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-08" name="E08｜收货实价到成本采用价"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5360" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="336.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="232.00" width="3007.00" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4226.02" y="280.00" width="1096.99" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="274.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_08_title" target="chain_08_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_question" target="chain_08_tbl_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="from_unit_id → unit_id / to_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_app_unit" target="chain_08_tbl_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_material_unit_conversion" target="chain_08_tbl_scm_supplier_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_supplier_item" target="chain_08_tbl_scm_goods_receipt_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="goods_receipt_line_id → goods_receipt_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_goods_receipt_line" target="chain_08_tbl_scm_supplier_price_observation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="supplier_price_observation_id → supplier_price_observation_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_supplier_price_observation" target="chain_08_tbl_cost_card_material_price"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_cost_card_material_price" target="chain_08_view_v_cost_card_product_cost_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_view_v_cost_card_product_cost_component" target="chain_08_view_v_cost_card_product_cost_snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_view_v_cost_card_product_cost_snapshot" target="chain_08_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_joins" target="chain_08_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_08_title" label="端到端 08 · 收货实价到成本采用价&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E08｜收货实价到成本采用价 · 市场采购价波动如何进入配方成本，采用了哪一个价格？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="363.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_08_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;市场采购价波动如何进入配方成本，采用了哪一个价格？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="370.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_app_unit" label="&lt;b&gt;app_unit&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个受控计量单位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; canonical_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ unit_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：数据治理管理员&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="297.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_material_unit_conversion" label="&lt;b&gt;scm_material_unit_conversion&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：原料 × 起始单位 × 目标单位 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; from_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; to_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_id + from_unit_id + to_unit_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, from_unit_id, to_unit_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) W…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="266.00" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_supplier_item" label="&lt;b&gt;scm_supplier_item&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商 × 外部SKU × 生效版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier.supplier_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; confirmed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ supplier_id + supplier_sku + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(supplier_id, supplier_sku, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WHERE mapping…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据流程&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="266.00" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="288.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_supplier_price_observation" label="&lt;b&gt;scm_supplier_price_observation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：沉淀报价、PO或收货形成的原始和归一化采购价，供成本卡选择生效价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 观察时间 × 来源记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt_line.goods_receipt_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; raw_price_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + source_record_id / UQ ND goods_receipt_line_id + observation_type&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购或收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="271.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_cost_card_material_price" label="&lt;b&gt;cost_card_material_price&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从供应商价格观察或人工批准值中选择某地点、原料的有效成本价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 原料 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_price_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_price_observation.supplier_price_observation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND material_id + location_id + effective_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, COALESCE(location_id, NIL_UUID), tstzrange(effective_from, effecti…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-34-cost-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3077.02" y="266.00" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_08_view_v_cost_card_product_cost_component" label="&lt;b&gt;v_cost_card_product_cost_component&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + product_id + recipe_version_id + path_component_ids + material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_RECIPE_EXPANSION_DEPENDENCY / PRODUCT_DATE_UNIVERSE_UNDEFINED / COST_COMPONENT_FORMULA_UNDEFINED / LOCATION_PRICE_FALLBAC…&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按营业日和地点把生效配方递归展开到最终原料，并选择当时有效的成本采用价；全部结果可由配方、价格和规则重算，不落第二份成本事实。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 营业日 × 产品 × 配方路径 × 最终原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_recipe_expanded / cost_card_recipe_version / cost_card_material_price / v_pos_item_sales_day / ops_production_plan_version / ops_producti…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• path_component_ids : uuid[]&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3452.01" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_08_view_v_cost_card_product_cost_snapshot" label="&lt;b&gt;v_cost_card_product_cost_snapshot&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_COST_COMPONENT_DEPENDENCY / COST_SCOPE_RULE_UNDEFINED / QUALITY_STATUS_PRECEDENCE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从产品成本组件明细汇总某地点、营业日和产品的单位材料成本，并用批准的成本范围规则明确是否可称为总成本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_cost_component / ops_business_rule&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• unit_material_cost : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3847.00" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_08_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 收货行提供 actual_unit_price 和单位证据&lt;br&gt;2. 供应商商品版本自身保留 supplier_id + supplier_sku + material_id + 包装换算 + 有效期；价格观察锁定该 supplier_item_id&lt;br&gt;3. material_price 只引用经批准 observation_id；成本组件视图按营业日选择 recipe_version_id 和 material_price_id&lt;br&gt;4. 收货模块启用前，现有 cost_card_item_price 以 MIGRATED_MANUAL 启动价迁移并保留旧 price_id 与核验证据"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4242.02" y="314.00" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_08_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;市场报价、实际收货价和成本采用价是三层事实；没有单位换算证据的价格不得进入正式成本。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4807.01" y="360.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_08_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="224.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-09" name="E09｜当日产品毛利与覆盖率"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4294" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="336.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.01" y="248.00" width="1941.97" height="318.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3161.00" y="280.00" width="1096.98" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="274.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_09_title" target="chain_09_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_question" target="chain_09_view_v_pos_item_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="location_id + business_date + product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_pos_item_sales_day" target="chain_09_view_v_cost_card_product_cost_snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_cost_card_product_cost_snapshot" target="chain_09_view_v_cost_card_product_daily_margin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_cost_card_product_daily_margin" target="chain_09_view_v_cost_card_daily_margin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_cost_card_daily_margin" target="chain_09_view_v_app_data_quality_summary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_app_data_quality_summary" target="chain_09_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_joins" target="chain_09_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_09_title" label="端到端 09 · 当日产品毛利与覆盖率&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E09｜当日产品毛利与覆盖率 · 今天每个产品赚了多少，结论覆盖了多少销售？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="363.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_09_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;今天每个产品赚了多少，结论覆盖了多少销售？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="370.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_hour_current / pos_product_mapping / pos_product_listing&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1202.01" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_cost_card_product_cost_snapshot" label="&lt;b&gt;v_cost_card_product_cost_snapshot&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_COST_COMPONENT_DEPENDENCY / COST_SCOPE_RULE_UNDEFINED / QUALITY_STATUS_PRECEDENCE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从产品成本组件明细汇总某地点、营业日和产品的单位材料成本，并用批准的成本范围规则明确是否可称为总成本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_cost_component / ops_business_rule&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• unit_material_cost : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1597.00" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_cost_card_product_daily_margin" label="&lt;b&gt;v_cost_card_product_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_COST_SNAPSHOT_DEPENDENCY / MARGIN_QUALITY_RULE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：连接产品日销量和当天成本快照，计算销售额、COGS、毛利和覆盖率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_day / v_cost_card_product_cost_snapshot&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cost_revision_key : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1991.99" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_cost_card_daily_margin" label="&lt;b&gt;v_cost_card_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_PRODUCT_MARGIN_DEPENDENCY / COVERAGE_STATUS_THRESHOLD_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按地点和营业日汇总产品毛利，同时给出全部成本覆盖和可信成本覆盖。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_daily_margin / v_pos_sales_day_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• costed_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• trusted_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2386.98" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_app_data_quality_summary" label="&lt;b&gt;v_app_data_quality_summary&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：source_view_name + domain_code + rule_code + severity + quality_status&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_QUALITY_VIEW_DEPENDENCY / QUALITY_RULE_MAPPING_UNDEFINED / SEVERITY_MAPPING_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把各业务域只读核对视图的当前质量结论汇总成统一看板，不复制业务对象、不保存多态 entity_type/entity_id 工单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源质量视图 × 业务域 × 规则 × 严重度 × 质量状态一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_identity_mapping_gap / v_pos_revenue_reconciliation / v_pos_member_daily_summary / v_cost_card_product_cost_quality / v_finance_sales_reconciliatio…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_view_name : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• domain_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• rule_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• severity : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2781.98" y="282.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_09_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 按 location_id + business_date + product_id 连接销售和目标日成本快照&lt;br&gt;2. 数量 × unit_total_cost 得到估算成本，净销售减估算成本得到毛利&lt;br&gt;3. 缺产品映射、缺配方或缺价格的销售额进入 coverage 缺口&lt;br&gt;4. POS更正批次或配方、价格、规则变化都会改变修订键；毛利输出同时保留pos_ingest_batch_id、cost_revision_key和margin_revision_key"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3177.00" y="314.00" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_09_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;毛利率必须与成本范围、总销售覆盖率和可信成本覆盖率一起展示；没有批准间接成本规则时只能称材料贡献毛利。质量问题工作流是可选扩展，不影响视图暴露质量状态。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="3741.98" y="360.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_09_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="224.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-10" name="E10｜计划到生产、配送、销售与复盘"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5380" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="318.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="219.50" width="3027.02" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4245.97" y="276.00" width="1097.05" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_10_title" target="chain_10_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_question" target="chain_10_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="production_plan_line_id → production_plan_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_production_plan_line" target="chain_10_tbl_ops_production_run_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="production_run_line_id → production_run_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_production_run_line" target="chain_10_tbl_ops_dispatch_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_dispatch_line" target="chain_10_view_v_pos_item_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id + business_date + product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_pos_item_sales_day" target="chain_10_view_v_pos_item_waste_mapped"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="location_id + business_date + currency" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_pos_item_waste_mapped" target="chain_10_tbl_ops_stockout_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_stockout_event" target="chain_10_view_v_ops_item_daily_pulse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_ops_item_daily_pulse" target="chain_10_tbl_ops_daily_review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_daily_review" target="chain_10_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_joins" target="chain_10_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_10_title" label="端到端 10 · 计划到生产、配送、销售与复盘&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E10｜计划到生产、配送、销售与复盘 · 计划是否生产、配送并卖出，报废或断货发生在哪里？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="345.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_10_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;计划是否生产、配送并卖出，报废或断货发生在哪里？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="352.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_DECISION_OUTPUT · PASS_HISTORICAL_DECISION_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; suggested_by_ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="253.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_production_run_line" label="&lt;b&gt;ops_production_run_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PRODUCTION_EXECUTION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存实际生产的合格、报废和返工数量，并可追溯到计划行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：生产批次 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_run_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_run_id &lt;font color='#64748B'&gt;: uuid → ops_production_run.production_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_run_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店/厨房执行流程&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1576.98" y="270.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_dispatch_line" label="&lt;b&gt;ops_dispatch_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PRODUCTION_EXECUTION]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存配送中每个产品的发出、接收、拒收和差异数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配送单 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; dispatch_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; dispatch_id &lt;font color='#64748B'&gt;: uuid → ops_dispatch.dispatch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_run_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_run_line.production_run_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ dispatch_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：配送执行流程&lt;/font&gt;" link="data:page/id,detail-08-ops-dispatch"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1952.02" y="270.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_hour_current / pos_product_mapping / pos_product_listing&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2327.01" y="264.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_pos_item_waste_mapped" label="&lt;b&gt;v_pos_item_waste_mapped&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：waste_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为报废事实补充发生时点已确认product_id和标准损失分类，同时保留未映射行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一条POS报废事实一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_waste_current / pos_product_mapping&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• waste_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-15-pos-loss"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2722.00" y="264.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_stockout_event" label="&lt;b&gt;ops_stockout_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录人工确认或算法识别的断货时段、证据及估算损失。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × listing × 一次连续断货区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; stockout_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; detected_job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(location_id, listing_id, tstzrange(started_at, ended_at, &amp;#x27;[)&amp;#x27;)) WHERE status IN…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 断货检测；人工可确认&lt;/font&gt;" link="data:page/id,detail-15-pos-loss"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3116.98" y="253.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_ops_item_daily_pulse" label="&lt;b&gt;v_ops_item_daily_pulse&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:PRODUCTION_EXECUTION&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把计划、实际产出、配送、销售、报废、断货和成本质量放到同一产品日行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：ops_production_plan_line / ops_production_plan_version / ops_production_run_line / ops_dispatch_line / v_pos_item_sales_day / v_pos_item_waste_mapped…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• planned_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• produced_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3491.97" y="264.00" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_daily_review" label="&lt;b&gt;ops_daily_review&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某地点营业日的结构化复盘版本，区分人工事实、AI总结和采纳状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 复盘版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_WORKFLOW_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; daily_review_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + business_date + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 复盘流程&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3887.02" y="253.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_10_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 全部产品事实用 product_id，来源 POS 仍保留 listing_id&lt;br&gt;2. 生产回指 plan_line_id，配送回指 production_run_line_id&lt;br&gt;3. 按 location_id + business_date + product_id 汇总 planned/produced/dispatched/sold/waste/stockout"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4261.97" y="310.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_10_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;各事实不可互相推定：生产完成不等于已配送，配送不等于已售，零销量不自动等于断货。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4827.02" y="342.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_10_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
