unded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_run" target="scm_replenishment_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_run" target="scm_replenishment_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="material_requirement_run_id → material_requirement_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_run" target="scm_replenishment_ref_scm_material_requirement_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="replenishment_run_id → replenishment_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_tbl_scm_replenishment_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="supplier_item_material_mapping_id → supplier_item_material_mapping_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_scm_supplier_item_material_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_replenishment_tbl_scm_replenishment_line" target="scm_replenishment_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_replenishment_title" target="scm_replenishment_tbl_scm_replenishment_run"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_replenishment_title" label="补货建议、批准量与原因&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05F｜补货建议、批准量与原因 · 本页覆盖 2 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="185.22" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_replenishment_tbl_scm_replenishment_run" label="&lt;b&gt;scm_replenishment_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、可用库存、在途、安全量、MOQ和提前期转换为建议订货。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 需求日期 × 一次补货计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="702.01" y="454.22" width="340.00" height="237.00" as="geometry"/></mxCell></object><object id="scm_replenishment_tbl_scm_replenishment_line" label="&lt;b&gt;scm_replenishment_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 供应商商品物料映射候选一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_run.replenishment_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND replenishment_run_id + material_id + supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps计算；采购人员批准&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="702.01" y="93.22" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="scm_replenishment_view_v_scm_replenishment_trace" label="&lt;b&gt;v_scm_replenishment_trace&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、库存、在途、安全量、建议量、批准量、PO和收货串成一行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 供应商商品物料映射一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_replenishment_run / scm_replenishment_line / scm_supplier_item_material_mapping / scm_purchase_order_line / scm_purchase_order_revision / scm_goo…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• replenishment_line_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_item_material_mapping_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• required_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• available_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• in_transit_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• suggested_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1144.98" y="103.72" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="79.00" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1038.98" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="719.01" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1359.02" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_material_requirement_run" label="&lt;b&gt;REF · scm_material_requirement_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;把已发布生产计划按生效配方展开成原料需求，并冻结输入版本。&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="399.00" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_ref_scm_supplier_item_material_mapping" label="&lt;b&gt;REF · scm_supplier_item_material_mapping&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化记录某供应商 SKU 在一个生效区间内对应哪种统一物料，以及每个订购单位的基础数量。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1678.98" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_replenishment_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1629.51" y="144.72" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-31-scm-purchase-order" name="05G｜采购单、版本与订单行"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1886" pageHeight="1587" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="52.00" y="611.94" width="1456.01" height="340.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="57.00" y="294.98" width="362.00" height="318.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1548.00" y="557.00" width="302.00" height="993.97" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="79.50" y="58.99" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="supplier_id → supplier_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order" target="scm_purchase_order_ref_scm_supplier"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="deliver_to_location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order" target="scm_purchase_order_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order" target="scm_purchase_order_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="purchase_order_id → purchase_order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_tbl_scm_purchase_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="based_on_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_revision" target="scm_purchase_order_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="purchase_order_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="supplier_item_material_mapping_id → supplier_item_material_mapping_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_supplier_item_material_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="replenishment_line_id → replenishment_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_replenishment_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="order_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_purchase_order_tbl_scm_purchase_order_line" target="scm_purchase_order_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_purchase_order_title" target="scm_purchase_order_tbl_scm_purchase_order"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_purchase_order_title" label="采购单、版本与订单行&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05G｜采购单、版本与订单行 · 本页覆盖 3 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="479.99" y="491.48" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_tbl_scm_purchase_order" label="&lt;b&gt;scm_purchase_order&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：表示采购单稳定身份，供应商和交付地点固定，内容放在版本表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商 × 交付地点 × 一个采购单一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier.supplier_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; deliver_to_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1152.01" y="645.94" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_tbl_scm_purchase_order_revision" label="&lt;b&gt;scm_purchase_order_revision&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保留采购单每次草稿、审批、发送和供应商确认，不覆盖旧版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购订单 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order.purchase_order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_id + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程；审批人改变状态&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="609.99" y="663.94" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_tbl_scm_purchase_order_line" label="&lt;b&gt;scm_purchase_order_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存采购版本中已确认的供应商SKU物料映射、订购包装数量、单位价格和来源补货行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购版本 × 供应商商品物料映射一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_line.replenishment_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_revision_id + supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="68.00" y="646.44" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_view_v_scm_purchase_order_reconciliation" label="&lt;b&gt;v_scm_purchase_order_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较采购单批准版本的冻结单头金额与最小采购行汇总，保留正式单据同时证明合计没有漂移。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购订单版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_purchase_order_revision / scm_purchase_order_line&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• purchase_order_revision_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• purchase_order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• revision_no : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_subtotal_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• line_amount_sum : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• subtotal_difference : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_tax_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• header_total_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="73.00" y="328.98" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1016.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="874.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="591.00" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1158.96" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_replenishment_line" label="&lt;b&gt;REF · scm_replenishment_line&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1300.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_supplier" label="&lt;b&gt;REF · scm_supplier&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;维护供应商稳定身份、采购币种、付款条件和状态。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="732.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_ref_scm_supplier_item_material_mapping" label="&lt;b&gt;REF · scm_supplier_item_material_mapping&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化记录某供应商 SKU 在一个生效区间内对应哪种统一物料，以及每个订购单位的基础数量。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1442.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_purchase_order_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="95.50" y="92.99" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
