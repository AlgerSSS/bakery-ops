geometry"/></mxCell><mxCell id="layout_edge_6" value="唯一责任写入" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2.3;" edge="1" parent="1" source="projects_res_api" target="projects_domain_pos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="唯一责任写入" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2.3;" edge="1" parent="1" source="projects_finance_web" target="projects_domain_finance"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="唯一责任写入" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2.3;" edge="1" parent="1" source="projects_finance_web" target="projects_domain_cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="唯一责任写入" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2.3;" edge="1" parent="1" source="projects_finance_web" target="projects_domain_app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="唯一责任写入" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2.3;" edge="1" parent="1" source="projects_hbti_web" target="projects_domain_mkt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="审计 / 质量 / 权限" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#9A7B24;strokeWidth=1.1;dashed=1;dashPattern=6 4;fontColor=#6D5100;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#5F7896;fontColor=#40566E;" edge="1" parent="1" source="projects_bakery_ops" target="projects_domain_app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="审计 / 质量 / 权限" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#9A7B24;strokeWidth=1.1;dashed=1;dashPattern=6 4;fontColor=#6D5100;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#5F7896;fontColor=#40566E;" edge="1" parent="1" source="projects_res_api" target="projects_domain_app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="审计 / 质量 / 权限" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#9A7B24;strokeWidth=1.1;dashed=1;dashPattern=6 4;fontColor=#6D5100;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#5F7896;fontColor=#40566E;" edge="1" parent="1" source="projects_finance_web" target="projects_domain_app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="审计 / 质量 / 权限" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=none;endArrow=open;endFill=0;strokeColor=#9A7B24;strokeWidth=1.1;dashed=1;dashPattern=6 4;fontColor=#6D5100;fontSize=9;labelBackgroundColor=#FFFFFF;strokeColor=#5F7896;fontColor=#40566E;" edge="1" parent="1" source="projects_hbti_web" target="projects_domain_app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_15" value="逐项验证" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="projects_conflict" target="projects_proof"><mxGeometry relative="1" as="geometry"/></mxCell><object id="projects_title" label="谁写什么，跨域只通过稳定契约协作&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;12｜四个项目写入边界 · 应用只能写自己负责的来源事实；跨域分析通过稳定 ID、只读视图和受控函数&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="1372.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="projects_bakery_ops" label="&lt;b&gt;BakeryOps&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;/Users/weiliangshao/hot/bakery-ops&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;写：&lt;/b&gt;ops_*、hr_*、scm_*、msg_*、ai_*；app_job_run / app_data_quality_issue&lt;br&gt;&lt;b&gt;读：&lt;/b&gt;全部受治理视图及本项目负责的业务表&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;边界：&lt;/b&gt;不得直接写 finance_*、cost_card_*、pos_* 的来源事实。人工运营动作写 ops_*，不要覆盖 POS 或财务来源事实。&lt;/font&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="719.99" y="1337.50" width="390.00" height="175.00" as="geometry"/></mxCell></object><object id="projects_res_api" label="&lt;b&gt;RES/POS 抓取与同步&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;/Users/weiliangshao/hot/res_api&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;写：&lt;/b&gt;pos_ingest_batch、pos_product_listing、pos_sales_*、pos_item_*、pos_member_*&lt;br&gt;&lt;b&gt;读：&lt;/b&gt;app_source_system、地点来源映射、数据质量结果&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;边界：&lt;/b&gt;只忠实记录来源，不自行创造 product_id；企业产品映射必须走 pos_product_mapping 的确认流程。&lt;/font&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="719.99" y="1112.47" width="390.00" height="175.00" as="geometry"/></mxCell></object><object id="projects_finance_web" label="&lt;b&gt;财务网站&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;/Users/weiliangshao/Library/Mobile Documents/iCloud~md~obsidian/Documents/Brain/raw/General/雅楠需求/门店财务AI分析系统&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;写：&lt;/b&gt;finance_*、cost_card_*、app_user / app_role / app_audit_event&lt;br&gt;&lt;b&gt;读：&lt;/b&gt;POS、供应链、人员工时及成本治理视图&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;边界：&lt;/b&gt;财务导入事实不得反写覆盖 POS；成本卡采用价与供应商原始报价分开；所有地点和产品使用稳定 ID。&lt;/font&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="719.99" y="887.47" width="390.00" height="175.00" as="geometry"/></mxCell></object><object id="projects_hbti_web" label="&lt;b&gt;HBTI 活动网站&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;/Users/weiliangshao/hot/hbti-web&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;写：&lt;/b&gt;mkt_campaign_*、mkt_survey_*、mkt_reward_*；受控一次性令牌&lt;br&gt;&lt;b&gt;读：&lt;/b&gt;最小化会员身份、活动配置和奖励库存&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;边界：&lt;/b&gt;不得再把活动当前状态写回 pos_member；不得复制会员手机号到营销事实表。&lt;/font&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="719.99" y="662.47" width="390.00" height="175.00" as="geometry"/></mxCell></object><object id="projects_domain_app" label="&lt;b&gt;APP · 治理、权限与质量&lt;/b&gt;&lt;br&gt;15 表 / 3 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 15 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="950.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_ops" label="&lt;b&gt;OPS · 地点、产品、预测、计划、执行与班表&lt;/b&gt;&lt;br&gt;33 表 / 12 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 25 · PLANNED 8 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1922.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_pos" label="&lt;b&gt;POS · POS目录、销售与会员&lt;/b&gt;&lt;br&gt;19 表 / 9 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 17 · PLANNED 0 · SOURCE? 2&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1112.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_hr" label="&lt;b&gt;HR · 人员、招聘、培训与工时&lt;/b&gt;&lt;br&gt;22 表 / 3 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 15 · PLANNED 5 · SOURCE? 2&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-19-hr-person"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1760.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_scm" label="&lt;b&gt;SCM · 原料、库存、补货、采购与收货&lt;/b&gt;&lt;br&gt;23 表 / 7 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 9 · PLANNED 14 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1598.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_cost" label="&lt;b&gt;COST · 配方、采购价、成本快照与毛利&lt;/b&gt;&lt;br&gt;7 表 / 7 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 7 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="788.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_finance" label="&lt;b&gt;FINANCE · 财务来源事实与核对&lt;/b&gt;&lt;br&gt;12 表 / 6 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 12 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-36-finance-sales"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="626.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_mkt" label="&lt;b&gt;MKT · 营销、HBTI问卷与奖励&lt;/b&gt;&lt;br&gt;11 表 / 2 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 11 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="464.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_msg" label="&lt;b&gt;MSG · 消息、会话与投递&lt;/b&gt;&lt;br&gt;7 表 / 1 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 7 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-42-msg-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1436.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_ai" label="&lt;b&gt;AI · Prompt版本与AI调用&lt;/b&gt;&lt;br&gt;5 表 / 0 视图&lt;br&gt;&lt;font color='#64748B'&gt;CORE 5 · PLANNED 0 · SOURCE? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-43-ai-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1274.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_conflict" label="&lt;b&gt;当前必须拆开的双写/混写&lt;/b&gt;&lt;br&gt;daily_revenue：POS 与财务分表&lt;br&gt;pos_member：POS 会员与 HBTI 活动分表&lt;br&gt;门店/产品/人员：统一身份，不各自造主数据&lt;br&gt;schema_migrations：增加 repository_code 命名空间"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="142.00" y="463.00" width="420.00" height="150.00" as="geometry"/></mxCell></object><object id="projects_proof" label="&lt;b&gt;“适配”验收证据&lt;/b&gt;&lt;br&gt;生产部署清单 + 连接角色&lt;br&gt;旧请求/响应或 SQL 契约&lt;br&gt;影子读取逐日核对&lt;br&gt;双写高水位与幂等键&lt;br&gt;独立回滚开关和演练"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="734.99" y="467.00" width="360.00" height="142.00" as="geometry"/></mxCell></object><object id="projects_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#D9534F'&gt;■&lt;/font&gt; &lt;b&gt;FINANCE&lt;/b&gt; = 财务来源事实与核对&lt;br&gt;&lt;font color='#C94F8C'&gt;■&lt;/font&gt; &lt;b&gt;MKT&lt;/b&gt; = 营销、HBTI问卷与奖励&lt;br&gt;&lt;font color='#4D7FC1'&gt;■&lt;/font&gt; &lt;b&gt;MSG&lt;/b&gt; = 消息、会话与投递&lt;br&gt;&lt;font color='#7057B8'&gt;■&lt;/font&gt; &lt;b&gt;AI&lt;/b&gt; = Prompt版本与AI调用&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="182.00" y="93.52" width="340.00" height="319.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
