o;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_application"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="appointment_id → appointment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="assessor_employment_id → employment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_employment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="assessment_id → assessment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment_score" target="hr_evaluation_hire_tbl_hr_assessment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="appointment_id → appointment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_trial" target="hr_evaluation_hire_ref_hr_appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="assessment_id → assessment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_trial" target="hr_evaluation_hire_tbl_hr_assessment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_trial" target="hr_evaluation_hire_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="application_id → application_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_hr_application"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="supersedes_offer_id → offer_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_tbl_hr_offer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="role_id → role_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_ops_role"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="hr_evaluation_hire_title" target="hr_evaluation_hire_tbl_hr_assessment"><mxGeometry relative="1" as="geometry"/></mxCell><object id="hr_evaluation_hire_title" label="评估、试工与Offer&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;04D｜评估、试工与Offer · 本页覆盖 4 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="193.71" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_assessment" label="&lt;b&gt;hr_assessment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次结构化评估的建议、红线结论、评估者和模板版本；总分由明细视图派生。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：申请 × 评估类型 × 一次评估一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; assessment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; appointment_id &lt;font color='#64748B'&gt;: uuid → hr_appointment.appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; assessor_employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或业务面试官&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="471.21" width="340.00" height="220.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_assessment_score" label="&lt;b&gt;hr_assessment_score&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存评分、权重、红线和证据，避免只有总分无法解释。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：评估 × 评分项目一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; assessment_score_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; assessment_id &lt;font color='#64748B'&gt;: uuid → hr_assessment.assessment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ assessment_id + criterion_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或业务面试官&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="144.21" width="340.00" height="204.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_trial" label="&lt;b&gt;hr_trial&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录试工时段、实际到场、工作结果和最终建议。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次试工预约一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; trial_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; appointment_id &lt;font color='#64748B'&gt;: uuid → hr_appointment.appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; assessment_id &lt;font color='#64748B'&gt;: uuid → hr_assessment.assessment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或门店评估人&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="118.71" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_offer" label="&lt;b&gt;hr_offer&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化保存候选人的岗位、地点、薪酬摘要、有效期和接受状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：申请 × Offer版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; offer_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_offer_id &lt;font color='#64748B'&gt;: uuid → hr_offer.offer_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ application_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR 招聘流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1481.98" y="93.21" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_view_v_hr_assessment_summary" label="&lt;b&gt;v_hr_assessment_summary&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从逐项评分派生加权总分、满分和得分率，并与评估建议及红线结论一起展示。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次候选评估一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：hr_assessment / hr_assessment_score&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• assessment_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• application_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• scored_item_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• weighted_score : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• weighted_max_score : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• score_rate : numeric(12,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recommendation : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• red_flag : boolean&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1889.97" y="112.21" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1377.02" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_application" label="&lt;b&gt;REF · hr_application&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录自然人对一个招聘需求的一次申请身份和来源；阶段变化只追加到 hr_application_stage_event。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1056.98" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_appointment" label="&lt;b&gt;REF · hr_appointment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录候选人面试、试工或文件办理的预约和确认状态。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="737.01" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="417.00" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2017.02" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_ops_role" label="&lt;b&gt;REF · ops_role&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护排班、招聘和培训共同使用的标准岗位身份。&lt;/font&gt;" link="data:page/id,detail-10-ops-roles"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1696.98" y="763.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="2269.52" y="153.21" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
