  <diagram id="future-p5-governance" name="05 共享身份与治理">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="group_0" value="外部系统的标识只作为来源身份" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="396" y="656" width="298" height="670" as="geometry"/>
        </mxCell>
        <mxCell id="group_1" value="所有跨域关系只能走稳定 ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontColor=#82b366;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="746" y="556" width="1088" height="660" as="geometry"/>
        </mxCell>
        <mxCell id="group_2" value="各域只写自己的事实" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
