;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_application"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="appointment_id → appointment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="assessor_employment_id → employment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment" target="hr_evaluation_hire_ref_hr_employment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="assessment_id → assessment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_assessment_score" target="hr_evaluation_hire_tbl_hr_assessment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="application_id → application_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_hr_application"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="supersedes_offer_id → offer_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_tbl_hr_offer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="role_id → role_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_ops_role"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_evaluation_hire_tbl_hr_offer" target="hr_evaluation_hire_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="hr_evaluation_hire_title" target="hr_evaluation_hire_tbl_hr_assessment"><mxGeometry relative="1" as="geometry"/></mxCell><object id="hr_evaluation_hire_title" label="评估、试工与Offer&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;04D｜评估、试工与Offer · 本页覆盖 3 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="200.25" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_assessment" label="&lt;b&gt;hr_assessment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次结构化评估的建议、红线结论、评估者和模板版本；总分由明细视图派生。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：申请 × 评估类型 × 一次评估一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; assessment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; appointment_id &lt;font color='#64748B'&gt;: uuid → hr_appointment.appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; assessor_employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或业务面试官&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="484.25" width="340.00" height="220.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_assessment_score" label="&lt;b&gt;hr_assessment_score&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存评分、权重、红线和证据，避免只有总分无法解释。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：评估 × 评分项目一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; assessment_score_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; assessment_id &lt;font color='#64748B'&gt;: uuid → hr_assessment.assessment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ assessment_id + criterion_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或业务面试官&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="150.75" width="340.00" height="204.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_tbl_hr_offer" label="&lt;b&gt;hr_offer&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化保存候选人的岗位、地点、薪酬摘要、有效期和接受状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：申请 × Offer版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_WORKFLOW_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; offer_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_offer_id &lt;font color='#64748B'&gt;: uuid → hr_offer.offer_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ application_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR 招聘流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="99.75" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_view_v_hr_assessment_summary" label="&lt;b&gt;v_hr_assessment_summary&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：FIX_MODEL_CONTRACT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：assessment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：ASSESSMENT_QUALITY_STATUS_PRECEDENCE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从逐项评分派生加权总分、满分和得分率，并与评估建议及红线结论一起展示。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次候选评估一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：hr_assessment / hr_assessment_score&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• assessment_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• application_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• scored_item_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• weighted_score : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• weighted_max_score : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• score_rate : numeric(12,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recommendation : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• red_flag : boolean&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1500.02" y="93.25" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1766.97" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_application" label="&lt;b&gt;REF · hr_application&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录自然人对一个招聘需求的一次申请身份和来源；阶段变化只追加到 hr_application_stage_event。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="806.99" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_appointment" label="&lt;b&gt;REF · hr_appointment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录候选人面试、试工或文件办理的一次预约及其实际执行结果；试工不再另建一对一结果表。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="167.00" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="487.00" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1127.03" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_ref_ops_role" label="&lt;b&gt;REF · ops_role&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护排班、招聘和培训共同使用的标准岗位身份。&lt;/font&gt;" link="data:page/id,detail-10-ops-roles"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1447.00" y="776.25" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_evaluation_hire_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1879.49" y="150.25" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-23-hr-training" name="04E｜入职任务、培训版本与资格"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2694" pageHeight="1038" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="707.97" y="303.47" width="1608.02" height="610.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="171.00" y="314.47" width="362.00" height="369.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2355.98" y="717.97" width="302.00" height="284.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="employment_id → employment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_onboarding_task" target="hr_training_ref_hr_employment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="completed_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_onboarding_task" target="hr_training_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_course" target="hr_training_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="training_course_id → training_course_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_course_version" target="hr_training_tbl_hr_training_course"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_course_version" target="hr_training_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="employment_id → employment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_assignment" target="hr_training_ref_hr_employment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="training_course_version_id → training_course_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_assignment" target="hr_training_tbl_hr_training_course_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="assigned_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_assignment" target="hr_training_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="training_assignment_id → training_assignment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_result" target="hr_training_tbl_hr_training_assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="verified_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_training_tbl_hr_training_result" target="hr_training_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="hr_training_title" target="hr_training_tbl_hr_onboarding_task"><mxGeometry relative="1" as="geometry"/></mxCell><object id="hr_training_title" label="入职任务、培训版本与资格&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;04E｜入职任务、培训版本与资格 · 本页覆盖 5 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="717.47" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="hr_training_tbl_hr_onboarding_task" label="&lt;b&gt;hr_onboarding_task&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION TRAINING_AND_ONBOARDING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项跟踪合同、证件、系统账号、培训和门店准备等入职事项。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：雇佣关系 × 入职任务代码一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; onboarding_task_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; completed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ employment_id + task_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR 入职流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="723.97" y="642.47" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="hr_training_tbl_hr_training_course" label="&lt;b&gt;hr_training_course&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION TRAINING_AND_ONBOARDING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：维护课程稳定身份，内容和考核规则放在版本表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个培训课程一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_course_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ course_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR培训管理&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1959.99" y="337.47" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="hr_training_tbl_hr_training_course_version" label="&lt;b&gt;hr_training_course_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION TRAINING_AND_ONBOARDING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结课程内容、及格线、有效期和考核规则版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：课程 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_course_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_course_id &lt;font color='#64748B'&gt;: uuid → hr_training_course.training_course_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; effective_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ training_course_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(training_course_id, tstzrange(effective_from, effective_to, &amp;#x27;[)&amp;#x27;)) WHERE status…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR培训管理&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1548.01" y="352.47" width="340.00" height="307.00" as="geometry"/></mxCell></object><object id="hr_training_tbl_hr_training_assignment" label="&lt;b&gt;hr_training_assignment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION TRAINING_AND_ONBOARDING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录员工被要求完成的具体课程版本、期限和原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：雇佣关系 × 课程版本 × 一次指派一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_assignment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_course_version_id &lt;font color='#64748B'&gt;: uuid → hr_training_course_version.training_course_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; assigned_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或门店培训负责人&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1136.02" y="502.47" width="340.00" height="237.00" as="geometry"/></mxCell></object><object id="hr_training_tbl_hr_training_result" label="&lt;b&gt;hr_training_result&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION TRAINING_AND_ONBOARDING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次课程学习或考试的分数、结果和资格有效期。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：培训指派 × 一次尝试一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_result_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_assignment_id &lt;font color='#64748B'&gt;: uuid → hr_training_assignment.training_assignment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ training_assignment_id + attempt_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：培训系统或负责人&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="723.97" y="337.47" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="hr_training_view_v_hr_role_eligibility" label="&lt;b&gt;v_hr_role_eligibility&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：employment_id + role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:TRAINING_AND_ONBOARDING&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按当前日期汇总员工对岗位的培训要求、通过结果和有效期。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：雇佣关系 × 岗位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：hr_employment / ops_role_training_requirement / hr_training_course / hr_training_assignment / hr_training_result&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• employment_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• role_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• mandatory_course_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• valid_course_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• missing_course_codes : text[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• expired_course_codes : text[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• eligibility_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• valid_until : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="187.00" y="348.47" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="hr_training_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2371.98" y="751.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_training_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2371.98" y="893.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_training_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-24-hr-timesheet" name="04F｜Lark工时同步与实际工时"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2368" pageHeight="943" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="59.28" width="372.00" height="683.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1216.03" y="61.28" width="362.00" height="369.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="109.00" y="764.28" width="2222.03" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1874.51" y="118.28" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_sync_batch" target="hr_timesheet_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_sync_batch" target="hr_timesheet_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="timesheet_sync_batch_id → timesheet_sync_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_tbl_hr_timesheet_sync_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="employment_id → employment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_ref_hr_employment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="shift_assignment_id → shift_assignment_id [启用时:EXTENSION_PACK:SHIFT_AND_WORKFORCE]" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=7 4;strokeColor=#B7791F;fontColor=#8A5A12;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_ref_ops_shift_assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="role_id → role_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_ref_ops_role"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="station_id → station_id [启用时:EXTENSION_PACK:SHIFT_AND_WORKFORCE]" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=7 4;strokeColor=#B7791F;fontColor=#8A5A12;" edge="1" parent="1" source="hr_timesheet_tbl_hr_timesheet_entry" target="hr_timesheet_ref_ops_station"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="hr_timesheet_title" target="hr_timesheet_tbl_hr_timesheet_sync_batch"><mxGeometry relative="1" as="geometry"/></mxCell><object id="hr_timesheet_title" label="Lark工时同步与实际工时&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;04F｜Lark工时同步与实际工时 · 本页覆盖 2 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="202.28" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="hr_timesheet_tbl_hr_timesheet_sync_batch" label="&lt;b&gt;hr_timesheet_sync_batch&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[SOURCE?]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录一次 Lark 或其他工时来源同步的窗口、解析版本和完整性。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源 × 时间窗口 × 一次同步一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：SOURCE_CONDITIONAL · NOT_PHASE1_SOURCE_UNVERIFIED&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; timesheet_sync_batch_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + source_batch_id / UQ idempotency_key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工时同步任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#C94A4A;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=3 4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="488.28" width="340.00" height="238.00" as="geometry"/></mxCell></object><object id="hr_timesheet_tbl_hr_timesheet_entry" label="&lt;b&gt;hr_timesheet_entry&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[SOURCE?]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存员工在地点、日期和工作区域的实际净工时原值与来源，不把班表当实际工时。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源工时记录 × 雇佣关系 × 地点 × 工作时段一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：SOURCE_CONDITIONAL · NOT_PHASE1_SOURCE_UNVERIFIED&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; timesheet_entry_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; timesheet_sync_batch_id &lt;font color='#64748B'&gt;: uuid → hr_timesheet_sync_batch.timesheet_sync_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; shift_assignment_id &lt;font color='#64748B'&gt;: uuid → ops_shift_assignment.shift_assignment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ timesheet_sync_batch_id + source_entry_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工时同步任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#C94A4A;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=3 4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="93.28" width="340.00" height="323.00" as="geometry"/></mxCell></object><object id="hr_timesheet_view_v_hr_timesheet_entry_current" label="&lt;b&gt;v_hr_timesheet_entry_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · SOURCE_CONDITIONAL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_SOURCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：source_system_id + source_entry_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：SOURCE_CONTRACT_NOT_VERIFIED:HR_TIMESHEET_ENTRY&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：对来源系统同一工时记录的多次获准采集确定性选出当前版本，避免重跑或更正被重复计入人效。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源系统 × 外部工时ID一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：hr_timesheet_sync_batch / hr_timesheet_entry&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• timesheet_entry_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• timesheet_sync_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_system_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_entry_id : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• employment_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• clock_in_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#8B5FBF;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1232.03" y="95.28" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="125.00" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="445.00" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="765.02" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1084.98" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_ops_role" label="&lt;b&gt;REF · ops_role&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护排班、招聘和培训共同使用的标准岗位身份。&lt;/font&gt;" link="data:page/id,detail-10-ops-roles"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1405.02" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_ops_shift_assignment" label="&lt;b&gt;REF · ops_shift_assignment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;把合资格员工明确指派到班表时段、岗位和工位。&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1724.99" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_ref_ops_station" label="&lt;b&gt;REF · ops_station&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护地点内可排班的工位或工作区域。&lt;/font&gt;" link="data:page/id,detail-10-ops-roles"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2045.03" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="hr_timesheet_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1890.51" y="152.28" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-25-scm-material" name="05A｜原料身份、别名、来源映射与单位换算"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2209" pageHeight="978" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="59.27" width="1151.97" height="718.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="837.00" y="799.27" width="942.01" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1855.50" y="135.77" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="base_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material" target="scm_material_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material" target="scm_material_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_alias" target="scm_material_tbl_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_alias" target="scm_material_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_alias" target="scm_material_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_source_identity" target="scm_material_tbl_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_source_identity" target="scm_material_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_source_identity" target="scm_material_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_unit_conversion" target="scm_material_tbl_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="from_unit_id → unit_id / to_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_unit_conversion" target="scm_material_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_unit_conversion" target="scm_material_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="verified_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_material_tbl_scm_material_unit_conversion" target="scm_material_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_material_title" target="scm_material_tbl_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_material_title" label="原料身份、别名、来源映射与单位换算&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05A｜原料身份、别名、来源映射与单位换算 · 本页覆盖 4 张表、0 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="219.77" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_material_tbl_scm_material" label="&lt;b&gt;scm_material&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个可采购、库存或作为配方组件的物料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; base_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="523.27" width="340.00" height="238.00" as="geometry"/></mxCell></object><object id="scm_material_tbl_scm_material_alias" label="&lt;b&gt;scm_material_alias&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存供应商、财务模板和历史配方里的原料不同写法。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源范围 × 原料别名 × 有效期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_alias_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND source_system_id + alias_text + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(COALESCE(source_system_id, NIL_UUID), NORMALIZE_ALIAS(alias_text), daterange(va…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="118.77" width="340.00" height="307.00" as="geometry"/></mxCell></object><object id="scm_material_tbl_scm_material_source_identity" label="&lt;b&gt;scm_material_source_identity&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把成本卡迁移编号、WMS编号等外部物料身份映射到 material_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源系统 × 外部原料ID × 有效期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_source_identity_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_material_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(source_system_id, source_material_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WH…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1481.98" y="127.27" width="340.00" height="290.00" as="geometry"/></mxCell></object><object id="scm_material_tbl_scm_material_unit_conversion" label="&lt;b&gt;scm_material_unit_conversion&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：原料 × 起始单位 × 目标单位 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; from_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; to_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_id + from_unit_id + to_unit_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, from_unit_id, to_unit_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) W…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="93.27" width="340.00" height="358.00" as="geometry"/></mxCell></object><object id="scm_material_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1493.01" y="833.27" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_material_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="853.00" y="833.27" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_material_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1172.97" y="833.27" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_material_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1871.50" y="169.77" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
