          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="可靠指标" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_facts" target="p1_decision">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="动作必须可追溯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_decision" target="p1_rule">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="端到端验收" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1_rule" target="p1_sample">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="future-p2-operations" name="02 营运：预估到复盘">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="group_0" value="自动抓取 + 少量人工判断" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="376" y="86" width="988" height="474" as="geometry"/>
        </mxCell>
        <mxCell id="group_1" value="预测：每次运行留痕，不覆盖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontColor=#82b366;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1386" y="136" width="628" height="164" as="geometry"/>
        </mxCell>
        <mxCell id="group_2" value="预估单：版本化发布" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1716" y="306" width="1278" height="324" as="geometry"/>
        </mxCell>
        <mxCell id="group_3" value="执行事实：不能用计划代替实际" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="2366" y="636" width="628" height="164" as="geometry"/>
        </mxCell>
        <mxCell id="group_4" value="自动计算的复盘与动作" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;fontColor=#d6b656;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="3016" y="6" width="668" height="484" as="geometry"/>
        </mxCell>
        <mxCell id="p2_title" value="营运闭环&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;预估单不是一行可覆盖的数字，而是可追溯的预测、版本、执行和实际事实&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="0" y="250" width="320" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="p2_cal_batch" value="&lt;b&gt;ops_calendar_import_batch&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;官方节假日 / 校历抓取批次&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：一次来源抓取&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：batch_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A74B5;fontColor=#17324D;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="34" y="164" width="250" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p2_cal_event" value="&lt;b&gt;ops_calendar_event&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;节假日与经营日事件身份&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：司法辖区 × 日期 × 事件&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：calendar_event_id, date&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A74B5;fontColor=#17324D;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="374" y="184" width="250" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p2_factor" value="&lt;b&gt;ops_demand_factor_observation&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;事件发生后的实际需求影响&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：门店 × 产品/品类 × 事件 × 观察窗&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：store_id, product_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F7F6;strokeColor=#2E8B88;fontColor=#175E5B;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="714" y="54" width="250" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p2_incident" value="&lt;b&gt;ops_operational_event + _product&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;天气、停电、缺货、团单、设备等当日突发&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：门店 × 时间段 × 事件；可挂产品&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：store_id, event_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97706;fontColor=#7A3E00;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="364" y="334" width="270" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p2_form" value="&lt;b&gt;BakeryOps 人工只填&lt;/b&gt;&lt;br&gt;• 明日计划覆盖量 + 原因&lt;br&gt;• 当日突发事件&lt;br&gt;• 实际发出（没有自动源时）&lt;br&gt;&lt;font color='#7D2525'&gt;不填：销售额、产品占比、毛利&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C94A4A;fontColor=#7D2525;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="24" y="314" width="270" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="p2_sales_history" value="&lt;b&gt;item_hourly_sales / item_waste&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;POS 单品售出与报废实际&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：门店 × 产品 × 小时/业务日&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：store_id, product_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F7F6;strokeColor=#2E8B88;fontColor=#175E5B;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
          <mxGeometry x="374" y="24" width="250" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="p2_run" value="&lt;b&gt;ops_forecast_run&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;每次算法运行与输入版本&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：门店 × 目标日期 × 运行&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：forecast_run_id, store_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97706;fontColor=#7A3E00;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_1">
