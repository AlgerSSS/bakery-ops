        <mxCell id="p4_application" value="&lt;b&gt;applications / appointments / trials&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;候选人、面试与试岗来源事实&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：候选人 × 阶段事件&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：candidate/application_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EDFA;strokeColor=#7C5AA6;fontColor=#493263;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
