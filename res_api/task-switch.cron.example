# Refresh the Lark task switch cache once per hour. Jobs read the last valid
# cache, so a temporary Lark outage does not overwrite the previous decision.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 * * * * root cd /opt/hotcrush/res_api && /usr/bin/node scripts/sync-task-switches.mjs >> output/logs/task-switch-sync.log 2>&1
