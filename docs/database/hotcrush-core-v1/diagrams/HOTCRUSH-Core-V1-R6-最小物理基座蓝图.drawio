op=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="644.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_mkt" label="&lt;b&gt;MKT · 营销、HBTI问卷与奖励&lt;/b&gt;&lt;br&gt;10 份物理契约 / 2 视图&lt;br&gt;&lt;font color='#64748B'&gt;业务核心 10 · 平台侧车 0 · 扩展 0 · 来源? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="482.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_msg" label="&lt;b&gt;MSG · 消息、会话与投递&lt;/b&gt;&lt;br&gt;6 份物理契约 / 1 视图&lt;br&gt;&lt;font color='#64748B'&gt;业务核心 0 · 平台侧车 5 · 扩展 1 · 来源? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-42-msg-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1454.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_domain_ai" label="&lt;b&gt;AI · Prompt版本与AI调用&lt;/b&gt;&lt;br&gt;4 份物理契约 / 0 视图&lt;br&gt;&lt;font color='#64748B'&gt;业务核心 0 · 平台侧车 4 · 扩展 0 · 来源? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-43-ai-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1178.00" y="1292.00" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="projects_conflict" label="&lt;b&gt;当前必须拆开的双写/混写&lt;/b&gt;&lt;br&gt;daily_revenue：POS 与财务分表&lt;br&gt;pos_member：POS 会员与 HBTI 活动分表&lt;br&gt;门店/产品/人员：统一身份，不各自造主数据&lt;br&gt;schema_migrations：增加 repository_code 命名空间"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="142.00" y="481.00" width="420.00" height="150.00" as="geometry"/></mxCell></object><object id="projects_proof" label="&lt;b&gt;“适配”验收证据&lt;/b&gt;&lt;br&gt;生产部署清单 + 连接角色&lt;br&gt;旧请求/响应或 SQL 契约&lt;br&gt;影子读取逐日核对&lt;br&gt;双写高水位与幂等键&lt;br&gt;独立回滚开关和演练"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="734.99" y="485.00" width="360.00" height="142.00" as="geometry"/></mxCell></object><object id="projects_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#D9534F'&gt;■&lt;/font&gt; &lt;b&gt;FINANCE&lt;/b&gt; = 财务来源事实与核对&lt;br&gt;&lt;font color='#C94F8C'&gt;■&lt;/font&gt; &lt;b&gt;MKT&lt;/b&gt; = 营销、HBTI问卷与奖励&lt;br&gt;&lt;font color='#4D7FC1'&gt;■&lt;/font&gt; &lt;b&gt;MSG&lt;/b&gt; = 消息、会话与投递&lt;br&gt;&lt;font color='#7057B8'&gt;■&lt;/font&gt; &lt;b&gt;AI&lt;/b&gt; = Prompt版本与AI调用&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="182.00" y="93.02" width="340.00" height="338.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
