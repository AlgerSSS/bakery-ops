unded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_ops_review_action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="ai_call_id → ai_call_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_ai_call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="appointment_id → appointment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_hr_appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="campaign_member_id → campaign_member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_mkt_campaign_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="queued_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_attempt" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_15" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_16" value="message_id → message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_17" value="delivery_attempt_id → delivery_attempt_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_delivery_attempt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_18" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_19" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_push_deduplication" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_20" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="msg_all_title" target="msg_all_tbl_msg_conversation"><mxGeometry relative="1" as="geometry"/></mxCell><object id="msg_all_title" label="会话、消息、外发与投递&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;09｜会话、消息、外发与投递 · 本页覆盖 7 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="891.98" y="466.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_conversation" label="&lt;b&gt;msg_conversation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：统一表示内部助手、候选人 WhatsApp 或会员活动的一段会话，并用类型化外键连接业务对象。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个渠道会话一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; person_id &lt;font color='#64748B'&gt;: uuid → hr_person.person_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; app_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1563.99" y="611.95" width="340.00" height="254.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_message" label="&lt;b&gt;msg_message&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加保存会话中的入站、出站和系统消息及经过审核的正文。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：会话 × 一条消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; message_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480.00" y="612.47" width="340.00" height="203.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_conversation_state" label="&lt;b&gt;msg_conversation_state&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存招聘或助手多轮流程的当前节点、已收集参数和到期时间；完成后仍保留最终状态摘要。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：会话 × 工作流代码一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; conversation_state_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ conversation_id + workflow_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps编排器&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1021.98" y="621.47" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_outbound_message" label="&lt;b&gt;msg_outbound_message&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存待发送消息、最早发送时间、幂等键和当前尝试状态，不按电话号码覆盖不同业务消息。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次计划外发消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：QUEUE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; review_action_id &lt;font color='#64748B'&gt;: uuid → ops_review_action.review_action_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; appointment_id &lt;font color='#64748B'&gt;: uuid → hr_appointment.appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; campaign_member_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_member.campaign_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; queued_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ idempotency_key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1021.98" y="943.47" width="340.00" height="323.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_delivery_attempt" label="&lt;b&gt;msg_delivery_attempt&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加记录外发消息每次调用渠道、结果、外部消息ID和脱敏错误。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息 × 一次发送尝试一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; delivery_attempt_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ outbound_message_id + attempt_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息worker&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480.00" y="916.96" width="340.00" height="204.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_delivery_event" label="&lt;b&gt;msg_delivery_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加保存渠道回执中的 SENT、DELIVERED、READ、FAILED 等状态变化，避免覆盖消息历史状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息 × 一次渠道状态事件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; delivery_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; message_id &lt;font color='#64748B'&gt;: uuid → msg_message.message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; delivery_attempt_id &lt;font color='#64748B'&gt;: uuid → msg_delivery_attempt.delivery_attempt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_event_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息回执服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="68.00" y="815.50" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_push_deduplication" label="&lt;b&gt;msg_push_deduplication&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录某类业务推送已对某接收者和业务日期成功完成，防止定时任务重复通知。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：推送类型 × 接收者引用 × 业务日期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; push_deduplication_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ push_kind + recipient_ref + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480.00" y="1170.47" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="msg_all_view_v_msg_delivery_current" label="&lt;b&gt;v_msg_delivery_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从不可变投递事件中确定性选出每条外发消息的当前渠道状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：msg_outbound_message / msg_message / msg_delivery_event&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• outbound_message_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• message_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• current_delivery_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• status_occurred_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• latest_delivery_event_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="73.00" y="328.98" width="330.00" height="234.00" as="geometry"/></mxCell></object><object id="msg_all_ref_ai_call" label="&lt;b&gt;REF · ai_call&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;Prompt版本与AI调用&lt;br&gt;记录一次模型调用的模板版本、调用方、输入引用、输出、token、成本、延迟和验证结果。&lt;/font&gt;" link="data:page/id,detail-43-ai-all"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1241.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1383.96" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1667.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="816.00" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_application" label="&lt;b&gt;REF · hr_application&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录自然人对一个招聘需求的一次申请身份和来源；阶段变化只追加到 hr_application_stage_event。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="389.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_appointment" label="&lt;b&gt;REF · hr_appointment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录候选人面试、试工或文件办理的预约和确认状态。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1525.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_person" label="&lt;b&gt;REF · hr_person&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;为候选人和员工提供不随雇佣关系变化的稳定 person_id。&lt;/font&gt;" link="data:page/id,detail-19-hr-person"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="673.94" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_mkt_campaign_member" label="&lt;b&gt;REF · mkt_campaign_member&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;营销、HBTI问卷与奖励&lt;br&gt;记录会员在某活动版本中的资格、邀请、开始、完成和取消历史，不再把活动状态覆盖在 pos_member 当前快照上。&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="957.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_ops_review_action" label="&lt;b&gt;REF · ops_review_action&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;把复盘建议变成有负责人、期限和完成状态的动作。&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1099.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_pos_member" label="&lt;b&gt;REF · pos_member&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;保存会员非敏感稳定身份和当前来源覆盖状态；联系方式另表隔离。&lt;/font&gt;" link="data:page/id,detail-17-pos-member-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="531.96" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#4D7FC1'&gt;■&lt;/font&gt; &lt;b&gt;MSG&lt;/b&gt; = 消息、会话与投递&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="95.50" y="92.99" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-43-ai-all" name="10｜Prompt版本与AI调用"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1819" pageHeight="1184" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="59.27" width="762.02" height="924.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1138.97" y="1005.26" width="622.04" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1465.48" y="84.77" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_segment" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="prompt_template_id → prompt_template_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_version" target="ai_all_tbl_ai_prompt_template"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_version" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="prompt_template_version_id → prompt_template_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_segment" target="ai_all_tbl_ai_prompt_template_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="prompt_segment_id → prompt_segment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_segment" target="ai_all_tbl_ai_prompt_segment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="prompt_template_version_id → prompt_template_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_tbl_ai_prompt_template_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="actor_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="ai_all_title" target="ai_all_tbl_ai_prompt_segment"><mxGeometry relative="1" as="geometry"/></mxCell><object id="ai_all_title" label="Prompt版本与AI调用&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;10｜Prompt版本与AI调用 · 本页覆盖 5 张表、0 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="159.27" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_segment" label="&lt;b&gt;ai_prompt_segment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：维护可复用 Prompt 片段的稳定身份，内容放在模板版本关联中冻结。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个 Prompt 片段代码一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_segment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ segment_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="427.77" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_template" label="&lt;b&gt;ai_prompt_template&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：维护一个 AI 场景的稳定模板身份。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个 AI 场景模板一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_template_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ template_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="822.97" y="746.27" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_template_version" label="&lt;b&gt;ai_prompt_template_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结模型、参数、输出schema和安全策略版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：Prompt模板 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_template_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_template_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_template.prompt_template_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ prompt_template_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="402.27" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_template_segment" label="&lt;b&gt;ai_prompt_template_segment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按顺序冻结模板版本使用的片段文本、变量和内容哈希。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：模板版本 × 顺序一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_template_segment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_template_version_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_template_version.prompt_template_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_segment_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_segment.prompt_segment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ prompt_template_version_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="101.27" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_call" label="&lt;b&gt;ai_call&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录一次模型调用的模板版本、调用方、输入引用、输出、token、成本、延迟和验证结果。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次模型请求一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_template_version_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_template_version.prompt_template_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; actor_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="93.27" width="340.00" height="237.00" as="geometry"/></mxCell></object><object id="ai_all_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1475.01" y="1039.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="ai_all_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1154.97" y="1039.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="ai_all_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#7057B8'&gt;■&lt;/font&gt; &lt;b&gt;AI&lt;/b&gt; = Prompt版本与AI调用&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1481.48" y="118.77" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
