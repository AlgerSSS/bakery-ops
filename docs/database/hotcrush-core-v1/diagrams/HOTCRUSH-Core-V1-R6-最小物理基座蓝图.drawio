uto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_sales_day" target="pos_sales_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_sales_day" target="pos_sales_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_sales_hour" target="pos_sales_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_sales_hour" target="pos_sales_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_item_sales_hour" target="pos_sales_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_item_sales_hour" target="pos_sales_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_item_sales_hour" target="pos_sales_ref_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_daily_breakdown" target="pos_sales_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_sales_tbl_pos_daily_breakdown" target="pos_sales_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="pos_sales_title" target="pos_sales_tbl_pos_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><object id="pos_sales_title" label="日、小时与单品销售事实&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;03C｜日、小时与单品销售事实 · 本页覆盖 4 张表、6 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="200.21" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="pos_sales_tbl_pos_sales_day" label="&lt;b&gt;pos_sales_day&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某地点某营业日某批次的销售、折扣、订单和来源平均客单观察。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; sales_day_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + business_date + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="182.00" y="492.72" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="pos_sales_tbl_pos_sales_hour" label="&lt;b&gt;pos_sales_hour&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存门店每个营业小时的销售和订单汇总。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 营业小时 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; sales_hour_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + hour_started_at + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="572.00" y="501.22" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="pos_sales_tbl_pos_item_sales_hour" label="&lt;b&gt;pos_item_sales_hour&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存 listing 在每个营业小时的销量和销售额；即使尚未映射 product_id 也能完整入库。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业小时 × POS listing × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; item_sales_hour_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + hour_started_at + listing_id + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1352.02" y="484.22" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="pos_sales_tbl_pos_daily_breakdown" label="&lt;b&gt;pos_daily_breakdown&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存支付方式、就餐方式或渠道等日销售拆分，避免把不同维度做成固定宽列。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 维度类型 × 维度值 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; daily_breakdown_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + business_date + dimension_type + dimension_value + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="962.00" y="492.72" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_sales_day_current" label="&lt;b&gt;v_pos_sales_day_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点营业日选择最新且符合质量要求的 POS 日销售批次。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_sales_day / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• sales_day_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• discount_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• refund_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="701.97" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_sales_hour_current" label="&lt;b&gt;v_pos_sales_hour_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + hour_started_at&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点、营业日和小时只选择一批合格的 SALES_HOUR 来源事实，阻止日常重跑被重复汇总。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 小时一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_sales_hour / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• sales_hour_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• hour_started_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• discount_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1081.98" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_item_sales_hour_current" label="&lt;b&gt;v_pos_item_sales_hour_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + hour_started_at + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点营业日只选择一批合格的 ITEM_SALES_HOUR 事实，并保留该批内每个 listing 小时行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 小时 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_sales_hour / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• item_sales_hour_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• hour_started_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1462.00" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_daily_breakdown_current" label="&lt;b&gt;v_pos_daily_breakdown_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + dimension_type + dimension_value&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点营业日选择一批合格 DAILY_BREAKDOWN 事实，向支付、渠道和就餐方式分析提供唯一版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 维度类型 × 维度值一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_daily_breakdown / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• daily_breakdown_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• dimension_type : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• dimension_value : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity_unit : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1842.02" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_hour_current / pos_product_mapping / pos_product_listing&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2222.03" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_view_v_pos_revenue_reconciliation" label="&lt;b&gt;v_pos_revenue_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：RECONCILIATION_THRESHOLD_UNDEFINED / MISSING_SIDE_STATUS_PRECEDENCE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较日销售、小时销售和商品小时销售三种来源粒度，显示金额和订单差异。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_sales_day_current / v_pos_sales_hour_current / v_pos_item_sales_day&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• day_pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• hour_pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• item_pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• reconciliation_revision_key : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• day_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• hour_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2601.98" y="93.21" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_sales_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="997.00" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_sales_ref_pos_ingest_batch" label="&lt;b&gt;REF · pos_ingest_batch&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;记录每次 RES/POS 抓取的数据集、窗口、游标、校验值和完整性。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="677.03" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_sales_ref_pos_product_listing" label="&lt;b&gt;REF · pos_product_listing&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;保存某来源组织/门店菜单中的商品身份和当前目录属性，不直接等同于企业 product_id。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1316.97" y="862.22" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_sales_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="2981.52" y="150.21" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-15-pos-loss" name="03D｜报废与断货事件"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1459" pageHeight="1336" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="707.97" y="603.98" width="372.00" height="695.50" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="171.00" y="314.48" width="362.00" height="738.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1120.03" y="568.97" width="302.00" height="710.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_pos_item_waste" target="pos_loss_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_pos_item_waste" target="pos_loss_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_pos_item_waste" target="pos_loss_ref_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_ops_stockout_event" target="pos_loss_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_ops_stockout_event" target="pos_loss_ref_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="detected_job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_ops_stockout_event" target="pos_loss_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_loss_tbl_ops_stockout_event" target="pos_loss_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="pos_loss_title" target="pos_loss_tbl_pos_item_waste"><mxGeometry relative="1" as="geometry"/></mxCell><object id="pos_loss_title" label="报废与断货事件&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;03D｜报废与断货事件 · 本页覆盖 2 张表、2 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="1086.48" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="pos_loss_tbl_pos_item_waste" label="&lt;b&gt;pos_item_waste&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存来源报废记录及标准原因，不把试吃等营销用途默认算作损失。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 来源报废记录 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; waste_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ pos_ingest_batch_id + source_row_fingerprint / UQ ND pos_ingest_batch_id + source_waste_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="723.97" y="994.48" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="pos_loss_tbl_ops_stockout_event" label="&lt;b&gt;ops_stockout_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录人工确认或算法识别的断货时段、证据及估算损失。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × listing × 一次连续断货区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; stockout_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; detected_job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(location_id, listing_id, tstzrange(started_at, ended_at, &amp;#x27;[)&amp;#x27;)) WHERE status IN…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 断货检测；人工可确认&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="723.97" y="637.98" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="pos_loss_view_v_pos_item_waste_current" label="&lt;b&gt;v_pos_item_waste_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：waste_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点营业日选择一批合格 ITEM_WASTE 事实，保留所选批次内每条最细来源报废记录。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 来源报废记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_waste / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• waste_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_waste_id : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_row_fingerprint : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• occurred_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="187.00" y="717.48" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_loss_view_v_pos_item_waste_mapped" label="&lt;b&gt;v_pos_item_waste_mapped&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：waste_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为报废事实补充发生时点已确认product_id和标准损失分类，同时保留未映射行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一条POS报废事实一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_waste_current / pos_product_mapping&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• waste_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_name_snapshot : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="187.00" y="348.48" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_loss_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="602.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_loss_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="744.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_loss_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="886.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_loss_ref_pos_ingest_batch" label="&lt;b&gt;REF · pos_ingest_batch&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;记录每次 RES/POS 抓取的数据集、窗口、游标、校验值和完整性。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="1170.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_loss_ref_pos_product_listing" label="&lt;b&gt;REF · pos_product_listing&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;保存某来源组织/门店菜单中的商品身份和当前目录属性，不直接等同于企业 product_id。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="1028.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_loss_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-16-pos-orders" name="03E｜订单最小事实、会员归属、条件支付与退款"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3349" pageHeight="943" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="59.28" width="1151.97" height="683.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1855.97" y="61.28" width="1122.03" height="369.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="632.02" y="764.28" width="1261.97" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2995.48" y="118.28" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order" target="pos_orders_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order" target="pos_orders_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="first_seen_pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order" target="pos_orders_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order_item" target="pos_orders_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="order_id → order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order_item" target="pos_orders_tbl_pos_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_order_item" target="pos_orders_ref_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_payment" target="pos_orders_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="order_id → order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_payment" target="pos_orders_tbl_pos_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="first_seen_pos_ingest_batch_id → pos_ingest_batch_id / last_seen_pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_payment" target="pos_orders_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_refund" target="pos_orders_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="first_seen_pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_refund" target="pos_orders_ref_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="order_id → order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_refund" target="pos_orders_tbl_pos_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_orders_tbl_pos_refund" target="pos_orders_ref_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="pos_orders_title" target="pos_orders_tbl_pos_order"><mxGeometry relative="1" as="geometry"/></mxCell><object id="pos_orders_title" label="订单最小事实、会员归属、条件支付与退款&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;03E｜订单最小事实、会员归属、条件支付与退款 · 本页覆盖 4 张表、3 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="202.28" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="pos_orders_tbl_pos_order" label="&lt;b&gt;pos_order&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只保存来源订单的稳定身份，不把尚未证明存在的订单头金额、状态或时间硬塞进同一行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源系统 × 地点 × 外部订单ID一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; first_seen_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + location_id + source_order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="488.28" width="340.00" height="238.00" as="geometry"/></mxCell></object><object id="pos_orders_tbl_pos_order_item" label="&lt;b&gt;pos_order_item&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按一次来源批次保存订单内同一 listing 的合计数量与净额；这是当前可稳定重跑的最小商品粒度。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：POS批次 × 订单 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; order_item_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid → pos_order.order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ pos_ingest_batch_id + order_id + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1481.98" y="93.28" width="340.00" height="323.00" as="geometry"/></mxCell></object><object id="pos_orders_tbl_pos_payment" label="&lt;b&gt;pos_payment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[SOURCE?]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存订单的一次支付或支付状态变化。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个来源支付记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：SOURCE→TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：SOURCE_CONDITIONAL · NOT_PHASE1_SOURCE_UNVERIFIED&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; payment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid → pos_order.order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; first_seen_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; last_seen_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_payment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#C94A4A;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=3 4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="110.28" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="pos_orders_tbl_pos_refund" label="&lt;b&gt;pos_refund&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[SOURCE?]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存订单或订单行级退款，不用负销售行替代退款事实。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个来源退款记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：SOURCE_CONDITIONAL · NOT_PHASE1_SOURCE_UNVERIFIED&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; refund_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; first_seen_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid → pos_order.order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_refund_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#C94A4A;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=3 4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1092.03" y="110.28" width="340.00" height="289.00" as="geometry"/></mxCell></object><object id="pos_orders_view_v_pos_order_item_current" label="&lt;b&gt;v_pos_order_item_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + order_id + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：FULL_ORDER_ITEM_SOURCE_NOT_PROVEN / COVERAGE_PRIORITY_SELECTION_REQUIRES_SOURCE_EVIDENCE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点和营业日选择一个合格订单商品批次，保留订单×listing最小粒度且避免重跑重复计算。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 订单 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_order_item / pos_order / pos_product_listing / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_item_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_item_key_snapshot : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_row_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1871.97" y="95.28" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_orders_view_v_pos_order_member_attribution" label="&lt;b&gt;v_pos_order_member_attribution&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：PASS_SELECT_SPEC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：NONE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从会员卡交易的订单连接计算唯一、歧义或未匹配归属，不在订单商品事实里复制会员ID。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个稳定订单一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_order / pos_member_card_transaction / pos_member&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_order_id : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• resolved_member_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• candidate_member_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• linked_card_transaction_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• attribution_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• attribution_basis : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2251.98" y="95.28" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_orders_view_v_pos_member_order_item" label="&lt;b&gt;v_pos_member_order_item&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + business_date + order_id + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：MAPPING_OCCURRENCE_TIMESTAMP_MISSING&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把当前订单商品、可解释会员归属和发生时点产品映射组合成个性化分析的唯一只读入口。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 订单 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_order_item_current / v_pos_order_member_attribution / pos_product_mapping / ops_product&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• resolved_member_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• attribution_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_mapping_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2632.00" y="95.28" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="pos_orders_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="967.98" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_orders_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="648.02" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_orders_ref_pos_ingest_batch" label="&lt;b&gt;REF · pos_ingest_batch&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;记录每次 RES/POS 抓取的数据集、窗口、游标、校验值和完整性。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1288.02" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_orders_ref_pos_product_listing" label="&lt;b&gt;REF · pos_product_listing&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;保存某来源组织/门店菜单中的商品身份和当前目录属性，不直接等同于企业 product_id。&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1607.99" y="798.28" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_orders_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="3011.48" y="152.28" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-17-pos-member-identity" name="03F｜会员身份、联系信息与卡"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1459" pageHeight="1118" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="166.00" y="470.03" width="913.97" height="611.50" as="geometry"/></mxCell></object><object id="layout_group_1" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1120.03" y="652.03" width="302.00" height="284.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member" target="pos_member_identity_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="home_location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member" target="pos_member_identity_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="merged_into_member_id → member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member" target="pos_member_identity_tbl_pos_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="member_id → member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member_contact" target="pos_member_identity_tbl_pos_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="member_id → member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member_card" target="pos_member_identity_tbl_pos_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member_card" target="pos_member_identity_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="issued_location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pos_member_identity_tbl_pos_member_card" target="pos_member_identity_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="pos_member_identity_title" target="pos_member_identity_tbl_pos_member"><mxGeometry relative="1" as="geometry"/></mxCell><object id="pos_member_identity_title" label="会员身份、联系信息与卡&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;03F｜会员身份、联系信息与卡 · 本页覆盖 3 张表、0 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="348.53" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="pos_member_identity_tbl_pos_member" label="&lt;b&gt;pos_member&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只保存会员非敏感稳定身份和企业治理状态；每天变化的等级、积分、累计值和余额进入会员状态快照，联系方式另表隔离。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个企业内可识别的 POS 会员一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; home_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; merged_into_member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="723.97" y="522.53" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="pos_member_identity_tbl_pos_member_contact" label="&lt;b&gt;pos_member_contact&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：隔离存放业务明确批准保留的会员手机号，并支持换号历史。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：会员 × 联系方式类型 × 有效期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; member_contact_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ member_id + lookup_hash + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(member_id, contact_type, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务的受限写入路径&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="182.00" y="504.03" width="340.00" height="256.00" as="geometry"/></mxCell></object><object id="pos_member_identity_tbl_pos_member_card" label="&lt;b&gt;pos_member_card&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把一名会员的多张卡拆为独立身份，避免把卡余额永远聚合进会员主档。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每张来源会员卡一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; member_card_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; issued_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_card_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="182.00" y="810.53" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="pos_member_identity_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="686.03" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_member_identity_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="828.03" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="pos_member_identity_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
