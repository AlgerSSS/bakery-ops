        <mxCell id="1" parent="0" />
        <mxCell id="group_0" value="02 所有模块可复用的连接点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;fontColor=#82b366;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="6" y="6" width="1238" height="144" as="geometry" />
        </mxCell>
        <mxCell id="group_1" value="01 四类基础记录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;fontColor=#6c8ebf;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="646" y="156" width="898" height="368" as="geometry" />
        </mxCell>
        <mxCell id="group_2" value="04 不可妥协的门禁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontColor=#9673a6;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1566" y="706" width="1128" height="304" as="geometry" />
        </mxCell>
        <mxCell id="group_3" value="03 关系、读取和联动" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="656" y="536" width="898" height="328" as="geometry" />
        </mxCell>
        <mxCell id="p2-title" value="统一数据契约：不是所有表字段相同，而是所有表属于明确的记录类型" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#1f2937;strokeColor=#111827;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;fontColor=#ffffff;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1270" y="40" width="440" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2-master" value="A｜稳定身份主表&#10;PK id · immutable code · status&#10;created_at · valid_from / valid_to&#10;名称不是主键" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="624" y="214" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-source" value="B｜来源身份 / 批次&#10;source_system · external_id&#10;source_batch_id · checksum&#10;parser_version · mapping_status · evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="614" y="34" width="260" height="142" as="geometry" />
        </mxCell>
        <mxCell id="p2-fact" value="C｜不可变事实 / 事件&#10;稳定身份 FK · location_id · business_day_id&#10;occurred_at · recorded_at · source_batch_id&#10;quality_status · correction_of_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="group_1">
          <mxGeometry x="24" y="24" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-revision" value="D｜计划 / 规则 / 版本&#10;revision_no · previous_revision_id&#10;status · reason · approved_at · published_at&#10;发布后不可原地覆盖" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_1">
          <mxGeometry x="324" y="34" width="270" height="142" as="geometry" />
        </mxCell>
        <mxCell id="p2-location" value="地点线索&#10;location_id&#10;门店 / 厨房 / 仓库" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="group_0">
          <mxGeometry x="24" y="34" width="205" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-day" value="经营日线索&#10;business_day_id&#10;地点 × 日期 × 时区边界" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="group_0">
          <mxGeometry x="244" y="34" width="215" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-entity" value="业务身份线索&#10;product / employment / material&#10;supplier / role 等强类型 FK" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="group_0">
          <mxGeometry x="484" y="24" width="235" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2-batch" value="来源线索&#10;source_batch_id&#10;外部 ID · 文件 · URL · hash" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="734" y="24" width="225" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2-cause" value="因果线索&#10;causation_id / previous_revision_id&#10;由什么计划、动作或事件产生" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_0">
          <mxGeometry x="974" y="24" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2-bridge" value="强类型关系桥  &lt;domain&gt;_&lt;a&gt;_&lt;b&gt;&#10;真实 FK · relation_type&#10;valid_from / valid_to · evidence · confirmed_by" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_3">
          <mxGeometry x="594" y="24" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-view" value="契约视图  v_&lt;domain&gt;_*&#10;稳定字段、粒度、单位与质量状态&#10;内部改表不迫使消费者同步修改" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_3">
          <mxGeometry x="304" y="24" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-outbox" value="分域 outbox&#10;event_type · aggregate_id · causation_id&#10;payload_version · occurred_at · published_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_3">
          <mxGeometry x="24" y="24" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-index" value="统一只读索引&#10;v_entity_link_index&#10;v_business_timeline&#10;v_data_quality_status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_3">
          <mxGeometry x="464" y="184" width="245" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-no-name" value="禁止&#10;按名称、手机号、自由文本做跨域 JOIN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_2">
          <mxGeometry x="574" y="24" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p2-no-eav" value="禁止&#10;万能 entity / attribute / relation 表取代真实业务表" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=2;fontColor=#1f2937;fontFamily=PingFang SC;fontSize=13;fontStyle=1;" vertex="1" parent="group_2">
