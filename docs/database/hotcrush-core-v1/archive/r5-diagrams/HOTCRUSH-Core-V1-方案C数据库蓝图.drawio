html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_cost_run" target="cost_snapshot_margin_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="supersedes_cost_run_id → cost_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_cost_run" target="cost_snapshot_margin_tbl_cost_card_cost_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="cost_run_id → cost_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot" target="cost_snapshot_margin_tbl_cost_card_cost_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot" target="cost_snapshot_margin_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="product_id → product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot" target="cost_snapshot_margin_ref_ops_product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="recipe_version_id → recipe_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot" target="cost_snapshot_margin_ref_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="product_cost_snapshot_id → product_cost_snapshot_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_component" target="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="recipe_component_id → recipe_component_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_component" target="cost_snapshot_margin_ref_cost_card_recipe_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_component" target="cost_snapshot_margin_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="material_price_id → material_price_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_snapshot_margin_tbl_cost_card_product_cost_component" target="cost_snapshot_margin_ref_cost_card_material_price"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="cost_snapshot_margin_title" target="cost_snapshot_margin_tbl_cost_card_cost_run"><mxGeometry relative="1" as="geometry"/></mxCell><object id="cost_snapshot_margin_title" label="成本运行、快照与产品毛利&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;06C｜成本运行、快照与产品毛利 · 本页覆盖 3 张表、4 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="537.73" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_tbl_cost_card_cost_run" label="&lt;b&gt;cost_card_cost_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录某交易日一次产品成本计算使用的配方和价格版本清单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：目标营业日 × 一次成本计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; cost_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_cost_run_id &lt;font color='#64748B'&gt;: uuid → cost_card_cost_run.cost_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ target_business_date + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="684.01" y="815.23" width="340.00" height="238.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_tbl_cost_card_product_cost_snapshot" label="&lt;b&gt;cost_card_product_cost_snapshot&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结某产品在某地点和营业日的单位成本及覆盖质量，避免后续价格改动重写历史。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：成本运行 × 地点或全局 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_cost_snapshot_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; cost_run_id &lt;font color='#64748B'&gt;: uuid → cost_card_cost_run.cost_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND cost_run_id + location_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="437.23" width="340.00" height="306.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_tbl_cost_card_product_cost_component" label="&lt;b&gt;cost_card_product_cost_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存产品成本快照采用的原料数量、价格来源和成本贡献。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：产品成本快照 × 配方组件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_cost_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_cost_snapshot_id &lt;font color='#64748B'&gt;: uuid → cost_card_product_cost_snapshot.product_cost_snapshot_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_component.recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_price_id &lt;font color='#64748B'&gt;: uuid → cost_card_material_price.material_price_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ product_cost_snapshot_id + recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="93.26" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_view_v_cost_card_cost_run_current" label="&lt;b&gt;v_cost_card_cost_run_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个目标营业日选择唯一成功且未被后续合格运行替代的成本修订。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：目标营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_cost_run&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• target_business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cost_run_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• revision_no : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• trigger_reason : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• calculation_version : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• completed_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1091.99" y="112.26" width="330.00" height="234.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_view_v_cost_card_product_cost_quality" label="&lt;b&gt;v_cost_card_product_cost_quality&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：显示产品当前成本、组件覆盖、价格新鲜度和可信状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_product_cost_snapshot / cost_card_product_cost_component / cost_card_material_price / v_cost_card_cost_run_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• unit_total_cost : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• component_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• priced_component_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• price_coverage_rate : numeric(12,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1472.01" y="95.26" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_view_v_cost_card_product_daily_margin" label="&lt;b&gt;v_cost_card_product_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：连接产品日销量和当天成本快照，计算销售额、COGS、毛利和覆盖率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_day / cost_card_product_cost_snapshot / v_cost_card_cost_run_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cost_run_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• unit_total_cost : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1852.02" y="95.26" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_view_v_cost_card_daily_margin" label="&lt;b&gt;v_cost_card_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按地点和营业日汇总产品毛利，同时给出全部成本覆盖和可信成本覆盖。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_daily_margin / v_pos_sales_day_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• costed_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• trusted_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cogs : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_margin : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• gross_margin_rate : numeric(12,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2231.97" y="95.26" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="227.00" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_cost_card_material_price" label="&lt;b&gt;REF · cost_card_material_price&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;配方、采购价、成本快照与毛利&lt;br&gt;从供应商价格观察或人工批准值中选择某地点、原料的有效成本价格。&lt;/font&gt;" link="data:page/id,detail-34-cost-price"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1506.98" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_cost_card_recipe_component" label="&lt;b&gt;REF · cost_card_recipe_component&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;配方、采购价、成本快照与毛利&lt;br&gt;逐项保存配方版本的统一原料用量、损耗和净得率。&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1827.02" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_cost_card_recipe_version" label="&lt;b&gt;REF · cost_card_recipe_version&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;配方、采购价、成本快照与毛利&lt;br&gt;冻结配方产出对象、批产量、生效区间、售价参考和发布状态。&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="547.00" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="866.97" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_ops_product" label="&lt;b&gt;REF · ops_product&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护 HOT CRUSH 可销售、可生产产品的稳定身份，不等同于某门店 POS listing。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1187.01" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2146.98" y="1125.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_snapshot_margin_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="2611.52" y="136.26" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
