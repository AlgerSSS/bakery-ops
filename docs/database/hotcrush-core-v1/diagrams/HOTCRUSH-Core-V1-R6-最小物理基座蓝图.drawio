o;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_governance_tbl_app_unit" target="app_governance_tbl_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_governance_tbl_app_unit" target="app_governance_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_governance_tbl_app_job_run" target="app_governance_tbl_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="actor_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_governance_tbl_app_audit_event" target="app_governance_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="app_governance_tbl_app_audit_event" target="app_governance_tbl_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="app_governance_title" target="app_governance_tbl_app_schema_migration"><mxGeometry relative="1" as="geometry"/></mxCell><object id="app_governance_title" label="迁移、来源、单位、任务、质量与审计&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;01A｜迁移、来源、单位、任务、质量与审计 · 本页覆盖 5 张表、3 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="200.24" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="app_governance_tbl_app_schema_migration" label="&lt;b&gt;app_schema_migration&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按代码仓库分别记录已执行的迁移，消除多个项目共用单一数字版本造成的冲突。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：代码仓库 × 迁移版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; migration_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ repository_code + migration_version&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：受控迁移执行器&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="182.00" y="509.75" width="340.00" height="187.00" as="geometry"/></mxCell></object><object id="app_governance_tbl_app_source_system" label="&lt;b&gt;app_source_system&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个可区分的数据来源系统一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：平台管理员&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="572.00" y="1069.25" width="340.00" height="204.00" as="geometry"/></mxCell></object><object id="app_governance_tbl_app_unit" label="&lt;b&gt;app_unit&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个受控计量单位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; canonical_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ unit_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：数据治理管理员&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="962.00" y="484.25" width="340.00" height="238.00" as="geometry"/></mxCell></object><object id="app_governance_tbl_app_job_run" label="&lt;b&gt;app_job_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：某个任务的一次运行一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：任务调度平台&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="572.00" y="794.25" width="340.00" height="203.00" as="geometry"/></mxCell></object><object id="app_governance_tbl_app_audit_event" label="&lt;b&gt;app_audit_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加记录登录、权限、人工改数、审批和敏感读取等受控操作。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次已完成或拒绝的受控操作一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; audit_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; actor_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：数据库受控审计函数&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="572.00" y="501.75" width="340.00" height="203.00" as="geometry"/></mxCell></object><object id="app_governance_view_v_identity_mapping_gap" label="&lt;b&gt;v_identity_mapping_gap&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：UNDEFINED_GRAIN_KEY / AFFECTED_FACT_UNIVERSE_UNDEFINED / GAP_REASON_RULE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：集中列出尚未确认的地点、POS商品、员工和原料来源身份，并估计影响范围。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个未确认来源身份或映射问题一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：ops_location_source_identity / pos_product_listing / pos_product_mapping / pos_product_mapping_review / hr_employment_source_identity / hr_employment…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• entity_type : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_system_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_entity_id : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• candidate_stable_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• reason_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• first_seen_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• affected_row_count : bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• affected_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="701.97" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="app_governance_view_v_app_data_quality_summary" label="&lt;b&gt;v_app_data_quality_summary&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：source_view_name + domain_code + rule_code + severity + quality_status&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：BLOCKED_QUALITY_VIEW_DEPENDENCY / QUALITY_RULE_MAPPING_UNDEFINED / SEVERITY_MAPPING_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把各业务域只读核对视图的当前质量结论汇总成统一看板，不复制业务对象、不保存多态 entity_type/entity_id 工单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源质量视图 × 业务域 × 规则 × 严重度 × 质量状态一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_identity_mapping_gap / v_pos_revenue_reconciliation / v_pos_member_daily_summary / v_cost_card_product_cost_quality / v_finance_sales_reconciliatio…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_view_name : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• domain_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• rule_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• severity : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• issue_count : bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• affected_row_count : bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• affected_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1081.98" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="app_governance_view_v_business_timeline" label="&lt;b&gt;v_business_timeline&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · SOURCE_CONDITIONAL]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_SOURCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：event_domain + event_type + event_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：SOURCE_CONTRACT_NOT_VERIFIED:HR_TIMESHEET_ENTRY / EXTENSION_PACK_NOT_ACTIVATED:PROCUREMENT_AND_INVENTORY / EXTENSION_PACK_NOT_ACT…&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按地点和营业日统一索引计划、生产、销售、人员、采购、成本、财务和活动事件。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 一个领域事件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_sales_day_current / ops_operational_event / ops_production_plan_version / ops_production_run / ops_dispatch / ops_shift_plan_version / v_hr_tim…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• event_domain : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• event_type : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• event_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• employment_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1462.00" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="app_governance_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1343.97" y="849.75" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="app_governance_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1841.48" y="150.24" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
