lColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1903.48" y="1483.25" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="overview_domain_msg" label="&lt;b&gt;MSG · 消息、会话与投递&lt;/b&gt;&lt;br&gt;6 份物理契约 / 1 视图&lt;br&gt;&lt;font color='#64748B'&gt;业务核心 0 · 平台侧车 5 · 扩展 1 · 来源? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-42-msg-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1903.48" y="1660.26" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="overview_domain_ai" label="&lt;b&gt;AI · Prompt版本与AI调用&lt;/b&gt;&lt;br&gt;4 份物理契约 / 0 视图&lt;br&gt;&lt;font color='#64748B'&gt;业务核心 0 · 平台侧车 4 · 扩展 0 · 来源? 0&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;点击查看全部关系字段&lt;/font&gt;" link="data:page/id,detail-43-ai-all"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=13;spacingLeft=12;spacingRight=12;spacingTop=8;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1903.48" y="1837.26" width="305.00" height="112.00" as="geometry"/></mxCell></object><object id="overview_projects" label="&lt;b&gt;四个项目写入边界&lt;/b&gt;&lt;br&gt;BakeryOps · RES/POS · 财务网站 · HBTI&lt;br&gt;同一来源事实只允许一个责任写者" link="data:page/id,project-boundaries"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="2797.00" y="1122.26" width="360.00" height="102.00" as="geometry"/></mxCell></object><object id="overview_e2e" label="&lt;b&gt;15 条端到端链路&lt;/b&gt;&lt;br&gt;从来源批次、预测、计划、班表、订货、成本和销售一直追到财务、HBTI、消息与审计" link="data:page/id,e2e-01"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="2355.98" y="1118.26" width="390.00" height="110.00" as="geometry"/></mxCell></object><object id="overview_gate" label="&lt;b&gt;统一质量门禁&lt;/b&gt;&lt;br&gt;身份未确认、来源部分失败、单位不明、版本未发布或成本覆盖不足时，事实不被静默补值；分析必须显示质量与覆盖率。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2353.00" y="1294.26" width="420.00" height="124.00" as="geometry"/></mxCell></object><object id="overview_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#D9534F'&gt;■&lt;/font&gt; &lt;b&gt;FINANCE&lt;/b&gt; = 财务来源事实与核对&lt;br&gt;&lt;font color='#C94F8C'&gt;■&lt;/font&gt; &lt;b&gt;MKT&lt;/b&gt; = 营销、HBTI问卷与奖励&lt;br&gt;&lt;font color='#4D7FC1'&gt;■&lt;/font&gt; &lt;b&gt;MSG&lt;/b&gt; = 消息、会话与投递&lt;br&gt;&lt;font color='#7057B8'&gt;■&lt;/font&gt; &lt;b&gt;AI&lt;/b&gt; = Prompt版本与AI调用&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1961.00" y="93.24" width="340.00" height="338.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
