# 招聘 Lark 同步
# ⚠️ 时间点按【系统时区】解释。本机已设为 Asia/Kuala_Lumpur（与原 Contabo 一致）。
# 不要写 CRON_TZ —— Debian 的 vixie cron 3.0pl1-162 不支持它（二进制里无此符号），
# 写了会静默按 UTC 跑。2026-08-05 就是这么让复盘跑到了数据采集前面 7.5 小时。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 频率是 2026-08-01 压过的，别改回每 30 分钟（每轮 4~8 次调用，会超 10000/月 配额）
0 9-21/3 * * * root cd /opt/hotcrush/scripts && python3 recruit_demand_sync.py >> /opt/hotcrush/scripts/logs/demand_sync.log 2>&1
0 9-21 * * *   root cd /opt/hotcrush/scripts && python3 recruit_funnel_sync.py >> /opt/hotcrush/scripts/logs/funnel_sync.log 2>&1
0 9 * * *      root cd /opt/hotcrush/scripts && /usr/bin/node /opt/hotcrush/res_api/scripts/task-switch-run.mjs recruit_morning_report -- python3 recruit_morning_report.py >> /opt/hotcrush/scripts/logs/morning_report.log 2>&1
30 21 * * *    root cd /opt/hotcrush/scripts && /usr/bin/node /opt/hotcrush/res_api/scripts/task-switch-run.mjs recruit_tomorrow_preview -- python3 recruit_tomorrow_preview.py >> /opt/hotcrush/scripts/logs/tomorrow_preview.log 2>&1
