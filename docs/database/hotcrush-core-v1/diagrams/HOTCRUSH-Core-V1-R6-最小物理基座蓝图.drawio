try relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_message" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="conversation_id → conversation_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_conversation_state" target="msg_all_tbl_msg_conversation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="conversation_id → conversation_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_tbl_msg_conversation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="review_action_id → review_action_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_ops_review_action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="ai_call_id → ai_call_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_ai_call"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="appointment_id → appointment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_hr_appointment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="campaign_member_id → campaign_member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_mkt_campaign_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="queued_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_outbound_message" target="msg_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_attempt" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_15" value="outbound_message_id → outbound_message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_outbound_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_16" value="message_id → message_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_message"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_17" value="delivery_attempt_id → delivery_attempt_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_tbl_msg_delivery_attempt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_18" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="msg_all_tbl_msg_delivery_event" target="msg_all_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_19" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="msg_all_title" target="msg_all_tbl_msg_conversation"><mxGeometry relative="1" as="geometry"/></mxCell><object id="msg_all_title" label="会话、消息、外发与投递&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;09｜会话、消息、外发与投递 · 本页覆盖 6 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="891.98" y="562.54" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_conversation" label="&lt;b&gt;msg_conversation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：统一表示内部助手、候选人 WhatsApp 或会员活动的一段会话，并用类型化外键连接业务对象。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个渠道会话一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; application_id &lt;font color='#64748B'&gt;: uuid → hr_application.application_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; person_id &lt;font color='#64748B'&gt;: uuid → hr_person.person_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; app_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND channel_code + external_conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="1563.99" y="717.00" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_message" label="&lt;b&gt;msg_message&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加保存会话中的入站、出站和系统消息及经过审核的正文。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：会话 × 一条消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; message_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND conversation_id + external_message_id / UQ ND outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="480.00" y="853.52" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_conversation_state" label="&lt;b&gt;msg_conversation_state&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存招聘或助手多轮流程的当前节点、已收集参数和到期时间；完成后仍保留最终状态摘要。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：会话 × 工作流代码一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; conversation_state_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ conversation_id + workflow_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps编排器&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="1021.98" y="717.52" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_outbound_message" label="&lt;b&gt;msg_outbound_message&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存待发送消息、业务推送自然键、最早发送时间、幂等键和队列状态；投递次数、最后错误和成功去重结论从投递事实派生。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次计划外发消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：QUEUE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; conversation_id &lt;font color='#64748B'&gt;: uuid → msg_conversation.conversation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; review_action_id &lt;font color='#64748B'&gt;: uuid → ops_review_action.review_action_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; appointment_id &lt;font color='#64748B'&gt;: uuid → hr_appointment.appointment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; campaign_member_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_member.campaign_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; queued_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ idempotency_key / UQ ND push_kind + recipient_ref + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="1021.98" y="1040.02" width="340.00" height="340.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_delivery_attempt" label="&lt;b&gt;msg_delivery_attempt&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加记录外发消息每次调用渠道、结果、外部消息ID和脱敏错误。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息 × 一次发送尝试一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; delivery_attempt_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ outbound_message_id + attempt_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息worker&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="480.00" y="1176.02" width="340.00" height="204.00" as="geometry"/></mxCell></object><object id="msg_all_tbl_msg_delivery_event" label="&lt;b&gt;msg_delivery_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION CHANNEL_RECEIPTS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加保存渠道回执中的 SENT、DELIVERED、READ、FAILED 等状态变化，避免覆盖消息历史状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息 × 一次渠道状态事件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; delivery_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; outbound_message_id &lt;font color='#64748B'&gt;: uuid → msg_outbound_message.outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; message_id &lt;font color='#64748B'&gt;: uuid → msg_message.message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; delivery_attempt_id &lt;font color='#64748B'&gt;: uuid → msg_delivery_attempt.delivery_attempt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_event_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps消息回执服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#667085;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="68.00" y="1061.52" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="msg_all_view_v_msg_delivery_current" label="&lt;b&gt;v_msg_delivery_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · EXTENSION_PACK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：DEFER_EXTENSION&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：outbound_message_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：EXTENSION_PACK_NOT_ACTIVATED:CHANNEL_RECEIPTS&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从外发队列、不可变投递尝试和可选渠道回执中确定性选出当前状态、重试摘要与业务推送成功去重结论。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：外发消息一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：msg_outbound_message / msg_message / msg_delivery_attempt / msg_delivery_event&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• outbound_message_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• message_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• push_kind : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipient_ref_hash : char(64)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• attempt_count : bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• last_error_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• current_delivery_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E9F2FF;strokeColor=#4D7FC1;fontColor=#294D80;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="73.00" y="348.55" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="msg_all_ref_ai_call" label="&lt;b&gt;REF · ai_call&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;Prompt版本与AI调用&lt;br&gt;记录一次模型调用的模板版本、调用方、输入引用、输出、token、成本、延迟和验证结果。&lt;/font&gt;" link="data:page/id,detail-43-ai-all"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1365.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1507.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1791.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="939.05" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_application" label="&lt;b&gt;REF · hr_application&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录自然人对一个招聘需求的一次申请身份和来源；阶段变化只追加到 hr_application_stage_event。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="513.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_appointment" label="&lt;b&gt;REF · hr_appointment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;记录候选人面试、试工或文件办理的一次预约及其实际执行结果；试工不再另建一对一结果表。&lt;/font&gt;" link="data:page/id,detail-21-hr-recruit"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1649.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_hr_person" label="&lt;b&gt;REF · hr_person&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;为候选人和员工提供不随雇佣关系变化的稳定 person_id。&lt;/font&gt;" link="data:page/id,detail-19-hr-person"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="796.99" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_mkt_campaign_member" label="&lt;b&gt;REF · mkt_campaign_member&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;营销、HBTI问卷与奖励&lt;br&gt;记录会员在某活动版本中的资格、邀请、开始、完成和取消历史，不再把活动状态覆盖在 pos_member 当前快照上。&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1081.03" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_ops_review_action" label="&lt;b&gt;REF · ops_review_action&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;把复盘建议变成有负责人、期限和完成状态的动作。&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="1223.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_ref_pos_member" label="&lt;b&gt;REF · pos_member&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;POS目录、销售与会员&lt;br&gt;只保存会员非敏感稳定身份和企业治理状态；每天变化的等级、积分、累计值和余额进入会员状态快照，联系方式另表隔离。&lt;/font&gt;" link="data:page/id,detail-17-pos-member-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1975.98" y="655.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="msg_all_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#4D7FC1'&gt;■&lt;/font&gt; &lt;b&gt;MSG&lt;/b&gt; = 消息、会话与投递&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="95.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-43-ai-all" name="10｜Prompt版本与AI调用"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1819" pageHeight="874" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="59.23" width="762.02" height="614.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1125.00" y="695.23" width="621.97" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1465.48" y="75.23" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_segment" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="prompt_template_id → prompt_template_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_segment" target="ai_all_tbl_ai_prompt_template"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="prompt_segment_id → prompt_segment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_prompt_template_segment" target="ai_all_tbl_ai_prompt_segment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="prompt_template_id → prompt_template_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_tbl_ai_prompt_template"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="job_run_id → job_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_ref_app_job_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="actor_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ai_all_tbl_ai_call" target="ai_all_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="ai_all_title" target="ai_all_tbl_ai_prompt_segment"><mxGeometry relative="1" as="geometry"/></mxCell><object id="ai_all_title" label="Prompt版本与AI调用&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;10｜Prompt版本与AI调用 · 本页覆盖 4 张表、0 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="159.23" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_segment" label="&lt;b&gt;ai_prompt_segment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：一行冻结一个可复用 Prompt 片段版本的内容、变量结构和校验值；不在每个模板关联中重复复制内容。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：Prompt片段代码 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_segment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ segment_code + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="702.01" y="402.23" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_template" label="&lt;b&gt;ai_prompt_template&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：一行冻结一个 AI 场景模板版本的模型、参数、输出 schema 和安全策略；不再为稳定模板头另拆版本表。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：AI场景代码 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_template_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ template_code + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="1092.03" y="402.23" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_prompt_template_segment" label="&lt;b&gt;ai_prompt_template_segment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按顺序连接模板版本和已冻结片段版本，只保存组合关系及消息角色。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：模板版本 × 顺序一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; prompt_template_segment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_template_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_template.prompt_template_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_segment_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_segment.prompt_segment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ prompt_template_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI配置&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="702.01" y="101.23" width="340.00" height="221.00" as="geometry"/></mxCell></object><object id="ai_all_tbl_ai_call" label="&lt;b&gt;ai_call&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 PLATFORM]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录一次模型调用的模板版本、调用方、输入引用、输出、token、成本、延迟和验证结果。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次模型请求一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_PLATFORM_STATE · PASS_PLATFORM_SIDECAR_NOT_BUSINESS_FACT&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; prompt_template_id &lt;font color='#64748B'&gt;: uuid → ai_prompt_template.prompt_template_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; actor_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps AI服务&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EEE9FF;strokeColor=#7057B8;fontColor=#423275;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;double=1;doubleDistance=4;strokeWidth=2.0;" vertex="1" parent="1"><mxGeometry x="1092.03" y="93.23" width="340.00" height="237.00" as="geometry"/></mxCell></object><object id="ai_all_ref_app_job_run" label="&lt;b&gt;REF · app_job_run&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1460.97" y="729.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="ai_all_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1141.00" y="729.23" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="ai_all_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#7057B8'&gt;■&lt;/font&gt; &lt;b&gt;AI&lt;/b&gt; = Prompt版本与AI调用&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1481.48" y="109.23" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
