# Disabled while every Lark email template is inactive. Preview mode still reads
# Lark Base, so there is no reason to schedule it before content and consent are approved.
# To re-enable, uncomment both lines after at least one template is active.
# CRON_TZ=Asia/Kuala_Lumpur
# 0 10 * * * root cd /opt/hotcrush/res_api && MEMBER_EMAIL_MODE=preview MEMBER_EMAIL_CONSENT_MODE=res_subscribed /usr/bin/node scripts/task-switch-run.mjs member_email_job -- ./member-email-daily.sh
