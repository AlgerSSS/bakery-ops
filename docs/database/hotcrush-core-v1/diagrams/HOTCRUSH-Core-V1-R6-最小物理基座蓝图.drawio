hogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="verified_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_receipt_price_title" target="scm_receipt_price_tbl_scm_goods_receipt"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_receipt_price_title" label="收货、验收与市场价格观察&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05H｜收货、验收与市场价格观察 · 本页覆盖 3 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="479.99" y="572.55" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_goods_receipt" label="&lt;b&gt;scm_goods_receipt&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录针对供应商确认采购版本的一次实际到货、验收和入库。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购版本 × 一次收货一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; received_by_employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ receipt_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1152.01" y="718.01" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[EXTENSION PROCUREMENT_AND_INVENTORY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：EXTENSION_PACK · NOT_PHASE1_EXTENSION_ONLY&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="609.99" y="781.52" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_supplier_price_observation" label="&lt;b&gt;scm_supplier_price_observation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：沉淀报价、PO或收货形成的原始和归一化采购价，供成本卡选择生效价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 观察时间 × 来源记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_BASE_FACT · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt_line.goods_receipt_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B7791F'&gt;&lt;b&gt;FK LATER ?&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; raw_price_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + source_record_id / UQ ND goods_receipt_line_id + observation_type&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购或收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="68.00" y="717.99" width="340.00" height="340.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_view_v_scm_supplier_price_current" label="&lt;b&gt;v_scm_supplier_price_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：AS_OF_SEMANTICS_UNRESOLVED / NORMALIZED_PRICE_FORMULA_INPUTS_INCOMPLETE&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个供应商商品选择最新合格价格观察并显示来源和归一化单价。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_supplier / scm_supplier_item / scm_material / scm_material_unit_conversion / scm_supplier_price_observation&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_item_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_price_observation_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• observed_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• normalized_price_myr : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• observation_type : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="73.00" y="348.55" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1543.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1685.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1117.03" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="832.99" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="691.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="975.05" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1827.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_purchase_order_line" label="&lt;b&gt;REF · scm_purchase_order_line&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;保存采购版本中已确认的供应商商品版本、订购包装数量、单位价格和来源补货行。&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1259.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_purchase_order_revision" label="&lt;b&gt;REF · scm_purchase_order_revision&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;直接保留某采购单号每次草稿、审批、发送、供应商确认或取消，不再另建空壳采购主单。&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="549.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_supplier_item" label="&lt;b&gt;REF · scm_supplier_item&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1401.01" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="95.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-33-cost-recipe" name="06A｜配方、版本与组成展开"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2189" pageHeight="1076" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="686.01" y="91.24" width="372.00" height="784.02" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1075.99" y="59.24" width="742.02" height="369.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="109.00" y="897.26" width="1582.02" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1835.48" y="116.24" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="output_product_id → product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_ops_product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="output_material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="yield_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_version" target="cost_recipe_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="recipe_version_id → recipe_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_tbl_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="input_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_recipe_tbl_cost_card_recipe_component" target="cost_recipe_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="cost_recipe_title" target="cost_recipe_tbl_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><object id="cost_recipe_title" label="配方、版本与组成展开&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;06A｜配方、版本与组成展开 · 本页覆盖 2 张表、2 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="200.24" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="cost_recipe_tbl_cost_card_recipe_version" label="&lt;b&gt;cost_card_recipe_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：一行冻结一个配方代码版本的名称、产出对象、批产量、生效区间、售价参考和发布状态；不再为只有版本表引用的配方另建主档。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方代码 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; yield_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; effective_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_code + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(recipe_code, tstzrange(effective_from, effective_to, &amp;#x27;[)&amp;#x27;)) WHERE status = &amp;#x27;PUB…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="484.26" width="340.00" height="375.00" as="geometry"/></mxCell></object><object id="cost_recipe_tbl_cost_card_recipe_component" label="&lt;b&gt;cost_card_recipe_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存配方版本的统一原料用量、损耗和净得率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方版本 × 原料 × 序号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; input_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_version_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702.01" y="125.24" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="cost_recipe_view_v_cost_card_recipe_current" label="&lt;b&gt;v_cost_card_recipe_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：FIX_MODEL_CONTRACT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：output_product_id + output_material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：AS_OF_SEMANTICS_UNRESOLVED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按时点选择产品或半成品当前已发布配方版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：产品或半成品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_recipe_version&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_code : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• recipe_name : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• batch_yield_quantity : numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• effective_from : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• effective_to : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1091.99" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="cost_recipe_view_v_cost_card_recipe_expanded" label="&lt;b&gt;v_cost_card_recipe_expanded&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：BLOCK_MISSING_FACT_OR_RULE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：root_recipe_version_id + path_component_ids + material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：RECIPE_RECURSION_RULE_UNDEFINED / UNIT_CONVERSION_PATH_RULE_UNDEFINED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：递归展开产品和半成品配方到最终统一原料，并保留路径和累计用量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：顶层配方版本 × 路径 × 最终原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_recipe_version / cost_card_recipe_component / scm_material / scm_material_unit_conversion&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• root_recipe_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• output_product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• path_recipe_version_ids : uuid[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• path_component_ids : uuid[]&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• base_unit_quantity_per_output : numeric(18,10)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• depth : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1472.01" y="93.24" width="330.00" height="319.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="765.02" y="931.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="125.00" y="931.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_ops_product" label="&lt;b&gt;REF · ops_product&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;维护 HOT CRUSH 可销售、可生产产品的稳定身份，不等同于某门店 POS listing。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="445.00" y="931.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1084.98" y="931.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1405.02" y="931.26" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_recipe_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1851.48" y="150.24" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="detail-34-cost-price" name="06B｜成本采用价与生效区间"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1459" pageHeight="1064" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 物理表"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="707.97" y="547.53" width="372.00" height="391.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 治理视图"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="171.00" y="314.03" width="362.00" height="352.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 跨板块引用"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1120.03" y="459.02" width="302.00" height="568.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="material_id → material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_price_tbl_cost_card_material_price" target="cost_price_ref_scm_material"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="location_id → location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_price_tbl_cost_card_material_price" target="cost_price_ref_ops_location"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="supplier_price_observation_id → supplier_price_observation_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_price_tbl_cost_card_material_price" target="cost_price_ref_scm_supplier_price_observation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="approved_by_user_id → user_id / created_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cost_price_tbl_cost_card_material_price" target="cost_price_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="cost_price_title" target="cost_price_tbl_cost_card_material_price"><mxGeometry relative="1" as="geometry"/></mxCell><object id="cost_price_title" label="成本采用价与生效区间&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;06B｜成本采用价与生效区间 · 本页覆盖 1 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="699.53" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="cost_price_tbl_cost_card_material_price" label="&lt;b&gt;cost_card_material_price&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PHASE1 BUSINESS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从供应商价格观察或人工批准值中选择某地点、原料的有效成本价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 原料 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：CORE_MASTER_IDENTITY · PASS_MINIMUM_PHYSICAL_FOUNDATION&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_price_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_price_observation.supplier_price_observation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; effective_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND material_id + location_id + effective_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, COALESCE(location_id, NIL_UUID), tstzrange(effective_from, effecti…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="723.97" y="581.53" width="340.00" height="341.00" as="geometry"/></mxCell></object><object id="cost_price_view_v_cost_card_material_price_current" label="&lt;b&gt;v_cost_card_material_price_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW · PHASE1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;准备度：FIX_MODEL_CONTRACT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度键：location_id + material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;阻断：AS_OF_SEMANTICS_UNRESOLVED&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个地点或全局原料选择当前生效的批准成本价格并显示来源质量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：cost_card_material_price / scm_material&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_price_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• price_myr_per_base_unit : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• price_source : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• effective_from : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• quality_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="187.00" y="348.03" width="330.00" height="302.00" as="geometry"/></mxCell></object><object id="cost_price_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="919.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_price_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="777.03" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_price_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="635.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_price_ref_scm_supplier_price_observation" label="&lt;b&gt;REF · scm_supplier_price_observation&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;沉淀报价、PO或收货形成的原始和归一化采购价，供成本卡选择生效价格。&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1136.03" y="493.02" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="cost_price_legend" label="&lt;b&gt;颜色 = 谁负责这个板块&lt;/b&gt;&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = 首期业务核心，81 张业务事实/主数据&lt;br&gt;&lt;b&gt;═ 双线边框&lt;/b&gt; = 首期平台侧车，权限/幂等/审计/恢复，不是经营事实&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = 扩展包，有真实模块写入者后才建&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = 来源待验证，先证明身份/粒度/重跑契约&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
