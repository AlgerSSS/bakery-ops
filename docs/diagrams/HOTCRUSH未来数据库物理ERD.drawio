        </mxCell>
        <mxCell id="p8_tbl_scm_supplier" value="&lt;b&gt;scm_supplier&lt;/b&gt; &lt;font color='#18794E'&gt;&lt;b&gt;[NEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个供应商一行&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; supplier_code &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; supplier_name &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入者：供应链&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EAF7EE;strokeColor=#3F8F5B;fontColor=#205C39;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;strokeWidth=1.6;" vertex="1" parent="group_0">
          <mxGeometry x="404" y="354" width="340" height="197" as="geometry"/>
        </mxCell>
        <mxCell id="p8_tbl_scm_supplier_item" value="&lt;b&gt;scm_supplier_item&lt;/b&gt; &lt;font color='#18794E'&gt;&lt;b&gt;[NEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商 × 原料 / SKU × 有效期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_id &lt;font color='#64748B'&gt;: uuid → scm_supplier&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → cost_card_item&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; supplier_id + supplier_sku &lt;font color='#64748B'&gt;: key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; purchase_unit / pack_quantity &lt;font color='#64748B'&gt;: text / numeric&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; moq / lead_time_days &lt;font color='#64748B'&gt;: numeric&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; effective_from / to &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入者：供应链&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#EAF7EE;strokeColor=#3F8F5B;fontColor=#205C39;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;strokeWidth=1.6;" vertex="1" parent="group_0">
