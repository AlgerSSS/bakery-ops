=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_scm_supplier_item_material_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="goods_receipt_line_id → goods_receipt_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_tbl_scm_goods_receipt_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="purchase_order_line_id → purchase_order_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_scm_purchase_order_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="raw_price_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="verified_by_user_id → user_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#637083;strokeWidth=1.3;fontColor=#3E4650;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scm_receipt_price_tbl_scm_supplier_price_observation" target="scm_receipt_price_ref_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_15" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="scm_receipt_price_title" target="scm_receipt_price_tbl_scm_goods_receipt"><mxGeometry relative="1" as="geometry"/></mxCell><object id="scm_receipt_price_title" label="收货、验收与市场价格观察&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;05H｜收货、验收与市场价格观察 · 本页覆盖 3 张表、1 个只读视图；每条实线均标出外键字段&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="479.99" y="500.48" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_goods_receipt" label="&lt;b&gt;scm_goods_receipt&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录针对采购订单的一次实际到货、验收和入库。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购订单 × 一次收货一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order.purchase_order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; received_by_employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ receipt_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1152.01" y="645.94" width="340.00" height="272.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="609.99" y="722.48" width="340.00" height="255.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_tbl_scm_supplier_price_observation" label="&lt;b&gt;scm_supplier_price_observation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：沉淀报价、PO或收货形成的原始和归一化采购价，供成本卡选择生效价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 观察时间 × 来源记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt_line.goods_receipt_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; raw_price_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + source_record_id / UQ ND goods_receipt_line_id + observation_type&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购或收货流程&lt;/font&gt;"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="68.00" y="646.49" width="340.00" height="357.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_view_v_scm_supplier_price_current" label="&lt;b&gt;v_scm_supplier_price_current&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为每个供应商商品选择最新合格价格观察并显示来源和归一化单价。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：scm_supplier / scm_supplier_item / scm_supplier_item_material_mapping / scm_supplier_price_observation&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_item_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_item_material_mapping_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• material_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• supplier_price_observation_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• observed_at : timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• normalized_price_myr : numeric(18,8)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• observation_type : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="73.00" y="328.98" width="330.00" height="268.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_source_system" label="&lt;b&gt;REF · app_source_system&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1457.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_unit" label="&lt;b&gt;REF · app_unit&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1599.96" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_app_user" label="&lt;b&gt;REF · app_user&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;治理、权限与质量&lt;br&gt;统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&lt;/font&gt;" link="data:page/id,detail-02-app-access"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1032.00" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_hr_employment" label="&lt;b&gt;REF · hr_employment&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;人员、招聘、培训与工时&lt;br&gt;把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&lt;/font&gt;" link="data:page/id,detail-20-hr-employment"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="747.96" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_ops_location" label="&lt;b&gt;REF · ops_location&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;地点、产品、预测、计划、执行与班表&lt;br&gt;统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="605.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_material" label="&lt;b&gt;REF · scm_material&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="889.94" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_material_unit_conversion" label="&lt;b&gt;REF · scm_material_unit_conversion&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1741.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_purchase_order" label="&lt;b&gt;REF · scm_purchase_order&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;表示采购单稳定身份，供应商和交付地点固定，内容放在版本表。&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="463.99" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_purchase_order_line" label="&lt;b&gt;REF · scm_purchase_order_line&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;保存采购版本中已确认的供应商SKU物料映射、订购包装数量、单位价格和来源补货行。&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1173.98" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_supplier_item" label="&lt;b&gt;REF · scm_supplier_item&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;维护供应商 SKU 的稳定目录身份、订购单位、MOQ和商业条件；原料映射及包装换算另行版本化。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1883.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_ref_scm_supplier_item_material_mapping" label="&lt;b&gt;REF · scm_supplier_item_material_mapping&lt;/b&gt; [TABLE]&lt;br&gt;&lt;font color='#64748B'&gt;原料、库存、补货、采购与收货&lt;br&gt;版本化记录某供应商 SKU 在一个生效区间内对应哪种统一物料，以及每个订购单位的基础数量。&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;align=left;verticalAlign=top;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1564.00" y="1315.97" width="270.00" height="92.00" as="geometry"/></mxCell></object><object id="scm_receipt_price_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;b&gt;REF&lt;/b&gt; = 跨板块引用；点击跳转完整定义&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="95.50" y="92.99" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
