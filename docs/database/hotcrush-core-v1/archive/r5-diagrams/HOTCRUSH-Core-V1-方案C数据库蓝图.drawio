mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_question" target="chain_01_tbl_app_source_system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="source_system_id → source_system_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_tbl_app_source_system" target="chain_01_tbl_pos_ingest_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="pos_ingest_batch_id → pos_ingest_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_tbl_pos_ingest_batch" target="chain_01_tbl_pos_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="location_id + business_date + currency" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_tbl_pos_sales_day" target="chain_01_tbl_pos_sales_hour"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_tbl_pos_sales_hour" target="chain_01_tbl_pos_item_sales_hour"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_tbl_pos_item_sales_hour" target="chain_01_view_v_pos_revenue_reconciliation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_view_v_pos_revenue_reconciliation" target="chain_01_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_01_joins" target="chain_01_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_01_title" label="端到端 01 · POS 抓取到三层销售核对&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E01｜POS 抓取到三层销售核对 · 同一天的日销售、小时销售和商品销售是否完整且一致？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_01_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;同一天的日销售、小时销售和商品销售是否完整且一致？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="332.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_01_tbl_app_source_system" label="&lt;b&gt;app_source_system&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个可区分的数据来源系统一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：平台管理员&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="276.00" width="310.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_01_tbl_pos_ingest_batch" label="&lt;b&gt;pos_ingest_batch&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录每次 RES/POS 抓取的数据集、窗口、游标、校验值和完整性。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：某地点 × 某数据集 × 一次抓取或重跑一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + location_id + dataset_code + source_batch_id / UQ idempotency_key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="242.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_01_tbl_pos_sales_day" label="&lt;b&gt;pos_sales_day&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某地点某营业日某批次的销售、折扣、订单和客单汇总。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; sales_day_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + business_date + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_01_tbl_pos_sales_hour" label="&lt;b&gt;pos_sales_hour&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存门店每个营业小时的销售和订单汇总。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 营业小时 × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; sales_hour_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + hour_started_at + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="242.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_01_tbl_pos_item_sales_hour" label="&lt;b&gt;pos_item_sales_hour&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存 listing 在每个营业小时的销量和销售额；即使尚未映射 product_id 也能完整入库。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业小时 × POS listing × POS批次一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; item_sales_hour_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + hour_started_at + listing_id + pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_01_view_v_pos_revenue_reconciliation" label="&lt;b&gt;v_pos_revenue_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较日销售、小时销售和商品小时销售三种来源粒度，显示金额和订单差异。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_sales_day_current / pos_sales_hour / v_pos_item_sales_day&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• day_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• hour_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• item_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3077.03" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_01_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. app_source_system.source_system_id = pos_ingest_batch.source_system_id&lt;br&gt;2. 三类事实均通过 pos_ingest_batch_id 追溯同一抓取批次&lt;br&gt;3. 按 location_id + business_date 对账；NULL 与 0 不混用"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3471.98" y="290.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_01_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;批次状态不是 SUCCEEDED 或核对超阈值时，不允许作为最终经营事实静默下游消费。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4036.97" y="322.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_01_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-02" name="E02｜POS 商品到企业产品身份"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4235" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="297.99" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="193.99" width="1882.00" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3101.02" y="255.99" width="1096.99" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_02_title" target="chain_02_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_question" target="chain_02_tbl_pos_product_listing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="listing_id → listing_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_tbl_pos_product_listing" target="chain_02_tbl_pos_product_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="product_id → product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_tbl_pos_product_mapping" target="chain_02_tbl_ops_product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_tbl_ops_product" target="chain_02_view_v_product_identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id + product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_view_v_product_identity" target="chain_02_view_v_pos_item_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_view_v_pos_item_sales_day" target="chain_02_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_02_joins" target="chain_02_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_02_title" label="端到端 02 · POS 商品到企业产品身份&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E02｜POS 商品到企业产品身份 · 来源商品如何连接预测、排产、成本和销售，而不依赖名称？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_02_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;来源商品如何连接预测、排产、成本和销售，而不依赖名称？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="331.99" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_02_tbl_pos_product_listing" label="&lt;b&gt;pos_product_listing&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某来源组织/门店菜单中的商品身份和当前目录属性，不直接等同于企业 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源系统 × 来源组织 × 外部商品ID一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_organization_id + source_item_id / UQ source_item_key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-12-pos-ingest-catalog"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="258.99" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_02_tbl_pos_product_mapping" label="&lt;b&gt;pos_product_mapping&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化保存 listing 与 product_id 的确认关系，使历史销售按当时映射重现。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：POS listing × 有效期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_mapping_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ listing_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(listing_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WHERE status = &amp;#x27;CONFIRMED&amp;#x27;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：产品身份审核流程&lt;/font&gt;" link="data:page/id,detail-13-pos-mapping"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="227.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_02_tbl_ops_product" label="&lt;b&gt;ops_product&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：维护 HOT CRUSH 可销售、可生产产品的稳定身份，不等同于某门店 POS listing。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个企业产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; base_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ product_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 产品主数据管理&lt;/font&gt;" link="data:page/id,detail-03-ops-identity"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="258.99" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_02_view_v_product_identity" label="&lt;b&gt;v_product_identity&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：以 POS listing 为全集，显示发生时点有效的 product_id 及排产、品类和映射质量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：POS listing × 当前有效映射一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_product_listing / pos_product_mapping / ops_product&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_item_key : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_name : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-13-pos-mapping"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2327.01" y="269.49" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_02_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_sales_hour / pos_product_mapping / pos_product_listing / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2722.00" y="269.49" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_02_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 销售事实永远先连 listing_id&lt;br&gt;2. listing_id 在销售发生时点落入 mapping 的 [valid_from, valid_to)&lt;br&gt;3. 只有 status = CONFIRMED 的映射提供 product_id"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3117.02" y="289.99" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_02_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;无法确认时保留 listing 和销售金额，product_id 为空并进入审核；禁止按名称猜填。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="3682.01" y="321.99" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_02_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-03" name="E03｜节假日与需求因子到预测准确率"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4589" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="280.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="190.00" width="2237.03" height="322.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3455.98" y="238.00" width="1096.99" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="217.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_03_title" target="chain_03_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_question" target="chain_03_tbl_ops_calendar_import_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="calendar_import_batch_id → calendar_import_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_tbl_ops_calendar_import_batch" target="chain_03_tbl_ops_calendar_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="calendar_event_id → calendar_event_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_tbl_ops_calendar_event" target="chain_03_tbl_ops_demand_factor_observation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_tbl_ops_demand_factor_observation" target="chain_03_tbl_ops_forecast_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="forecast_run_id → forecast_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_tbl_ops_forecast_run" target="chain_03_tbl_ops_forecast_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_tbl_ops_forecast_line" target="chain_03_view_v_ops_forecast_accuracy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_view_v_ops_forecast_accuracy" target="chain_03_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_03_joins" target="chain_03_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_03_title" label="端到端 03 · 节假日与需求因子到预测准确率&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E03｜节假日与需求因子到预测准确率 · 节假日、天气或事件如何影响预测，之后如何验证影响是否真实？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="307.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_03_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;节假日、天气或事件如何影响预测，之后如何验证影响是否真实？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="314.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_03_tbl_ops_calendar_import_batch" label="&lt;b&gt;ops_calendar_import_batch&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录一次节假日或公共日历来源抓取及人工批准状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源 × 辖区 × 一次抓取一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; calendar_import_batch_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + jurisdiction_code + content_sha256&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 日历任务&lt;/font&gt;" link="data:page/id,detail-04-ops-calendar-event"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="224.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_03_tbl_ops_calendar_event" label="&lt;b&gt;ops_calendar_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存已解析的节假日、学校假期和其他可验证日历事件。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：辖区 × 日期 × 事件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; calendar_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; calendar_import_batch_id &lt;font color='#64748B'&gt;: uuid → ops_calendar_import_batch.calendar_import_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ calendar_import_batch_id + jurisdiction_code + event_date + event_name&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 日历任务&lt;/font&gt;" link="data:page/id,detail-04-ops-calendar-event"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="249.50" width="310.00" height="221.00" as="geometry"/></mxCell></object><object id="chain_03_tbl_ops_demand_factor_observation" label="&lt;b&gt;ops_demand_factor_observation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录节假日或事件对地点、产品或品类需求的历史观察，不把未经验证的猜测当真值。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：事件 × 地点 × 产品或品类 × 观察窗口一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; demand_factor_observation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; calendar_event_id &lt;font color='#64748B'&gt;: uuid → ops_calendar_event.calendar_event_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND job_run_id + calendar_event_id + location_id + product_id + category_code + window_star…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 评估任务&lt;/font&gt;" link="data:page/id,detail-04-ops-calendar-event"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="224.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_03_tbl_ops_forecast_run" label="&lt;b&gt;ops_forecast_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结一次预测使用的目标日期、算法、输入清单和结果状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 目标营业日 × 一次算法运行一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 预测任务&lt;/font&gt;" link="data:page/id,detail-05-ops-forecast"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="250.00" width="310.00" height="220.00" as="geometry"/></mxCell></object><object id="chain_03_tbl_ops_forecast_line" label="&lt;b&gt;ops_forecast_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次预测对每个产品的数量区间和解释。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预测运行 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_run.forecast_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ forecast_run_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 预测任务&lt;/font&gt;" link="data:page/id,detail-05-ops-forecast"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="241.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_03_view_v_ops_forecast_accuracy" label="&lt;b&gt;v_ops_forecast_accuracy&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：将预测行与实际产品日销量配对，区分高估、低估、未计划和未映射。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 目标营业日 × 产品 × 预测运行一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：ops_forecast_run / ops_forecast_line / v_pos_item_sales_day / ops_product&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• forecast_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• actual_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-05-ops-forecast"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3077.03" y="251.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_03_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. event 由 calendar_import_batch_id 保留 API 来源证据&lt;br&gt;2. factor 连接 location_id + event_type + 可选 product_id/category_code + 有效观察窗口，并保留 job_run_id + algorithm_version + input_manifest&lt;br&gt;3. forecast_line 与实际销售按 location_id + business_date + product_id 连接"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3471.98" y="272.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_03_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;API 抓取事实与人工批准的需求因子分层保存；低样本或兜底因子必须显式标记。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4036.97" y="304.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_03_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="167.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-04" name="E04｜突发情况到明日调整动作"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4570" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="280.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="181.50" width="2217.02" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3435.97" y="238.00" width="1097.05" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="217.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_04_title" target="chain_04_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_question" target="chain_04_tbl_ops_operational_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="operational_event_id → operational_event_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_ops_operational_event" target="chain_04_tbl_ops_operational_event_product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_ops_operational_event_product" target="chain_04_tbl_ops_production_plan_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="base_version_id → production_plan_version_id / new_version_id → production_plan_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_ops_production_plan_version" target="chain_04_tbl_ops_plan_adjustment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_ops_plan_adjustment" target="chain_04_tbl_ops_review_action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_ops_review_action" target="chain_04_tbl_app_audit_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_tbl_app_audit_event" target="chain_04_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_04_joins" target="chain_04_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_04_title" label="端到端 04 · 突发情况到明日调整动作&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E04｜突发情况到明日调整动作 · 当日突发事件为何导致明日某产品计划增减，谁批准了？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="307.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_04_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;当日突发事件为何导致明日某产品计划增减，谁批准了？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="314.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_ops_operational_event" label="&lt;b&gt;ops_operational_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录停电、设备故障、人流异常、促销或其他当日突发情况及人工证据。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个地点的一次连续运营事件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; operational_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店或区域运营&lt;/font&gt;" link="data:page/id,detail-04-ops-calendar-event"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="250.00" width="310.00" height="220.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_ops_operational_event_product" label="&lt;b&gt;ops_operational_event_product&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：明确运营事件影响哪些产品以及影响方向和数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：运营事件 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; operational_event_product_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; operational_event_id &lt;font color='#64748B'&gt;: uuid → ops_operational_event.operational_event_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ operational_event_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店或区域运营&lt;/font&gt;" link="data:page/id,detail-04-ops-calendar-event"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="241.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_ops_production_plan_version" label="&lt;b&gt;ops_production_plan_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保留每次预测建议、人工调整、审批和发布，不覆盖旧计划。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan.production_plan_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_run.forecast_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps；审批人改变状态&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_ops_plan_adjustment" label="&lt;b&gt;ops_plan_adjustment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项记录明日计划从基础版本到新版本的增减及理由。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：基础版本 × 新版本 × 产品的一次调整一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DECISION+&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; plan_adjustment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan.production_plan_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; base_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; new_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; base_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; new_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ base_version_id + new_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店或区域运营&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_ops_review_action" label="&lt;b&gt;ops_review_action&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把复盘建议变成有负责人、期限和完成状态的动作。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：复盘 × 一项改进行动一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; review_action_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; daily_review_id &lt;font color='#64748B'&gt;: uuid → ops_daily_review.daily_review_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; owner_employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店或区域运营&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="241.50" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_04_tbl_app_audit_event" label="&lt;b&gt;app_audit_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只追加记录登录、权限、人工改数、审批和敏感读取等受控操作。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一次已完成或拒绝的受控操作一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; audit_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; actor_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：数据库受控审计函数&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3077.02" y="258.50" width="310.00" height="203.00" as="geometry"/></mxCell></object><object id="chain_04_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 事件通过 location_id + 时间范围定位影响地点&lt;br&gt;2. 受影响产品使用 product_id；调整锁定 plan_version_id + plan_line_id&lt;br&gt;3. review_action 和 audit_event 保留提出、批准、执行主体"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3451.97" y="272.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_04_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;调整是新计划版本或显式 delta，不覆盖原预测，不用自由文本替代关系字段。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4017.02" y="304.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_04_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="167.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-05" name="E05｜预测到排产工作量与班表需求"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4944" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="261.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="162.50" width="2592.00" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3811.02" y="219.00" width="1096.98" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="198.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_05_title" target="chain_05_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_question" target="chain_05_tbl_ops_forecast_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="forecast_run_id → forecast_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_forecast_run" target="chain_05_tbl_ops_production_plan_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="production_plan_version_id → production_plan_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_version" target="chain_05_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="production_plan_line_id → production_plan_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_line" target="chain_05_tbl_ops_production_plan_slot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_production_plan_slot" target="chain_05_tbl_ops_workload_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="workload_run_id → workload_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_workload_run" target="chain_05_tbl_ops_workload_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="workload_line_id → workload_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_workload_line" target="chain_05_tbl_ops_shift_requirement"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_tbl_ops_shift_requirement" target="chain_05_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_05_joins" target="chain_05_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_05_title" label="端到端 05 · 预测到排产工作量与班表需求&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E05｜预测到排产工作量与班表需求 · 明日预计销量怎样变成分时生产量、工作分钟和关键岗位人数？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="288.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_05_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;明日预计销量怎样变成分时生产量、工作分钟和关键岗位人数？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="295.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_forecast_run" label="&lt;b&gt;ops_forecast_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结一次预测使用的目标日期、算法、输入清单和结果状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 目标营业日 × 一次算法运行一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 预测任务&lt;/font&gt;" link="data:page/id,detail-05-ops-forecast"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="231.00" width="310.00" height="220.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_version" label="&lt;b&gt;ops_production_plan_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保留每次预测建议、人工调整、审批和发布，不覆盖旧计划。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan.production_plan_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_run_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_run.forecast_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps；审批人改变状态&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="196.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; planned_quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="205.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_production_plan_slot" label="&lt;b&gt;ops_production_plan_slot&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把产品总计划拆到具体生产时段，解决总量正确但时段断货的问题。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：计划产品行 × 生产时段一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_slot_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; planned_quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_line_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="230.50" width="310.00" height="221.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_workload_run" label="&lt;b&gt;ops_workload_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把已发布生产计划和预测销售转换为岗位/工位所需分钟，作为班表显式上游。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 一次工作量计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; workload_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工作量任务&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2701.98" y="214.00" width="310.00" height="254.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_workload_line" label="&lt;b&gt;ops_workload_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某工作量运行对岗位、工位及可选产品的需求分钟和数量依据。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：工作量运行 × 岗位 × 工位 × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; workload_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; workload_run_id &lt;font color='#64748B'&gt;: uuid → ops_workload_run.workload_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND workload_run_id + role_id + station_id + product_id + workload_unit&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工作量任务&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3077.02" y="213.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_05_tbl_ops_shift_requirement" label="&lt;b&gt;ops_shift_requirement&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：明确每个时段需要的岗位、工位、人数和关键岗位属性。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：班表版本 × 时段 × 岗位 × 工位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; shift_requirement_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; shift_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_shift_plan_version.shift_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; workload_line_id &lt;font color='#64748B'&gt;: uuid → ops_workload_line.workload_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND shift_plan_version_id + shift_start + shift_end + role_id + station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 排班流程&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3452.00" y="213.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_05_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 计划版本记录 source_forecast_run_id，但允许人工计划独立存在&lt;br&gt;2. 计划行和分时槽均使用 product_id；workload_line 回指 plan_line_id&lt;br&gt;3. shift_requirement 通过 workload_run_id + role_id + station_id 说明关键岗位需求"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3827.02" y="253.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_05_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;预测、批准计划、工作量计算和排班需求是四种不同事实，不能压在一张表的一行里。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4392.00" y="285.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_05_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="148.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-06" name="E06｜排产到原料毛需求"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4570" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="297.99" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="193.99" width="2217.02" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3435.97" y="255.99" width="1097.05" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_06_title" target="chain_06_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_question" target="chain_06_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_ops_production_plan_line" target="chain_06_tbl_cost_card_recipe_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="recipe_version_id → recipe_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_cost_card_recipe_version" target="chain_06_tbl_cost_card_recipe_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_cost_card_recipe_component" target="chain_06_tbl_scm_material_requirement_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="material_requirement_run_id → material_requirement_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_scm_material_requirement_run" target="chain_06_tbl_scm_material_requirement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="material_requirement_line_id → material_requirement_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_scm_material_requirement_line" target="chain_06_tbl_scm_material_requirement_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_tbl_scm_material_requirement_component" target="chain_06_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_06_joins" target="chain_06_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_06_title" label="端到端 06 · 排产到原料毛需求&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E06｜排产到原料毛需求 · 计划生产多少产品，为什么需要订多少某种原料？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_06_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;计划生产多少产品，为什么需要订多少某种原料？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="331.99" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; planned_quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="241.99" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_cost_card_recipe_version" label="&lt;b&gt;cost_card_recipe_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结配方产出对象、批产量、生效区间、售价参考和发布状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe.recipe_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; output_material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; yield_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(recipe_id, tstzrange(effective_from, effective_to, &amp;#x27;[)&amp;#x27;)) WHERE status = &amp;#x27;PUBLI…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="227.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_cost_card_recipe_component" label="&lt;b&gt;cost_card_recipe_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存配方版本的统一原料用量、损耗和净得率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配方版本 × 原料 × 序号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; input_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ recipe_version_id + sequence_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-33-cost-recipe"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="250.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_scm_material_requirement_run" label="&lt;b&gt;scm_material_requirement_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把已发布生产计划按生效配方展开成原料需求，并冻结输入版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 计划营业日 × 一次需求计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="259.49" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_scm_material_requirement_line" label="&lt;b&gt;scm_material_requirement_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存需求运行中每种原料的总需求量，并由组成表保留可穿透来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：需求运行 × 原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; base_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_requirement_run_id + material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2701.98" y="250.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_06_tbl_scm_material_requirement_component" label="&lt;b&gt;scm_material_requirement_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保留某原料需求来自哪个计划产品行、哪个配方组件和多少数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：原料需求行 × 计划产品行 × 配方组件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_line_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_line.material_requirement_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_component.recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_requirement_line_id + production_plan_line_id + recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3077.02" y="258.99" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_06_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. plan_line 选择发生日有效且已批准的 recipe_version_id&lt;br&gt;2. 每个配方组件用 material_id + base_unit_quantity 展开&lt;br&gt;3. requirement_component 同时保留 plan_line_id、recipe_component_id 和 material_requirement_line_id"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3451.97" y="289.99" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_06_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;必须能从一克原料需求反查到哪张计划、哪个产品和哪个配方版本；单位不明则阻断。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4017.02" y="321.99" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_06_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-07" name="E07｜原料需求到建议订货、采购单和收货"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5319" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="260.99" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="156.99" width="2966.98" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4185.99" y="204.99" width="1096.99" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="198.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_07_title" target="chain_07_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_question" target="chain_07_tbl_scm_material_requirement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_material_requirement_line" target="chain_07_tbl_scm_replenishment_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="replenishment_run_id → replenishment_run_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_replenishment_run" target="chain_07_tbl_scm_replenishment_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="supplier_item_material_mapping_id → supplier_item_material_mapping_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_replenishment_line" target="chain_07_tbl_scm_supplier_item_material_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_supplier_item_material_mapping" target="chain_07_tbl_scm_purchase_order_revision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="purchase_order_revision_id → purchase_order_revision_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_purchase_order_revision" target="chain_07_tbl_scm_purchase_order_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="purchase_order_line_id → purchase_order_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_purchase_order_line" target="chain_07_tbl_scm_goods_receipt_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="material_id + currency" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_goods_receipt_line" target="chain_07_tbl_scm_inventory_movement_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_tbl_scm_inventory_movement_line" target="chain_07_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_07_joins" target="chain_07_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_07_title" label="端到端 07 · 原料需求到建议订货、采购单和收货&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E07｜原料需求到建议订货、采购单和收货 · 未来订货量为何增减，最终批准、下单和收到多少？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="288.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_07_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;未来订货量为何增减，最终批准、下单和收到多少？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="294.99" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_material_requirement_line" label="&lt;b&gt;scm_material_requirement_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存需求运行中每种原料的总需求量，并由组成表保留可穿透来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：需求运行 × 原料一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_requirement_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; base_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_requirement_run_id + material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-29-scm-requirements"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1202.00" y="213.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_replenishment_run" label="&lt;b&gt;scm_replenishment_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把原料需求、可用库存、在途、安全量、MOQ和提前期转换为建议订货。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 需求日期 × 一次补货计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_requirement_run_id &lt;font color='#64748B'&gt;: uuid → scm_material_requirement_run.material_requirement_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps供应链任务&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1576.98" y="222.49" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_replenishment_line" label="&lt;b&gt;scm_replenishment_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存原料建议量、批准量、库存构成、MOQ取整和调整原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：补货运行 × 原料 × 供应商商品物料映射候选一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; replenishment_run_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_run.replenishment_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND replenishment_run_id + material_id + supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps计算；采购人员批准&lt;/font&gt;" link="data:page/id,detail-30-scm-replenishment"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1952.02" y="196.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_supplier_item_material_mapping" label="&lt;b&gt;scm_supplier_item_material_mapping&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化记录某供应商 SKU 在一个生效区间内对应哪种统一物料，以及每个订购单位的基础数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; confirmed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ supplier_item_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(supplier_item_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WHERE mapping_status =…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="190.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_purchase_order_revision" label="&lt;b&gt;scm_purchase_order_revision&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保留采购单每次草稿、审批、发送和供应商确认，不覆盖旧版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购订单 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order.purchase_order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; based_on_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_id + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程；审批人改变状态&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2701.98" y="204.99" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_purchase_order_line" label="&lt;b&gt;scm_purchase_order_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存采购版本中已确认的供应商SKU物料映射、订购包装数量、单位价格和来源补货行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：采购版本 × 供应商商品物料映射一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_revision_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_revision.purchase_order_revision_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; replenishment_line_id &lt;font color='#64748B'&gt;: uuid → scm_replenishment_line.replenishment_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ purchase_order_revision_id + supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购流程&lt;/font&gt;" link="data:page/id,detail-31-scm-purchase-order"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3077.02" y="196.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3452.00" y="213.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_07_tbl_scm_inventory_movement_line" label="&lt;b&gt;scm_inventory_movement_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存库存事件中每种原料、批号和数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：库存移动单 × 原料 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; inventory_movement_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; inventory_movement_id &lt;font color='#64748B'&gt;: uuid → scm_inventory_movement.inventory_movement_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,6)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND inventory_movement_id + material_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链库存服务&lt;/font&gt;" link="data:page/id,detail-28-scm-movement"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="3826.98" y="213.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_07_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 补货建议以 material_id + destination_location_id + need_by_date 连接需求&lt;br&gt;2. 建议量和批准量分字段保留；差异量由视图计算，调整原因保留为人工决定事实&lt;br&gt;3. 正式补货和PO锁定 supplier_item_material_mapping_id，避免供应商改包装后重解释历史&lt;br&gt;4. PO 行通过 replenishment_line_id 追建议；收货行通过 purchase_order_line_id 追订单"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4201.99" y="238.99" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_07_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;在途、现存、安全量、MOQ 和订货倍数均为计算输入；人工改量必须写理由，不能覆盖 suggested_quantity。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4766.98" y="284.99" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_07_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="148.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-08" name="E08｜收货实价到成本采用价"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5695" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="297.99" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="193.99" width="3342.02" height="350.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4560.97" y="241.99" width="1097.05" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_08_title" target="chain_08_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_question" target="chain_08_tbl_app_unit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="from_unit_id → unit_id / to_unit_id → unit_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_app_unit" target="chain_08_tbl_scm_material_unit_conversion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="material_unit_conversion_id → material_unit_conversion_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_material_unit_conversion" target="chain_08_tbl_scm_supplier_item_material_mapping"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="material_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_supplier_item_material_mapping" target="chain_08_tbl_scm_goods_receipt_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="goods_receipt_line_id → goods_receipt_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_goods_receipt_line" target="chain_08_tbl_scm_supplier_price_observation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="supplier_price_observation_id → supplier_price_observation_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_scm_supplier_price_observation" target="chain_08_tbl_cost_card_material_price"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_cost_card_material_price" target="chain_08_tbl_cost_card_cost_run"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_cost_card_cost_run" target="chain_08_tbl_cost_card_product_cost_component"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="product_cost_snapshot_id → product_cost_snapshot_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_cost_card_product_cost_component" target="chain_08_tbl_cost_card_product_cost_snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_tbl_cost_card_product_cost_snapshot" target="chain_08_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_08_joins" target="chain_08_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_08_title" label="端到端 08 · 收货实价到成本采用价&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E08｜收货实价到成本采用价 · 市场采购价波动如何进入配方成本，采用了哪一个价格？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.49" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_08_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;市场采购价波动如何进入配方成本，采用了哪一个价格？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="331.99" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_app_unit" label="&lt;b&gt;app_unit&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个受控计量单位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; canonical_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ unit_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：数据治理管理员&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="258.99" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_material_unit_conversion" label="&lt;b&gt;scm_material_unit_conversion&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：原料 × 起始单位 × 目标单位 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; from_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; to_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ material_id + from_unit_id + to_unit_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, from_unit_id, to_unit_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) W…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;" link="data:page/id,detail-25-scm-material"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="227.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_supplier_item_material_mapping" label="&lt;b&gt;scm_supplier_item_material_mapping&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：版本化记录某供应商 SKU 在一个生效区间内对应哪种统一物料，以及每个订购单位的基础数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_unit_conversion_id &lt;font color='#64748B'&gt;: uuid → scm_material_unit_conversion.material_unit_conversion_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; confirmed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ supplier_item_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(supplier_item_id, tstzrange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;)) WHERE mapping_status =…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：供应链主数据审核&lt;/font&gt;" link="data:page/id,detail-26-scm-supplier"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="227.99" width="310.00" height="300.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_goods_receipt_line" label="&lt;b&gt;scm_goods_receipt_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存每个采购行的实收、拒收、批号、效期和实际价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：收货单 × 采购行 × 可选批号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; goods_receipt_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt.goods_receipt_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND goods_receipt_id + purchase_order_line_id + lot_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：仓库或门店收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#667085;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="250.49" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_scm_supplier_price_observation" label="&lt;b&gt;scm_supplier_price_observation&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：沉淀报价、PO或收货形成的原始和归一化采购价，供成本卡选择生效价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：供应商商品 × 观察时间 × 来源记录一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; supplier_item_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item.supplier_item_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_item_material_mapping_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_item_material_mapping.supplier_item_material_mapping_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; goods_receipt_line_id &lt;font color='#64748B'&gt;: uuid → scm_goods_receipt_line.goods_receipt_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; purchase_order_line_id &lt;font color='#64748B'&gt;: uuid → scm_purchase_order_line.purchase_order_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; raw_price_unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;其余关系字段见逐字段字典&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND source_system_id + source_record_id / UQ ND goods_receipt_line_id + observation_type&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：采购或收货流程&lt;/font&gt;" link="data:page/id,detail-32-scm-receipt-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8F5E9;strokeColor=#3A9258;fontColor=#225C37;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="233.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_cost_card_material_price" label="&lt;b&gt;cost_card_material_price&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从供应商价格观察或人工批准值中选择某地点、原料的有效成本价格。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点或全局 × 原料 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; material_price_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supplier_price_observation_id &lt;font color='#64748B'&gt;: uuid → scm_supplier_price_observation.supplier_price_observation_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; effective_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(material_id, COALESCE(location_id, NIL_UUID), tstzrange(effective_from, effecti…&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本卡网站&lt;/font&gt;" link="data:page/id,detail-34-cost-price"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3077.02" y="233.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_cost_card_cost_run" label="&lt;b&gt;cost_card_cost_run&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录某交易日一次产品成本计算使用的配方和价格版本清单。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：目标营业日 × 一次成本计算一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; cost_run_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_cost_run_id &lt;font color='#64748B'&gt;: uuid → cost_card_cost_run.cost_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ target_business_date + revision_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3452.00" y="258.99" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_cost_card_product_cost_component" label="&lt;b&gt;cost_card_product_cost_component&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：逐项保存产品成本快照采用的原料数量、价格来源和成本贡献。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：产品成本快照 × 配方组件一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_cost_component_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_cost_snapshot_id &lt;font color='#64748B'&gt;: uuid → cost_card_product_cost_snapshot.product_cost_snapshot_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_component_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_component.recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; material_id &lt;font color='#64748B'&gt;: uuid → scm_material.material_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; material_price_id &lt;font color='#64748B'&gt;: uuid → cost_card_material_price.material_price_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ product_cost_snapshot_id + recipe_component_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3826.98" y="241.99" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_08_tbl_cost_card_product_cost_snapshot" label="&lt;b&gt;cost_card_product_cost_snapshot&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结某产品在某地点和营业日的单位成本及覆盖质量，避免后续价格改动重写历史。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：成本运行 × 地点或全局 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_cost_snapshot_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; cost_run_id &lt;font color='#64748B'&gt;: uuid → cost_card_cost_run.cost_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND cost_run_id + location_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4202.02" y="233.49" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_08_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 收货行提供 actual_unit_price 和单位证据&lt;br&gt;2. 价格观察保留 supplier_item_id、supplier_item_material_mapping_id、受控 unit_id、物料换算版本、来源时间和标准化系数快照&lt;br&gt;3. material_price 只引用经批准 observation_id；成本组件锁定 material_price_id&lt;br&gt;4. 收货模块启用前，现有 cost_card_item_price 以 MIGRATED_MANUAL 启动价迁移并保留旧 price_id 与核验证据"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4576.97" y="275.99" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_08_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;市场报价、实际收货价和成本采用价是三层事实；没有单位换算证据的价格不得进入正式成本。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="5142.02" y="321.99" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_08_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;font color='#3A9258'&gt;■&lt;/font&gt; &lt;b&gt;SCM&lt;/b&gt; = 原料、库存、补货、采购与收货&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-09" name="E09｜当日产品毛利与覆盖率"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4255" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="318.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.01" y="219.50" width="1902.01" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3120.97" y="262.00" width="1097.05" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="255.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_09_title" target="chain_09_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_question" target="chain_09_view_v_pos_item_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="location_id + business_date + product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_pos_item_sales_day" target="chain_09_tbl_cost_card_product_cost_snapshot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_tbl_cost_card_product_cost_snapshot" target="chain_09_view_v_cost_card_product_daily_margin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_cost_card_product_daily_margin" target="chain_09_view_v_cost_card_daily_margin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_view_v_cost_card_daily_margin" target="chain_09_tbl_app_data_quality_issue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_tbl_app_data_quality_issue" target="chain_09_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_09_joins" target="chain_09_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_09_title" label="端到端 09 · 当日产品毛利与覆盖率&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E09｜当日产品毛利与覆盖率 · 今天每个产品赚了多少，结论覆盖了多少销售？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="345.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_09_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;今天每个产品赚了多少，结论覆盖了多少销售？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="352.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_sales_hour / pos_product_mapping / pos_product_listing / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1202.01" y="289.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_09_tbl_cost_card_product_cost_snapshot" label="&lt;b&gt;cost_card_product_cost_snapshot&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结某产品在某地点和营业日的单位成本及覆盖质量，避免后续价格改动重写历史。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：成本运行 × 地点或全局 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; product_cost_snapshot_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; cost_run_id &lt;font color='#64748B'&gt;: uuid → cost_card_cost_run.cost_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; recipe_version_id &lt;font color='#64748B'&gt;: uuid → cost_card_recipe_version.recipe_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND cost_run_id + location_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务成本任务&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1596.99" y="253.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_cost_card_product_daily_margin" label="&lt;b&gt;v_cost_card_product_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：连接产品日销量和当天成本快照，计算销售额、COGS、毛利和覆盖率。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_item_sales_day / cost_card_product_cost_snapshot / v_cost_card_cost_run_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cost_run_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1971.98" y="289.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_09_view_v_cost_card_daily_margin" label="&lt;b&gt;v_cost_card_daily_margin&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按地点和营业日汇总产品毛利，同时给出全部成本覆盖和可信成本覆盖。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_daily_margin / v_pos_sales_day_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• costed_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• trusted_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-35-cost-snapshot-margin"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF6D8;strokeColor=#D49A00;fontColor=#765600;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2366.97" y="289.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_09_tbl_app_data_quality_issue" label="&lt;b&gt;app_data_quality_issue&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把身份缺失、批次缺行、金额不平或版本冲突变成可跟踪、可关闭的问题。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个可独立处理的数据质量问题一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; issue_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; resolved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：质量检查任务；人工审核只更新处理状态&lt;/font&gt;" link="data:page/id,detail-01-app-governance"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E8EEF8;strokeColor=#3B6FB6;fontColor=#183A61;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2762.02" y="271.00" width="310.00" height="254.00" as="geometry"/></mxCell></object><object id="chain_09_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 按 location_id + business_date + product_id 连接销售和目标日成本快照&lt;br&gt;2. 数量 × unit_total_cost 得到估算成本，净销售减估算成本得到毛利&lt;br&gt;3. 缺产品映射、缺配方或缺价格的销售额进入 coverage 缺口&lt;br&gt;4. POS更正批次或成本重算产生新revision；毛利输出同时保留pos_ingest_batch_id、cost_run_id和margin_revision_key"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3136.97" y="296.00" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_09_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;毛利率必须与总销售覆盖率和可信成本覆盖率一起展示；覆盖不足时标 ESTIMATED 或 BLOCKED。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="3702.02" y="342.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_09_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#D49A00'&gt;■&lt;/font&gt; &lt;b&gt;COST&lt;/b&gt; = 配方、采购价、成本快照与毛利&lt;br&gt;&lt;font color='#3B6FB6'&gt;■&lt;/font&gt; &lt;b&gt;APP&lt;/b&gt; = 治理、权限与质量&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="205.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-10" name="E10｜计划到生产、配送、销售与复盘"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5380" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="298.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="199.50" width="3027.02" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="4245.97" y="256.00" width="1097.05" height="226.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_10_title" target="chain_10_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_question" target="chain_10_tbl_ops_production_plan_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="production_plan_line_id → production_plan_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_production_plan_line" target="chain_10_tbl_ops_production_run_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="production_run_line_id → production_run_line_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_production_run_line" target="chain_10_tbl_ops_dispatch_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_dispatch_line" target="chain_10_view_v_pos_item_sales_day"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id + business_date + product_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_pos_item_sales_day" target="chain_10_view_v_pos_item_waste_mapped"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_pos_item_waste_mapped" target="chain_10_tbl_ops_stockout_event"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_stockout_event" target="chain_10_view_v_ops_item_daily_pulse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_view_v_ops_item_daily_pulse" target="chain_10_tbl_ops_daily_review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_tbl_ops_daily_review" target="chain_10_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_10_joins" target="chain_10_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_10_title" label="端到端 10 · 计划到生产、配送、销售与复盘&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E10｜计划到生产、配送、销售与复盘 · 计划是否生产、配送并卖出，报废或断货发生在哪里？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_10_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;计划是否生产、配送并卖出，报废或断货发生在哪里？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="332.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_production_plan_line" label="&lt;b&gt;ops_production_plan_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某版本每个产品的计划数量和人工判断来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：预估单版本 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_version.production_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; forecast_line_id &lt;font color='#64748B'&gt;: uuid → ops_forecast_line.forecast_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; planned_quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_plan_version_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps&lt;/font&gt;" link="data:page/id,detail-06-ops-plan"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="242.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_production_run_line" label="&lt;b&gt;ops_production_run_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存实际生产的合格、报废和返工数量，并可追溯到计划行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：生产批次 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; production_run_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; production_run_id &lt;font color='#64748B'&gt;: uuid → ops_production_run.production_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_plan_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_plan_line.production_plan_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ production_run_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：门店/厨房执行流程&lt;/font&gt;" link="data:page/id,detail-07-ops-workload-production"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1576.98" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_dispatch_line" label="&lt;b&gt;ops_dispatch_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存配送中每个产品的发出、接收、拒收和差异数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：配送单 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; dispatch_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; dispatch_id &lt;font color='#64748B'&gt;: uuid → ops_dispatch.dispatch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; product_id &lt;font color='#64748B'&gt;: uuid → ops_product.product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; production_run_line_id &lt;font color='#64748B'&gt;: uuid → ops_production_run_line.production_run_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; unit_id &lt;font color='#64748B'&gt;: uuid → app_unit.unit_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ dispatch_id + product_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：配送执行流程&lt;/font&gt;" link="data:page/id,detail-08-ops-dispatch"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1952.02" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_pos_item_sales_day" label="&lt;b&gt;v_pos_item_sales_day&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把商品小时销售按营业日聚合，并仅在发生时点映射确认后提供 product_id。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × listing × 可选产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_sales_hour / pos_product_mapping / pos_product_listing / pos_ingest_batch&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_ingest_batch_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-14-pos-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2327.01" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_pos_item_waste_mapped" label="&lt;b&gt;v_pos_item_waste_mapped&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：为报废事实补充发生时点已确认product_id和标准损失分类，同时保留未映射行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一条POS报废事实一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_item_waste / pos_product_mapping&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• waste_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• listing_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-15-pos-loss"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2722.00" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_stockout_event" label="&lt;b&gt;ops_stockout_event&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录人工确认或算法识别的断货时段、证据及估算损失。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × listing × 一次连续断货区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; stockout_event_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; detected_job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 断货检测；人工可确认&lt;/font&gt;" link="data:page/id,detail-15-pos-loss"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3116.98" y="242.50" width="310.00" height="271.00" as="geometry"/></mxCell></object><object id="chain_10_view_v_ops_item_daily_pulse" label="&lt;b&gt;v_ops_item_daily_pulse&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把计划、实际产出、配送、销售、报废、断货和成本质量放到同一产品日行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 产品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：ops_production_plan_line / ops_production_plan_version / ops_production_run_line / ops_dispatch_line / v_pos_item_sales_day / pos_item_waste / ops_st…&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• product_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• planned_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• produced_quantity : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3491.97" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_10_tbl_ops_daily_review" label="&lt;b&gt;ops_daily_review&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存某地点营业日的结构化复盘版本，区分人工事实、AI总结和采纳状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 复盘版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; daily_review_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; ai_call_id &lt;font color='#64748B'&gt;: uuid → ai_call.ai_call_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ location_id + business_date + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 复盘流程&lt;/font&gt;" link="data:page/id,detail-09-ops-review"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3887.02" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_10_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 全部产品事实用 product_id，来源 POS 仍保留 listing_id&lt;br&gt;2. 生产回指 plan_line_id，配送回指 production_run_line_id&lt;br&gt;3. 按 location_id + business_date + product_id 汇总 planned/produced/dispatched/sold/waste/stockout"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4261.97" y="290.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_10_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;各事实不可互相推定：生产完成不等于已配送，配送不等于已售，零销量不自动等于断货。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4827.02" y="322.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_10_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
