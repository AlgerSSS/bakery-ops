<mxfile host="Electron" modified="2026-08-05T00:00:00.000Z" agent="HOT CRUSH drawio-skill" version="31.1.5" type="device">
  <diagram id="future-p1-overview" name="01 老板视角总览">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1_title" value="HOT CRUSH 未来数据库蓝图&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;老板视角：从明日计划、关键岗位、订货，到当日销售与毛利的同一事实链&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="320" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="p1_capture" value="&lt;b&gt;统一工作入口｜BakeryOps&lt;/b&gt;&lt;br&gt;自动抓：POS、节假日、Lark 工时、采购来源&lt;br&gt;人工确认：计划调整、突发事件、关键岗位、收货例外" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A74B5;fontColor=#17324D;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="300" height="116" as="geometry"/>
        </mxCell>
        <UserObject label="&lt;b&gt;共享身份脊柱&lt;/b&gt;&lt;br&gt;&lt;b&gt;store_id&lt;/b&gt; 门店　&lt;b&gt;product_id&lt;/b&gt; 可售产品&lt;br&gt;&lt;b&gt;employment_id&lt;/b&gt; 雇佣关系　&lt;b&gt;material_id&lt;/b&gt; 原料&lt;br&gt;&lt;font color='#D8E8F7'&gt;跨表只用稳定 ID，不用名称猜关联&lt;/font&gt;" link="data:page/id,future-p5-governance" id="p1_identity">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="780" y="40" width="320" height="128" as="geometry"/>
        </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;营运闭环&lt;/b&gt;&lt;br&gt;节假日 / 当日突发 → 需求预测&lt;br&gt;→ 预估单版本 / 明日调整&lt;br&gt;→ 分时段计划 → 实际发出 → 销售 / 报废" link="data:page/id,future-p2-operations" id="p1_ops">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97706;fontColor=#7A3E00;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="250" width="290" height="128" as="geometry"/>
        </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;人事与班表闭环&lt;/b&gt;&lt;br&gt;应聘评分 → 入职 → 培训资格&lt;br&gt;→ 班表需求 / 关键岗位 → 员工指派&lt;br&gt;→ Lark 实际工时 → 人效" link="data:page/id,future-p4-hr" id="p1_hr">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EDFA;strokeColor=#7C5AA6;fontColor=#493263;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="960" y="250" width="290" height="128" as="geometry"/>
        </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;供应链与成本闭环&lt;/b&gt;&lt;br&gt;已发布计划 × 配方版本 → 原料需求&lt;br&gt;→ 库存 / 在途 → 订货增减 → 收货实价&lt;br&gt;→ 生效成本快照" link="data:page/id,future-p3-scm-cost" id="p1_scm">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#3F8F5B;fontColor=#205C39;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="290" height="128" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="p1_facts" value="&lt;b&gt;不可覆盖的实际事实&lt;/b&gt;&lt;br&gt;实际发出 ≠ 实际生产 ≠ POS 售出 ≠ 报废&lt;br&gt;计划班表 ≠ Lark 实际工时&lt;br&gt;历史毛利用当日有效成本，不用今天成本倒算" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F7F6;strokeColor=#2E8B88;fontColor=#175E5B;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="600" y="455" width="320" height="134" as="geometry"/>
        </mxCell>
        <mxCell id="p1_decision" value="&lt;b&gt;老板每天看到的动作&lt;/b&gt;&lt;br&gt;① 明日产品计划增减　② 未来订货量增减&lt;br&gt;③ 关键岗位缺口　④ 产品占比升降&lt;br&gt;⑤ 当日毛利率 / 缺货 / 报废异常" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF7DD;strokeColor=#B88916;fontColor=#6D5100;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="980" y="455" width="320" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="p1_rule" value="&lt;b&gt;第一性原理结论&lt;/b&gt;&lt;br&gt;“一次录入”是一个事务写入多张正确粒度的表；&lt;br&gt;不是把预估、采购、班表、销售、工时塞进一张大表。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C94A4A;fontColor=#7D2525;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="980" y="660" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1_sample" value="&lt;b&gt;验收样本：黑巧 / 草莓塔&lt;/b&gt;&lt;br&gt;两款产品都必须从 product_id 追到：&lt;br&gt;预测 → 计划 → 配方 → 订货 → 售出 → 当日成本 → 毛利；&lt;br&gt;名称不一致时进入映射审核队列，绝不静默猜配。" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#7A8390;fontColor=#3E4650;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="330" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="p1_title" target="p1_capture">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_capture" target="p1_identity">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="store_id + product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_identity" target="p1_ops">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="844" y="210"/><mxPoint x="385" y="210"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="store_id + employment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_identity" target="p1_hr">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1036" y="210"/><mxPoint x="1105" y="210"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="product_id + material_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_identity" target="p1_scm">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="210"/><mxPoint x="745" y="210"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="已发布计划量" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#3F8F5B;fontColor=#205C39;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_ops" target="p1_scm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="计划 / 发出 / 销售 / 报废" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="p1_ops" target="p1_facts">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="420"/><mxPoint x="664" y="420"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="计划班表 / 实际工时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#637083;strokeWidth=1.4;fontColor=#3E4650;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="p1_hr" target="p1_facts">
