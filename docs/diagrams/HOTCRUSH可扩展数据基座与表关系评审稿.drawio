        <mxCell id="p9_tbl_cost_card_recipe" value="&lt;b&gt;cost_card_recipe&lt;/b&gt; &lt;font color='#4B5563'&gt;&lt;b&gt;[EXISTING]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：成品成本项 × 配方版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; id &lt;font color='#64748B'&gt;: bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; item_id &lt;font color='#64748B'&gt;: bigint → cost_card_item&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; item_id + version_no &lt;font color='#64748B'&gt;: key&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; effective_from / to &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; yield_quantity / unit &lt;font color='#64748B'&gt;: numeric / text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入者：财务网站（本仓库只读）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#B88916;fontColor=#6D5100;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;strokeWidth=1.6;" vertex="1" parent="group_1">
