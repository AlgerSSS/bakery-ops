        <mxCell id="p9_tbl_cost_card_item" value="&lt;b&gt;cost_card_item&lt;/b&gt; &lt;font color='#9A6700'&gt;&lt;b&gt;[UPGRADE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个成本卡物料 / 成品一行&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; id &lt;font color='#64748B'&gt;: bigint（现有键保留）&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; item_type &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; item_name &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; base_unit &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;&lt;b&gt;·&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入者：财务网站（本仓库只读）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF7DD;strokeColor=#B88916;fontColor=#6D5100;fontSize=11;spacingLeft=9;spacingRight=9;spacingTop=7;spacingBottom=7;strokeWidth=1.6;" vertex="1" parent="group_0">
