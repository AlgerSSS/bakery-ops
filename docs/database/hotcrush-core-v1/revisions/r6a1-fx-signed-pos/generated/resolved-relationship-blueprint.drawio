<mxfile host="app.diagrams.net" version="R6A1-DETERMINISTIC">
  <diagram id="r6a1-fx-signed-pos" name="R6A1 resolved Phase1">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4134" pageHeight="11690" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="table_4569a99c8a1ee6e5c23b" value="ai_call&#xa;AI调用流水&#xa;grain: 一次模型请求一行&#xa;comment: 记录一次模型调用的模板版本、调用方、输入引用、输出、token、成本、延迟和验证结果。&#xa;fields:&#xa;ai_call_id uuid NN — 一次模型调用稳定主键。&#xa;prompt_template_id uuid NN — 调用使用的已批准模板版本。&#xa;job_run_id uuid NULL — 自动任务触发时对应运行。&#xa;actor_user_id uuid NULL — 人工触发调用的账号。&#xa;caller_code text NN — 发起调用的模块或函数稳定代码。&#xa;request_id text NULL — 贯穿应用和数据库的请求追踪号。&#xa;model_provider text NN — 实际调用的提供方。&#xa;model_name text NN — 提供方最终返回的模型标识。&#xa;prompt_redacted text NN — 经过批准规则脱敏后的最终 Prompt 或可审计摘要。&#xa;input_manifest jsonb NN — 业务对象ID、版本和字段摘要。&#xa;response_redacted text NULL — 经过策略处理的模型原始输出。&#xa;parsed_output jsonb NULL — 通过输出 Schema 解析的结果。&#xa;validation_status text NN — VALID、INVALID_SCHEMA、SAFETY_BLOCKED、INCOMPLETE 或 NOT_APPLICABLE。&#xa;input_tokens integer NULL — 提供方报告的输入 token 数。&#xa;output_tokens integer NULL — 提供方报告的输出 token 数。&#xa;cost_usd numeric(18,8) NULL — 本次调用估算或实际美元成本。&#xa;latency_ms integer NULL — 从请求到完整响应的耗时。&#xa;status text NN — RUNNING、SUCCEEDED、FAILED、CANCELLED 或 BLOCKED。&#xa;started_at timestamptz NN — AI请求开始时间。&#xa;completed_at timestamptz NULL — 调用进入终态时间。&#xa;error_code text NULL — 失败时机器可读错误。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4fccbcc4b4519408f142" value="ai_prompt_segment&#xa;Prompt片段版本&#xa;grain: Prompt片段代码 × 版本号一行&#xa;comment: 一行冻结一个可复用 Prompt 片段版本的内容、变量结构和校验值；不在每个模板关联中重复复制内容。&#xa;fields:&#xa;prompt_segment_id uuid NN — 一版 Prompt 片段稳定身份。&#xa;segment_code text NN — 程序引用的稳定片段代码。&#xa;version_no integer NN — 同一片段代码内从 1 递增的版本号。&#xa;segment_name text NN — 该版本发布时的显示名称。&#xa;segment_category text NN — ROLE、RULE、KNOWLEDGE、CONTEXT 或 FORMAT。&#xa;content text NN — 本片段版本冻结的 Prompt 文本。&#xa;content_sha256 char(64) NN — 片段内容 SHA-256。&#xa;variable_schema jsonb NN — 本片段允许注入的变量及类型。&#xa;status text NN — DRAFT、APPROVED、ACTIVE、RETIRED 或 REJECTED。&#xa;approved_by_user_id uuid NULL — 批准该片段版本的账号。&#xa;approved_at timestamptz NULL — 该片段版本获批时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_9defb840dc7aa3f24340" value="ai_prompt_template&#xa;Prompt模板版本&#xa;grain: AI场景代码 × 版本号一行&#xa;comment: 一行冻结一个 AI 场景模板版本的模型、参数、输出 schema 和安全策略；不再为稳定模板头另拆版本表。&#xa;fields:&#xa;prompt_template_id uuid NN — 一版 Prompt 模板稳定身份。&#xa;template_code text NN — 程序调用的稳定 AI 场景代码。&#xa;version_no integer NN — 场景代码内递增版本。&#xa;template_name text NN — 该版本发布时的显示名称。&#xa;purpose text NN — 该版本允许生成的内容和禁止用途。&#xa;model_provider text NN — OPENAI、OPENROUTER、GEMINI 或批准提供方。&#xa;model_name text NN — 发布时批准的具体模型标识。&#xa;temperature numeric(5,4) NN — 模型采样温度。&#xa;top_p numeric(5,4) NN — 核采样参数。&#xa;output_schema jsonb NN — 要求模型输出的 JSON Schema。&#xa;safety_policy_version text NN — PII、秘密、提示注入和输出使用限制版本。&#xa;status text NN — DRAFT、APPROVED、ACTIVE、RETIRED 或 REJECTED。&#xa;approved_by_user_id uuid NULL — 批准模板版本的账号。&#xa;approved_at timestamptz NULL — 模板版本获批时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_94c45110e1de71c436c2" value="ai_prompt_template_segment&#xa;模板片段组合&#xa;grain: 模板版本 × 顺序一行&#xa;comment: 按顺序连接模板版本和已冻结片段版本，只保存组合关系及消息角色。&#xa;fields:&#xa;prompt_template_segment_id uuid NN — 一条模板片段版本稳定主键。&#xa;prompt_template_id uuid NN — 所属 Prompt 模板版本。&#xa;prompt_segment_id uuid NN — 引用的已冻结 Prompt 片段版本。&#xa;sequence_no integer NN — 片段进入最终 Prompt 的顺序。&#xa;role text NN — SYSTEM、DEVELOPER、USER 或 CONTEXT。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_b264c2e28c9b744c5900" value="app_audit_event&#xa;受控操作审计流水&#xa;grain: 一次已完成或拒绝的受控操作一行&#xa;comment: 只追加记录登录、权限、人工改数、审批和敏感读取等受控操作。&#xa;fields:&#xa;audit_event_id uuid NN — 审计事件稳定主键。&#xa;actor_user_id uuid NULL — 发起操作的应用账号；系统任务可以为空。&#xa;job_run_id uuid NULL — 由自动任务触发时对应的运行记录。&#xa;actor_type text NN — USER、SERVICE 或 DATABASE。&#xa;action_code text NN — 机器可读的受控动作代码，例如 COST_PRICE_APPROVE。&#xa;object_type text NN — 被操作目标表或批准聚合的受控代码，只允许 HOT CRUSH 已登记域前缀。&#xa;object_id uuid NULL — 被操作目标行的 UUID 主键；对无单行对象的聚合动作可以为空。&#xa;request_id text NULL — 贯穿网关、应用日志与数据库审计的请求追踪号。&#xa;operation_id uuid NULL — 五个 R6A1 受控成功主动作的幂等操作身份；普通审计事件为空。&#xa;result text NN — SUCCESS、DENIED 或 FAILED。&#xa;before_data jsonb NULL — 受控修改前的脱敏字段快照。&#xa;after_data jsonb NULL — 受控修改后的脱敏字段快照。&#xa;ip_address inet NULL — 请求来源 IP；后台任务可以为空。&#xa;user_agent text NULL — 客户端或服务的 User-Agent 摘要。&#xa;occurred_at timestamptz NN — 操作结果确定的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4f4c444a6dd9d3c9a9d4" value="app_currency&#xa;币种字典&#xa;grain: 一个 ISO 4217 币种代码一行&#xa;comment: 登记获准用于业务事实的 ISO 4217 币种身份和最小货币单位，不保存业务舍入政策。&#xa;fields:&#xa;currency_code char(3) NN — ISO 4217 三字母稳定代码。&#xa;numeric_code char(3) NULL — ISO 4217 数字代码；未知或不适用时为空。&#xa;currency_name text NN — 币种正式显示名称，不作为连接键。&#xa;minor_unit smallint NULL — 标准通常使用的小数位数；不是业务舍入政策。&#xa;status text NN — ACTIVE 可用于新事实，RETIRED 仅解释历史。&#xa;valid_from date NULL — 可靠证据中的标准启用日期。&#xa;valid_to date NULL — 可靠证据中的标准退役日期。&#xa;standard_source_ref text NN — 采用的标准版本或证据引用，不得放密钥。&#xa;created_at timestamptz NN — 目标库登记时间，不冒充标准启用时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4f6ea62cc923a3d9301a" value="app_job_run&#xa;自动任务运行记录&#xa;grain: 某个任务的一次运行一行&#xa;comment: 统一记录抓取、预测、成本计算和同步任务每次运行的输入窗口、结果和错误。&#xa;fields:&#xa;job_run_id uuid NN — 一次任务运行的稳定身份。&#xa;source_system_id uuid NULL — 该任务主要读取的数据来源；纯内部计算可以为空。&#xa;job_code text NN — 不可变的任务名称。&#xa;scheduled_for timestamptz NULL — 调度器原计划启动的时间。&#xa;started_at timestamptz NN — 任务真正开始处理的时间。&#xa;finished_at timestamptz NULL — 任务成功、失败或取消时结束的时间。&#xa;status text NN — QUEUED、RUNNING、SUCCEEDED、FAILED、PARTIAL 或 CANCELLED。&#xa;input_manifest jsonb NN — 输入日期窗口、文件哈希、游标或上游版本的结构化清单。&#xa;row_count bigint NULL — 任务实际读取或生成的主要记录数。&#xa;error_code text NULL — 失败或部分成功时的机器可读错误类别。&#xa;error_detail text NULL — 经过脱敏的错误摘要。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="40" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_47ce1f088926483b80e8" value="app_one_time_token&#xa;一次性访问令牌&#xa;grain: 一个一次性令牌一行&#xa;comment: 为 HBTI、重置密码或一次性公开流程保存哈希令牌和消费状态。&#xa;fields:&#xa;one_time_token_id uuid NN — 一次性令牌记录稳定主键。&#xa;token_purpose text NN — 令牌允许完成的单一目的。&#xa;user_id uuid NULL — 令牌用于账号重置或账号级一次性动作时连接的应用账号。&#xa;member_id uuid NULL — 令牌直接代表会员身份时连接的 POS 会员。&#xa;campaign_member_id uuid NULL — 令牌用于某一活动参与流程时连接的活动会员记录。&#xa;application_id uuid NULL — 令牌用于候选预约或资料确认时连接的招聘申请。&#xa;token_hash char(64) NN — 发送给用户的随机令牌哈希。&#xa;expires_at timestamptz NN — 令牌最后可使用时间。&#xa;consumed_at timestamptz NULL — 令牌首次成功使用时间。&#xa;revoked_at timestamptz NULL — 未消费前被管理员或系统撤销的时间。&#xa;return_route_code text NULL — 令牌消费成功后允许进入的已登记内部路由代码；不保存任意 URL。&#xa;metadata jsonb NN — 不驱动授权、主体选择或跳转的最小签发上下文快照。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_b674e3dadbbd6898648e" value="app_rate_limit_event&#xa;限流计数事件&#xa;grain: 限流键 × 时间桶一行&#xa;comment: 记录受保护接口的限流计数，替代 HBTI 专用的孤立限流表。&#xa;fields:&#xa;rate_limit_event_id uuid NN — 限流桶稳定主键。&#xa;scope_code text NN — 被限制的接口或动作代码。&#xa;key_hash char(64) NN — IP、会员或令牌等限流键的不可逆哈希。&#xa;window_started_at timestamptz NN — 固定限流时间桶开始时间。&#xa;window_seconds integer NN — 本限流桶持续秒数。&#xa;request_count integer NN — 该时间桶内已计数的请求数量。&#xa;blocked_count integer NN — 因超过阈值而被拒绝的请求数量。&#xa;expires_at timestamptz NN — 该计数桶可安全删除的时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_78af2261bda29d6b8577" value="app_role&#xa;应用角色&#xa;grain: 一个角色一行&#xa;comment: 定义可分配给账号的角色集合。&#xa;fields:&#xa;role_id uuid NN — 角色稳定身份。&#xa;role_code text NN — 程序判断使用的唯一不可变代码。&#xa;role_name text NN — 给管理员阅读的角色名称。&#xa;description text NN — 该角色的业务职责和授权边界。&#xa;status text NN — ACTIVE 或 RETIRED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_638b8569572433e45f52" value="app_schema_migration&#xa;迁移版本台账&#xa;grain: 代码仓库 × 迁移版本一行&#xa;comment: 按代码仓库分别记录已执行的迁移，消除多个项目共用单一数字版本造成的冲突。&#xa;fields:&#xa;migration_id uuid NN — 迁移台账内部稳定主键。&#xa;repository_code text NN — 产生这条迁移的代码仓库稳定代码。&#xa;migration_version text NN — 仓库内部不可重复的迁移版本。&#xa;migration_name text NULL — 来源台账记录的人类可读迁移标题；来源没有时为空。&#xa;filename text NN — 实际执行的迁移文件名。&#xa;checksum_sha256 char(64) NN — 迁移文件内容的 SHA-256。&#xa;applied_at timestamptz NN — 迁移成功提交的时间。&#xa;applied_by text NN — 执行迁移的人或自动化身份。&#xa;execution_ms integer NULL — 迁移事务的实际耗时。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_6b4ed749fa9ec1cd31dc" value="app_session&#xa;登录会话&#xa;grain: 一个登录会话一行&#xa;comment: 保存经过哈希的登录会话及其过期和撤销状态。&#xa;fields:&#xa;session_id uuid NN — 会话稳定主键；客户端令牌使用另一随机值。&#xa;user_id uuid NN — 会话所属账号。&#xa;token_hash char(64) NN — 客户端会话令牌的 SHA-256，数据库不保存原令牌。&#xa;issued_at timestamptz NN — 会话创建时间。&#xa;expires_at timestamptz NN — 会话自动失效时间。&#xa;revoked_at timestamptz NULL — 登出或管理员撤销会话的时间。&#xa;ip_address inet NULL — 签发会话时的请求 IP。&#xa;user_agent text NULL — 签发会话时的客户端摘要。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_b6a904132dfc2107de2e" value="app_source_system&#xa;来源系统注册表&#xa;grain: 每个可区分的数据来源系统一行&#xa;comment: 登记 RES、Lark、财务模板、人工后台等数据来源及其责任边界。&#xa;fields:&#xa;source_system_id uuid NN — 来源系统稳定身份。&#xa;source_code text NN — 程序和数据字典使用的不可变代码。&#xa;source_name text NN — 给人阅读的来源系统名称。&#xa;source_type text NN — 来源属于 API、FILE、MANUAL、DATABASE 或 GENERATED。&#xa;owner_project text NN — 负责读取该来源并写入规范表的唯一项目。&#xa;authoritative_scope text NN — 该来源在哪些事实上具备权威性。&#xa;status text NN — 来源是否 ACTIVE、PAUSED 或 RETIRED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_eec279dfbbed582ad862" value="app_unit&#xa;统一计量单位&#xa;grain: 一个受控计量单位一行&#xa;comment: 登记产品、原料、配方、采购和库存共同使用的计量单位；单位代码只表达计量含义，不夹带某个供应商包装规格。&#xa;fields:&#xa;unit_id uuid NN — 跨产品、原料、配方、采购和库存使用的稳定计量单位身份。&#xa;unit_code text NN — 程序使用的唯一、大小写受控单位代码。&#xa;unit_name text NN — 给业务人员阅读的单位名称。&#xa;dimension_code text NN — MASS、VOLUME、COUNT、LENGTH、PACKAGING 或 OTHER。&#xa;canonical_unit_id uuid NULL — 同量纲的企业基准单位；包装等只能按具体物料换算时可以为空。&#xa;factor_to_canonical numeric(24,12) NULL — 一个本单位等于多少个 canonical_unit_id；没有全局线性换算时为空。&#xa;decimal_scale smallint NN — 该单位业务录入和展示建议保留的小数位。&#xa;status text NN — ACTIVE 或 RETIRED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="770" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_5351815c5d4500447d2c" value="app_user&#xa;统一应用账号&#xa;grain: 每个可登录或可代表服务的账号一行&#xa;comment: 统一财务、BakeryOps及未来后台的登录账号；不等同于员工自然人。&#xa;fields:&#xa;user_id uuid NN — 应用账号稳定身份。&#xa;person_id uuid NULL — 账号对应自然人；服务账号可以为空。&#xa;username citext NN — 唯一、大小写不敏感的登录名。&#xa;display_name text NN — 界面显示的账号名称。&#xa;password_hash text NULL — 采用批准算法生成的密码哈希；单点登录账号可以为空。&#xa;account_type text NN — HUMAN 或 SERVICE。&#xa;status text NN — ACTIVE、LOCKED、DISABLED 或 PENDING_RESET。&#xa;must_change_password boolean NN — 下次密码登录是否必须先修改密码。&#xa;failed_login_count integer NN — 自上次成功登录后的连续失败次数。&#xa;last_login_at timestamptz NULL — 最近一次成功认证时间。&#xa;notification_subscription_codes text[] NN — 该账号主动保留的自动推送类型代码集合；空数组表示当前不订阅任何自动推送。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_a1c56ed0b39d6772e817" value="app_user_location_scope&#xa;账号地点范围&#xa;grain: 账号角色分配 × 地点 × 权限范围一行&#xa;comment: 限制一项账号角色分配可以读取或操作哪些门店、厨房或仓库，避免多角色账号的地点范围互相串用。&#xa;fields:&#xa;user_location_scope_id uuid NN — 地点授权稳定主键。&#xa;user_role_id uuid NN — 被限定地点范围的具体账号角色分配；同一账号有多个角色时必须分别授权。&#xa;location_id uuid NN — 账号可访问的地点。&#xa;scope_level text NN — READ、WRITE 或 ADMIN。&#xa;valid_from timestamptz NN — 地点授权开始时间。&#xa;valid_to timestamptz NULL — 地点授权结束时间；长期有效为空。&#xa;granted_by_user_id uuid NN — 批准地点范围的管理员账号。&#xa;revoked_at timestamptz NULL — 管理员提前撤销地点权限的绝对时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_2b777af7c15f41722a59" value="app_user_role&#xa;账号角色分配&#xa;grain: 账号 × 角色 × 生效区间一行&#xa;comment: 记录账号在有效期内拥有的角色。&#xa;fields:&#xa;user_role_id uuid NN — 一次角色分配稳定主键。&#xa;user_id uuid NN — 被授权账号。&#xa;role_id uuid NN — 授予的角色。&#xa;valid_from timestamptz NN — 角色权限开始有效的时间。&#xa;valid_to timestamptz NULL — 角色权限自动失效时间；长期授权为空。&#xa;granted_by_user_id uuid NN — 批准本次授权的账号。&#xa;revoked_at timestamptz NULL — 提前撤销授权的时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_a532dca418c5621b1c0b" value="cost_card_material_cost_selection&#xa;原料成本采用&#xa;grain: 原料 × 目标币种指定 × 生效区间一行&#xa;comment: 保存一条经批准的原料价格/目标币种指定/换算政策/直接汇率采用关系，不存派生成本金额。&#xa;fields:&#xa;material_cost_selection_id uuid NN — 成本采用稳定主键。&#xa;material_id uuid NN — 被采用价格的原料。&#xa;material_price_observation_id uuid NN — 被采用的原始价格观察；复合外键同时钉住原料与原币种。&#xa;source_currency_code char(3) NN — 价格观察的 transaction_currency_code。&#xa;target_currency_code char(3) NN — 目标币种指定中的币种。&#xa;target_currency_assignment_id uuid NN — 采用时有效的 LOCATION/OPERATING 或 ACCOUNTING_ENTITY/FUNCTIONAL 指定。&#xa;currency_policy_id uuid NN — 采用时有效的 MATERIAL_COST 换算政策。&#xa;fx_rate_observation_id uuid NULL — 跨币采用的直接汇率观察；同币必须为空。&#xa;cost_basis text NN — R6A1 仅 PURCHASE_PRICE_ONLY。&#xa;formula_version text NN — 不可变成本公式版本。&#xa;effective_from timestamptz NN — 采用有效区间含下界。&#xa;effective_to timestamptz NULL — 采用有效区间不含上界。&#xa;quality_status text NN — DRAFT、VERIFIED、FX_MISSING、STALE_RATE、UNIT_ERROR 或 REJECTED。&#xa;evidence jsonb NN — 批准、输入和例外证据；无默认空对象。&#xa;approved_by_user_id uuid NULL — VERIFIED 采用的批准用户。&#xa;approved_at timestamptz NULL — VERIFIED 采用的批准时间。&#xa;created_by_user_id uuid NULL — 创建采用记录的用户。&#xa;created_at timestamptz NN — 记录创建时间。&#xa;updated_at timestamptz NN — 受控状态更新时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_529dc14f1b28cb4c2191" value="cost_card_recipe_component&#xa;配方原料组件&#xa;grain: 配方版本 × 原料 × 序号一行&#xa;comment: 逐项保存配方版本的统一原料用量、损耗和净得率。&#xa;fields:&#xa;recipe_component_id uuid NN — 一条配方用料稳定主键。&#xa;recipe_version_id uuid NN — 所属配方版本。&#xa;material_id uuid NN — 配方使用的统一原料或半成品。&#xa;sequence_no integer NN — 配方展示和执行顺序。&#xa;input_quantity numeric(18,8) NN — 按 input_unit_id 的配方投料量。&#xa;input_unit_id uuid NN — 配方投料采用的受控单位。&#xa;material_unit_conversion_id uuid NULL — 投料单位与物料基础单位不同时采用的已核验换算；全局单位换算可为空。&#xa;net_yield_rate numeric(9,6) NN — 原料可用比例，0到1。&#xa;loss_rate numeric(9,6) NN — 生产过程额外损耗比例，0到1。&#xa;is_optional boolean NN — 组件是否仅在特定变体使用。&#xa;condition_schema_version text NULL — condition_rule 对应的固定 JSON Schema 版本；非可选组件为空。&#xa;condition_rule jsonb NULL — 可选组件按 condition_schema_version 校验的结构化条件；未知键拒绝。&#xa;note text NULL — 只属于本配方组件的操作说明或迁移备注。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_7c42157705bd7891d2b6" value="cost_card_recipe_version&#xa;配方版本&#xa;grain: 配方代码 × 版本号一行&#xa;comment: 一行冻结一个配方代码版本的名称、产出对象、批产量、生效区间和发布治理。&#xa;fields:&#xa;recipe_version_id uuid NN — 一版配方稳定身份。&#xa;recipe_code text NN — 跨版本稳定且不可复用的企业配方代码。&#xa;recipe_name text NN — 本版本发布时的配方显示名称。&#xa;output_product_id uuid NULL — 配方产出可售产品时填写。&#xa;output_material_id uuid NULL — 配方产出半成品时填写。&#xa;version_no integer NN — 配方内递增版本。&#xa;batch_yield_quantity numeric(18,6) NN — 一批配方产生的产出基础单位数量。&#xa;yield_unit_id uuid NN — 批产量采用的受控单位；必须等于产出产品或半成品的基础单位。&#xa;effective_from timestamptz NULL — 配方开始用于新生产和成本快照的时间；仅历史迁移且尚未生效的 DRAFT 可为空。&#xa;effective_to timestamptz NULL — 配方停止生效时间。&#xa;status text NN — DRAFT、PUBLISHED、ARCHIVED 或 REJECTED。&#xa;notes text NULL — 本版本由成本卡人员录入的操作说明、适用边界或迁移备注。&#xa;lock_version integer NN — DRAFT 每次受控修改递增的乐观锁版本；发布后冻结。&#xa;approved_by_user_id uuid NULL — 批准配方版本的账号。&#xa;approved_at timestamptz NULL — 配方获批时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_8d4486da6837898dfb30" value="finance_accounting_entity&#xa;会计主体&#xa;grain: 一个 LEGAL_ENTITY 或 BRANCH 稳定身份一行&#xa;comment: 登记法律实体或其分支这一可拥有独立功能币的会计主体；不表达集团或列报范围。&#xa;fields:&#xa;accounting_entity_id uuid NN — 会计主体稳定主键。&#xa;entity_code text NN — 跨版本稳定内部代码，不使用名称连接。&#xa;entity_name text NN — 经证据核验的法定实体或分支名称。&#xa;entity_kind text NN — LEGAL_ENTITY 或 BRANCH；BRANCH 只能从属法律实体。&#xa;parent_accounting_entity_id uuid NULL — BRANCH 的法定承载法律实体；不表示集团母子关系。&#xa;jurisdiction_country_code char(2) NN — 有证据的 ISO alpha-2 管辖代码；当前没有 app_country，不伪造外键。&#xa;registration_authority_code text NULL — 登记机关受控代码；无可靠登记事实时为空。&#xa;registration_no text NULL — 登记机关下的主体登记号码。&#xa;status text NN — 治理状态；没有权威证据不得标 ACTIVE。&#xa;evidence jsonb NN — 主体身份、登记信息及来源证明；无默认空对象。&#xa;verified_by_user_id uuid NULL — 人工核验用户；ACTIVE/RETIRED 必填。&#xa;verified_at timestamptz NULL — 主体身份完成核验的时间。&#xa;created_by_user_id uuid NULL — 创建该治理记录的用户。&#xa;created_at timestamptz NN — 记录创建时间。&#xa;updated_at timestamptz NN — 受控更新完成时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="1500" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_12e6f4219dc5a2fd2278" value="finance_cashflow_line&#xa;财务现金流行&#xa;grain: 财务批次 × 地点 × 月份 × 现金流项目一行&#xa;comment: 保存门店月度现金流项目和金额，不与收入或利润混用。&#xa;fields:&#xa;finance_cashflow_line_id uuid NN — 一条现金流事实稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;location_id uuid NN — 现金流归属地点。&#xa;business_month date NN — 月份第一日。&#xa;cashflow_code text NN — OPENING_BALANCE、CASH_IN、CASH_OUT、REFUND、BANK_DEPOSIT 或 CLOSING_BALANCE。&#xa;amount numeric(18,4) NN — 该项目月度金额。&#xa;currency char(3) NN — 金额币种。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_eb4ccb4ff792e01fea77" value="finance_currency_assignment&#xa;币种指定&#xa;grain: 作用域身份 × 币种角色 × 有效区间 × 版本一行&#xa;comment: 按有效期指定地点经营币或会计主体功能币；不承载集团列报币。&#xa;fields:&#xa;currency_assignment_id uuid NN — 币种指定稳定主键。&#xa;assignment_code text NN — 跨版本稳定业务代码。&#xa;version_no integer NN — 同一指定代码的递增版本号。&#xa;scope_type text NN — LOCATION 或 ACCOUNTING_ENTITY。&#xa;location_id uuid NULL — LOCATION/OPERATING 作用域的稳定地点。&#xa;accounting_entity_id uuid NULL — ACCOUNTING_ENTITY/FUNCTIONAL 作用域。&#xa;currency_role text NN — R6A1 仅 OPERATING 或 FUNCTIONAL。&#xa;currency_code char(3) NN — 指定的 ISO 4217 币种。&#xa;effective_from timestamptz NN — 指定有效区间的含下界。&#xa;effective_to timestamptz NULL — 指定有效区间的不含上界。&#xa;status text NN — DRAFT、APPROVED、RETIRED 或 REJECTED。&#xa;approved_by_user_id uuid NULL — 批准或退役指定的用户。&#xa;approved_at timestamptz NULL — 批准或退役治理时间。&#xa;evidence jsonb NN — 指定依据；无默认空对象。&#xa;created_by_user_id uuid NULL — 创建记录的用户。&#xa;created_at timestamptz NN — 记录创建时间。&#xa;updated_at timestamptz NN — 受控更新完成时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_9a81caeb47bc76757f14" value="finance_currency_policy&#xa;币种换算政策&#xa;grain: 目标币种指定 × 原币种 × MATERIAL_COST 用途 × 有效区间 × 版本一行&#xa;comment: 把一个目标币种指定与原币种、直接汇率选择、时点、新鲜度和舍入规则绑定。&#xa;fields:&#xa;currency_policy_id uuid NN — 币种换算政策版本稳定主键。&#xa;policy_code text NN — 跨版本稳定业务代码。&#xa;version_no integer NN — 同政策代码的递增版本号。&#xa;target_currency_assignment_id uuid NN — 政策所采用的有效币种指定；由复合外键同时钉住目标币种。&#xa;source_currency_code char(3) NN — 价格观察的原始交易币种。&#xa;target_currency_code char(3) NN — 目标指定中的币种；不另建简单外键以避免双重身份。&#xa;conversion_purpose text NN — R6A1 仅 MATERIAL_COST。&#xa;required_rate_type text NULL — 跨币直接汇率类型；同币政策为空。&#xa;required_rate_basis text NULL — 跨币汇率基准；同币政策为空。&#xa;rate_time_rule text NULL — R6A1 跨币只允许价格观察时点之前最近一条。&#xa;rate_source_system_id uuid NULL — 跨币政策指定的权威直接汇率来源。&#xa;max_rate_age_seconds integer NULL — 跨币报价允许的最大年龄；同币为空。&#xa;missing_rate_behavior text NN — 必须 FAIL_CLOSED，不允许静默换源或默认1。&#xa;rounding_scale smallint NN — 最终业务金额保留位数。&#xa;rounding_mode text NN — HALF_UP、HALF_EVEN 或向零截断 DOWN。&#xa;effective_from timestamptz NN — 政策有效区间含下界。&#xa;effective_to timestamptz NULL — 政策有效区间不含上界。&#xa;status text NN — DRAFT、APPROVED、RETIRED 或 REJECTED。&#xa;approved_by_user_id uuid NULL — 批准或退役政策的用户。&#xa;approved_at timestamptz NULL — 政策批准或退役治理时间。&#xa;evidence jsonb NN — 换算、来源、新鲜度和舍入决议证据；无默认空对象。&#xa;created_by_user_id uuid NULL — 创建记录的用户。&#xa;created_at timestamptz NN — 记录创建时间。&#xa;updated_at timestamptz NN — 受控更新完成时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_faff89ae5bf349b16fa1" value="finance_fx_rate_observation&#xa;汇率观察&#xa;grain: 来源系统 × 稳定来源记录 × 修订前驱一行&#xa;comment: 不可变保存一个来源记录的一次直接方向汇率观察；修订追加新行而不覆盖历史。&#xa;fields:&#xa;fx_rate_observation_id uuid NN — 汇率观察稳定主键。&#xa;source_system_id uuid NN — 报价提供方或受控人工来源。&#xa;source_job_run_id uuid NULL — 自动采集/核验任务；人工路径可空。&#xa;source_record_id text NN — 提供方稳定行身份；解释版本由 job input_manifest 钉住。&#xa;from_currency_code char(3) NN — 被转换的 ISO 4217 币种。&#xa;to_currency_code char(3) NN — 直接报价的目标 ISO 4217 币种。&#xa;rate numeric(38,18) NN — 一单位原币乘此值等于目标币金额。&#xa;rate_type text NN — SPOT 或 DAILY_CLOSE。&#xa;rate_basis text NN — MID、BID、ASK 或 OFFICIAL_REFERENCE。&#xa;quoted_at timestamptz NN — 汇率对应的市场或业务报价时点。&#xa;provider_published_at timestamptz NULL — 提供方实际发布时间。&#xa;ingested_at timestamptz NN — 载荷进入受控目标的时间。&#xa;source_payload_sha256 char(64) NN — 规范报价载荷的 lowercase SHA-256；不含捕获元数据。&#xa;source_payload_ref text NN — 加密证据载荷的稳定引用，不得存秘密本身。&#xa;supersedes_fx_rate_observation_id uuid NULL — 本修订直接替代的当前终态观察；初始行为空。&#xa;quality_status text NN — OBSERVED、VERIFIED 或 REJECTED。&#xa;verified_by_user_id uuid NULL — 人工核验者；权威自动核验时可空。&#xa;verified_at timestamptz NULL — VERIFIED 时的核验时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_1e91e69033007897d95f" value="finance_import_batch&#xa;财务导入批次&#xa;grain: 来源文件或数据集 × 一次导入一行&#xa;comment: 记录财务模板、银行文件或人工数据每次导入的文件、期间、校验值和批准状态。&#xa;fields:&#xa;finance_import_batch_id uuid NN — 一次财务导入稳定身份。&#xa;source_system_id uuid NN — 财务数据来源。&#xa;job_run_id uuid NULL — 自动导入任务；网页人工导入可为空。&#xa;scope_location_id uuid NULL — 文件只覆盖一个地点时填写；明确为多地点或公司级数据时为空。&#xa;supersedes_finance_import_batch_id uuid NULL — 本批明确更正并替代的旧批次；首次导入为空。&#xa;dataset_code text NN — SALES_DAILY、MONTHLY_COST、CASHFLOW 等类型。&#xa;source_layer text NN — OPERATIONAL_TEMPLATE、MANAGEMENT_REPORT、POSTED_LEDGER 或 BANK_STATEMENT。&#xa;recognition_status text NN — SOURCE_ONLY、APPROVED_FOR_RECONCILIATION、POSTED_ACCOUNTING 或 EXCLUDED。&#xa;source_filename text NULL — 用户上传或同步文件的原始文件名。&#xa;file_sha256 char(64) NULL — 原始文件 SHA-256。&#xa;period_start date NN — 文件覆盖会计期间起点。&#xa;period_end date NN — 文件覆盖会计期间终点。&#xa;template_version text NN — 解析所依据的财务模板版本。&#xa;loaded_row_count bigint NN — 导入成功或确认幂等的记录数。&#xa;status text NN — UPLOADED、VALIDATED、APPROVED、LOADED、REJECTED 或 FAILED。&#xa;approved_by_user_id uuid NULL — 批准财务导入的账号。&#xa;approved_at timestamptz NULL — 批次通过财务校验的时间。&#xa;validation_result jsonb NN — 模板结构、合计、重复和映射检查结果。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_3c31ebff79fbd8151ef0" value="finance_inventory_flow_line&#xa;财务月进销存行&#xa;grain: 财务批次 × 地点 × 月份 × 仓别 × 来源物料一行&#xa;comment: 保存财务模板按仓别的期初、入库、领用和期末数量。&#xa;fields:&#xa;finance_inventory_flow_line_id uuid NN — 一条月进销存稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;source_row_ref text NN — 导入文件中的稳定行定位，例如工作表名与原始行号或来源记录号。&#xa;source_row_fingerprint char(64) NN — 按版本化规范对来源行原值计算的 SHA-256。&#xa;location_id uuid NN — 进销存归属地点。&#xa;material_id uuid NULL — 确认映射的统一原料；未知为空。&#xa;business_month date NN — 月份第一日。&#xa;warehouse_type text NN — AMBIENT、FROZEN、CHILLED 或 OTHER。&#xa;source_item_name text NN — 模板原始物料名称。&#xa;opening_quantity numeric(18,6) NN — 模板口径期初库存。&#xa;received_quantity numeric(18,6) NN — 模板口径本月入库。&#xa;issued_quantity numeric(18,6) NN — 模板口径本月领用。&#xa;closing_quantity numeric(18,6) NN — 模板口径期末库存。&#xa;source_unit text NULL — 模板数量单位。&#xa;quality_status text NN — COMPLETE、BALANCE_MISMATCH、UNMAPPED_MATERIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_2133b45681f841e88c46" value="finance_inventory_snapshot_line&#xa;财务月库存快照行&#xa;grain: 财务批次 × 地点 × 月份 × 来源物料一行&#xa;comment: 保存财务模板月末现存、在途、用量、规格和采购类型。&#xa;fields:&#xa;finance_inventory_snapshot_line_id uuid NN — 一条财务库存快照稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;source_row_ref text NN — 导入文件中的稳定行定位，例如工作表名与原始行号或来源记录号。&#xa;source_row_fingerprint char(64) NN — 按版本化规范对来源行原值计算的 SHA-256。&#xa;location_id uuid NN — 库存归属地点。&#xa;material_id uuid NULL — 确认映射的统一原料；未知为空。&#xa;business_month date NN — 月末快照所属月份第一日。&#xa;source_item_name text NN — 财务模板原始名称。&#xa;specification text NULL — 模板中的包装规格。&#xa;source_category text NULL — 财务库存模板中的类别原文。&#xa;on_hand_quantity numeric(18,6) NULL — 模板口径月末现存量。&#xa;in_transit_quantity numeric(18,6) NULL — 模板口径在途量。&#xa;monthly_usage_quantity numeric(18,6) NULL — 模板口径当月耗用。&#xa;source_unit text NULL — 财务模板数量单位。&#xa;source_unit_volume numeric(18,6) NULL — 财务库存模板 unit_volume 的原始数值；来源为空时保持为空。&#xa;purchase_type text NULL — LOCAL、IMPORT 或 UNKNOWN。&#xa;quality_status text NN — COMPLETE、UNMAPPED_MATERIAL、UNIT_UNMAPPED、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="2230" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_1c8305f5dce229172d89" value="finance_item_sales_monthly&#xa;财务单品月销售&#xa;grain: 财务批次 × 地点 × 月份 × 来源商品一行&#xa;comment: 保存财务模板中月度单品数量和金额，作为 POS 聚合的独立核对来源。&#xa;fields:&#xa;finance_item_sales_monthly_id uuid NN — 一条月单品销售稳定主键。&#xa;finance_import_batch_id uuid NN — 产生事实的导入批次。&#xa;location_id uuid NN — 销售所属门店。&#xa;product_id uuid NULL — 确认映射后的统一产品；未确认时为空并进入质量队列。&#xa;business_month date NN — 用月份第一日表示的会计月。&#xa;source_item_name text NN — 财务模板原始商品名称。&#xa;quantity numeric(18,4) NN — 财务模板口径月销量。&#xa;source_unit text NULL — 财务模板原样提供的销量单位；模板未提供时为空。&#xa;sales_amount numeric(18,4) NN — 财务模板口径单品销售额。&#xa;currency char(3) NN — 金额币种。&#xa;quality_status text NN — COMPLETE、UNMAPPED_PRODUCT、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_67255090e442458c818a" value="finance_monthly_cost_line&#xa;财务月成本费用行&#xa;grain: 财务批次 × 地点 × 月份 × 成本域 × 类别 × 子类 × 组织或来源一行&#xa;comment: 用统一粒度保存材料、人工、仓运和期间费用，同时保留类别和组织来源。&#xa;fields:&#xa;finance_monthly_cost_line_id uuid NN — 一条财务月成本稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该成本事实的导入批次。&#xa;source_row_ref text NN — 导入文件中的稳定行定位，例如工作表名与原始行号或来源记录号。&#xa;source_row_fingerprint char(64) NN — 按版本化规范对来源行原值计算的 SHA-256。&#xa;location_id uuid NN — 成本归属地点。&#xa;business_month date NN — 月份第一日。&#xa;cost_domain text NN — MATERIAL、LABOR、LOGISTICS、OPERATING_EXPENSE 或 OTHER。&#xa;category_code text NN — 标准成本类别代码。&#xa;subcategory_code text NULL — 更细成本项目；无子类为空。&#xa;organization_code text NULL — 成本模板中的组织、资金来源或用工组织。&#xa;source_label text NULL — 模板原始类别或支付渠道文本。&#xa;accounting_treatment text NN — RAW_SOURCE、RECOGNIZED_EXPENSE、ACCRUAL、REVERSAL 或 EXCLUDED。&#xa;amount numeric(18,4) NN — 该成本行金额。&#xa;currency char(3) NN — 金额币种。&#xa;quality_status text NN — COMPLETE、UNCLASSIFIED、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_93605286b146674fc9e9" value="finance_monthly_metric&#xa;财务月度指标值&#xa;grain: 财务批次 × 地点 × 月份 × 指标代码一行&#xa;comment: 保存财务模板提供的营业利润、净利润、摊销费、储值净额等标准月指标。&#xa;fields:&#xa;finance_monthly_metric_id uuid NN — 一条财务月指标稳定主键。&#xa;finance_import_batch_id uuid NN — 产生指标的导入批次。&#xa;location_id uuid NN — 指标归属地点。&#xa;business_month date NN — 月份第一日。&#xa;metric_code text NN — 财务指标稳定代码。&#xa;metric_name_snapshot text NN — 导入时模板指标名称。&#xa;metric_value numeric(24,8) NN — 该指标月度数值。&#xa;unit text NN — MYR、PERCENT、COUNT 等。&#xa;quality_status text NN — COMPLETE、UNCLASSIFIED、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_a678a6d30089a5955ad1" value="finance_order_logistics_line&#xa;财务物流订货行&#xa;grain: 财务批次 × 来源订货单 × 来源商品行一行&#xa;comment: 保留财务模板中包含订货、付款、发货、到港、交付和入库日期的历史物流行。&#xa;fields:&#xa;finance_order_logistics_line_id uuid NN — 一条历史物流行稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;source_row_ref text NN — 导入文件中的稳定行定位，例如工作表名与原始行号或来源记录号。&#xa;source_row_fingerprint char(64) NN — 按版本化规范对来源行原值计算的 SHA-256。&#xa;location_id uuid NN — 订货服务地点。&#xa;supplier_id uuid NULL — 确认映射的供应商；未知为空。&#xa;material_id uuid NULL — 确认映射的原料；未知为空。&#xa;source_order_no text NN — 财务模板中的订货单编号。&#xa;source_supplier_name text NULL — 财务物流模板中的供应商名称原文。&#xa;source_item_name text NN — 模板原始商品名称。&#xa;source_specification text NULL — 财务物流模板中的商品规格原文。&#xa;source_category text NULL — 财务物流模板中的商品类别原文。&#xa;source_purchase_type text NULL — 财务物流模板 ptype 的原始值。&#xa;order_date date NN — 财务模板认定的下单日期。&#xa;payment_date date NULL — 实际付款日期。&#xa;shipped_date date NULL — 供应商发货日期。&#xa;arrived_port_date date NULL — 跨境采购到港日期。&#xa;delivered_date date NULL — 送达本地地点日期。&#xa;warehoused_date date NULL — 财务模板认定的入库日期。&#xa;quantity numeric(18,4) NULL — 来源订货数量。&#xa;source_unit text NULL — 财务模板原样提供的订货单位；未提供时为空。&#xa;source_volume numeric(18,6) NULL — 财务物流模板 volume 的原始数值；来源为空时保持为空。&#xa;amount numeric(18,4) NULL — 来源订货行金额。&#xa;currency char(3) NN — 金额币种。&#xa;quality_status text NN — COMPLETE、UNMAPPED_SUPPLIER、UNMAPPED_MATERIAL、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_95785b118dc6b898409f" value="finance_period_category_map&#xa;期间费用归类规则&#xa;grain: 来源大类 × 来源子类 × 生效区间一行&#xa;comment: 版本化维护财务来源类别到销售、管理、财务、研发等期间费用口径的映射。&#xa;fields:&#xa;period_category_map_id uuid NN — 一条费用归类稳定主键。&#xa;source_major text NN — 财务模板原始费用大类。&#xa;source_sub text NULL — 财务模板原始费用子类。&#xa;target_category text NN — SELLING、ADMINISTRATIVE、FINANCE、R_AND_D 或 EXCLUDED。&#xa;valid_from date NN — 规则开始生效日期。&#xa;valid_to date NULL — 规则停止生效的日期上界，该日期本身不再适用。&#xa;status text NN — DRAFT、ACTIVE 或 RETIRED。&#xa;approved_by_user_id uuid NULL — 批准归类规则的账号。&#xa;note text NULL — 特殊归类和边界说明。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_fe904844dd0281afab9a" value="finance_sales_daily&#xa;财务日销售事实&#xa;grain: 财务批次 × 地点 × 日期一行&#xa;comment: 保存财务模板口径的门店日销售，保持与 POS 事实独立用于核对。&#xa;fields:&#xa;finance_sales_daily_id uuid NN — 一条财务日销售稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;location_id uuid NN — 销售所属统一门店。&#xa;business_date date NN — 财务表认定的销售日期。&#xa;gross_sales numeric(18,4) NULL — 财务模板口径流水金额；模板未提供时为空。&#xa;discount_amount numeric(18,4) NULL — 财务模板直接提供或由模板明确组成项归一化的折扣金额；模板未提供时为空。&#xa;net_sales numeric(18,4) NULL — 财务模板口径实收或收入；模板未提供时为空。&#xa;order_count integer NULL — 财务来源独立提供的订单或账单数量；来源不含该列时为空。&#xa;currency char(3) NN — 金额币种。&#xa;quality_status text NN — COMPLETE、PARTIAL、UNMAPPED_LOCATION 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_e3fc164719d0a9899aa0" value="finance_supplier_purchase_monthly&#xa;财务供应商月采购&#xa;grain: 财务批次 × 地点 × 月份 × 来源供应商 × 来源物料 × 规格一行&#xa;comment: 保存财务模板按月、供应商、物料和规格聚合的采购数量、单价和金额。&#xa;fields:&#xa;finance_supplier_purchase_monthly_id uuid NN — 一条月采购聚合稳定主键。&#xa;finance_import_batch_id uuid NN — 产生该事实的导入批次。&#xa;source_row_ref text NN — 导入文件中的稳定行定位，例如工作表名与原始行号或来源记录号。&#xa;source_row_fingerprint char(64) NN — 按版本化规范对来源行原值计算的 SHA-256。&#xa;location_id uuid NN — 采购服务地点。&#xa;supplier_id uuid NULL — 确认映射的供应商；未知为空。&#xa;material_id uuid NULL — 确认映射的原料；未知为空。&#xa;business_month date NN — 月份第一日。&#xa;source_supplier_name text NN — 财务模板原始供应商名称。&#xa;source_item_name text NN — 财务模板原始物料名称。&#xa;specification text NULL — 模板原始规格。&#xa;quantity numeric(18,6) NN — 模板口径月采购数量。&#xa;source_unit text NULL — 模板原样提供的采购单位；未提供时为空。&#xa;unit_price numeric(18,6) NN — 模板口径单价。&#xa;amount numeric(18,4) NN — 模板口径月采购金额。&#xa;currency char(3) NN — 金额币种。&#xa;quality_status text NN — COMPLETE、UNMAPPED_SUPPLIER、UNMAPPED_MATERIAL、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="2960" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_6d9e254f87bd04dfba48" value="finance_target&#xa;财务经营目标&#xa;grain: 地点 × 月份 × 指标代码 × 版本一行&#xa;comment: 保存地点、月份和指标的目标值及版本。&#xa;fields:&#xa;finance_target_id uuid NN — 一版财务目标稳定主键。&#xa;location_id uuid NULL — 目标适用地点；公司总目标为空。&#xa;business_month date NN — 月份第一日。&#xa;metric_code text NN — REVENUE、GROSS_MARGIN、LABOR_COST_RATE 等标准指标。&#xa;version_no integer NN — 同地点、月份、指标内递增版本。&#xa;target_value numeric(24,8) NN — 目标数值。&#xa;unit text NN — MYR、PERCENT、COUNT 等。&#xa;status text NN — DRAFT、APPROVED、ACTIVE 或 SUPERSEDED。&#xa;approved_by_user_id uuid NULL — 批准目标的账号。&#xa;approved_at timestamptz NULL — 目标批准时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ad16f1bd4b9975af8649" value="hr_application&#xa;候选申请&#xa;grain: 人员 × 招聘需求 × 一次申请一行&#xa;comment: 记录自然人对一个招聘需求的一次申请身份和来源；阶段变化只追加到 hr_application_stage_event。&#xa;fields:&#xa;application_id uuid NN — 一次候选申请稳定主键。&#xa;person_id uuid NN — 申请人自然人身份。&#xa;job_requisition_id uuid NN — 申请对应正式需求。&#xa;source_system_id uuid NN — 提供申请的招聘渠道。&#xa;source_application_id text NULL — 招聘平台或来源中的稳定申请编号。&#xa;applied_at timestamptz NN — 候选人提交或被录入的时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_69c0e9794896d384d6ea" value="hr_application_stage_event&#xa;候选申请阶段事件&#xa;grain: 候选申请 × 一次阶段迁移一行&#xa;comment: 只追加保存候选申请每次进入新阶段的时间、原因、来源和操作者，使漏斗和停留时长可以重建。&#xa;fields:&#xa;application_stage_event_id uuid NN — 一次阶段迁移稳定主键。&#xa;application_id uuid NN — 阶段变化所属候选申请。&#xa;source_system_id uuid NULL — 阶段回执来自外部招聘平台时记录；内部人工动作可为空。&#xa;job_run_id uuid NULL — 自动同步或规则推进阶段时连接具体任务运行。&#xa;actor_user_id uuid NULL — 人工确认阶段变化的应用账号；外部自动回执可为空。&#xa;event_key text NN — 写入方为本次业务迁移生成的全局唯一稳定键。&#xa;from_stage text NULL — 迁移前阶段；申请建立时的首个 NEW 事件可为空。&#xa;to_stage text NN — NEW、CONTACTING、INTERVIEW、TRIAL、OFFER、HIRED、REJECTED、WITHDRAWN 或 TALENT_POOL。&#xa;reason_code text NULL — 拒绝、退出、停滞或人工推进的标准原因代码。&#xa;occurred_at timestamptz NN — 候选申请实际进入新阶段的时间。&#xa;evidence jsonb NN — 不含非必要敏感信息的渠道回执、预约或审批引用。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_05468a81e16798d6af63" value="hr_appointment&#xa;面试试工预约&#xa;grain: 申请 × 一次预约一行&#xa;comment: 记录候选人面试、试工或文件办理的一次预约及其实际执行结果；试工不再另建一对一结果表。&#xa;fields:&#xa;appointment_id uuid NN — 一次预约稳定主键。&#xa;application_id uuid NN — 预约所属申请。&#xa;location_id uuid NULL — 预约发生地点；线上预约可为空。&#xa;appointment_type text NN — INTERVIEW、TRIAL、DOCUMENT 或 OTHER。&#xa;scheduled_start timestamptz NN — 预约开始时间。&#xa;scheduled_end timestamptz NULL — 预约结束时间。&#xa;status text NN — PROPOSED、CONFIRMED、COMPLETED、NO_SHOW、STOPPED、CANCELLED 或 RESCHEDULED。&#xa;confirmed_at timestamptz NULL — 候选人或HR确认时间。&#xa;confirmed_by_user_id uuid NULL — 内部确认该预约的账号。&#xa;actual_start timestamptz NULL — 候选人实际到场开始时间；尚未开始为空。&#xa;actual_end timestamptz NULL — 预约或试工实际结束时间。&#xa;trial_outcome text NULL — 仅 TRIAL 类型使用：PASS、CONDITIONAL_PASS、FAIL 或 INCOMPLETE。&#xa;safety_incident boolean NN — TRIAL 类型期间是否发生安全或重大红线。&#xa;execution_note text NULL — 实际到场、异常或试工结论的必要补充。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_06aca0e147329340e092" value="hr_assessment&#xa;候选人评估&#xa;grain: 申请 × 评估类型 × 一次评估一行&#xa;comment: 保存一次结构化评估的建议、红线结论、评估者和模板版本；总分由明细视图派生。&#xa;fields:&#xa;assessment_id uuid NN — 一次候选评估稳定主键。&#xa;application_id uuid NN — 被评估候选申请。&#xa;appointment_id uuid NULL — 对应面试/试工预约；无预约评估可为空。&#xa;assessor_employment_id uuid NN — 执行评估的员工。&#xa;assessment_type text NN — SCREENING、INTERVIEW、TRIAL、KPA 或 OTHER。&#xa;template_version text NN — 本次使用的评分项模板版本。&#xa;recommendation text NN — STRONG_HIRE、HIRE、HOLD、NO_HIRE 或 INCOMPLETE。&#xa;red_flag boolean NN — 是否存在必须人工处理的红线项。&#xa;summary text NULL — 评估者的必要总结。&#xa;assessed_at timestamptz NN — 评估完成时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_083bd74053995bdc0845" value="hr_assessment_score&#xa;评估项目得分&#xa;grain: 评估 × 评分项目一行&#xa;comment: 逐项保存评分、权重、红线和证据，避免只有总分无法解释。&#xa;fields:&#xa;assessment_score_id uuid NN — 一条评分项目稳定主键。&#xa;assessment_id uuid NN — 所属候选评估。&#xa;criterion_code text NN — 模板内稳定评分项代码。&#xa;criterion_name text NN — 评估时的评分项名称快照。&#xa;score numeric(9,4) NULL — 该评分项实际得分。&#xa;max_score numeric(9,4) NN — 该项可得最高分。&#xa;weight numeric(9,6) NN — 该项进入总分的权重。&#xa;is_red_flag boolean NN — 该项是否触发红线。&#xa;evidence_note text NULL — 支持该分数的具体观察。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_fc832b7934c3708c0e80" value="hr_employee_event&#xa;员工事件&#xa;grain: 雇佣关系 × 一次事件一行&#xa;comment: 记录转正、调动、停职、奖惩、离职等不可变人事事件。&#xa;fields:&#xa;employee_event_id uuid NN — 一次人事事件稳定主键。&#xa;employment_id uuid NN — 事件所属雇佣关系。&#xa;event_type text NN — CONFIRMATION、TRANSFER、PROMOTION、DISCIPLINE、SUSPENSION、RESIGNATION、TERMINATION 或 OTHER。&#xa;effective_date date NN — 事件业务生效日期。&#xa;from_location_id uuid NULL — 调动前地点；不适用为空。&#xa;to_location_id uuid NULL — 调动后地点；不适用为空。&#xa;event_schema_version text NN — event_data 对应的事件类型结构版本。&#xa;event_data jsonb NN — 按事件类型保存批准后的非通用字段。&#xa;reason_code text NULL — 离职、处分等标准原因。&#xa;note text NULL — 必要的受限说明。&#xa;recorded_by_user_id uuid NN — 确认并登记该不可变人事事件的应用账号。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="3690" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_9e1df160d097ad209679" value="hr_employment&#xa;雇佣关系&#xa;grain: 一个人从一次入职到一次离职的雇佣关系一行&#xa;comment: 把自然人与一次具体雇佣关系分开，支持离职后再次入职和跨地点调动。&#xa;fields:&#xa;employment_id uuid NN — 连接培训、班表、工时、员工事件和人工成本的稳定身份。&#xa;person_id uuid NN — 这段雇佣关系对应的自然人。&#xa;origin_application_id uuid NULL — 该雇佣由某次候选申请转化时连接申请；导入、再入职或无招聘流程时为空。&#xa;home_location_id uuid NULL — 当前合同或组织归属的主要地点。&#xa;employee_code text NN — 企业内部员工编号。&#xa;employment_type text NN — FULL_TIME、PART_TIME、CONTRACTOR、INTERN 或 CASUAL。&#xa;started_on date NN — 本段雇佣关系开始日期。&#xa;ended_on date NULL — 本段雇佣关系结束日期；在职为空。&#xa;status text NN — PLANNED、ACTIVE、SUSPENDED、ENDED 或 CANCELLED。&#xa;job_title text NULL — 合同或组织中的职位名称。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_01e76364608bbc8a8f44" value="hr_employment_mapping_review&#xa;雇佣身份映射审核&#xa;grain: 来源系统 × 外部员工ID × 一次审核尝试一行&#xa;comment: 保存 Lark、工资表和历史员工来源无法自动确认到 employment_id 时的候选、证据和人工结论。&#xa;fields:&#xa;employment_mapping_review_id uuid NN — 一次雇佣身份审核的稳定主键。&#xa;source_system_id uuid NN — 提供外部员工身份的来源系统。&#xa;source_employee_id text NN — 来源中的原始员工标识。&#xa;candidate_person_id uuid NULL — 算法或人工认为可能匹配的自然人；没有候选时为空。&#xa;candidate_employment_id uuid NULL — 算法或人工认为可能匹配的具体雇佣关系；没有候选时为空。&#xa;match_method text NN — EXACT_EMPLOYEE_CODE、SOURCE_LINK、MULTI_ATTRIBUTE 或 NO_CANDIDATE。&#xa;evidence jsonb NN — 员工编号、入职日、地点等最小化且脱敏的匹配证据。&#xa;status text NN — OPEN、CONFIRMED、REJECTED、SPLIT_REQUIRED 或 DISMISSED。&#xa;confirmed_source_identity_id uuid NULL — 审核确认后建立的正式雇佣来源映射；未确认时为空。&#xa;resolution_note text NULL — 确认、拒绝或拆分身份的业务理由。&#xa;reviewed_by_user_id uuid NULL — 作出当前审核结论的应用账号。&#xa;reviewed_at timestamptz NULL — 进入终态的时间；未处理时为空。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_a26152324e5ee70d9d3d" value="hr_employment_source_identity&#xa;雇佣来源身份映射&#xa;grain: 来源系统 × 外部员工ID × 有效期一行&#xa;comment: 把 Lark、工资表和历史员工表中的员工编号映射到 employment_id。&#xa;fields:&#xa;employment_source_identity_id uuid NN — 一条员工来源映射稳定主键。&#xa;employment_id uuid NN — 映射后的统一雇佣关系。&#xa;source_system_id uuid NN — 提供外部员工编号的来源系统。&#xa;source_employee_id text NN — 来源系统的原始员工标识。&#xa;valid_from timestamptz NN — 映射开始有效时间。&#xa;valid_to timestamptz NULL — 映射停止有效时间。&#xa;mapping_status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;evidence jsonb NN — 员工编号、入职日期等脱敏核对证据。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_36f309fd97196b554051" value="hr_job_requisition&#xa;招聘需求&#xa;grain: 一个招聘需求一行&#xa;comment: 记录某地点、岗位所需人数、期限和批准状态，作为候选申请的业务来源。&#xa;fields:&#xa;job_requisition_id uuid NN — 招聘需求稳定主键。&#xa;location_id uuid NN — 需求所属地点。&#xa;role_id uuid NULL — 计划招聘的标准岗位。&#xa;requisition_code text NN — 业务可读唯一需求编号。&#xa;headcount_requested integer NN — 批准前提出的招聘人数。&#xa;employment_type text NN — FULL_TIME、PART_TIME、CONTRACTOR、INTERN 或 CASUAL。&#xa;target_start_date date NULL — 希望新员工开始工作的日期。&#xa;status text NN — DRAFT、APPROVED、OPEN、ON_HOLD、FILLED 或 CANCELLED。&#xa;approved_at timestamptz NULL — 招聘需求获批时间。&#xa;approved_by_user_id uuid NULL — 批准需求的账号。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_5ddc68a09ea9f9e896e8" value="hr_offer&#xa;Offer版本&#xa;grain: 申请 × Offer版本一行&#xa;comment: 版本化保存候选人的岗位、地点、薪酬摘要、有效期和接受状态。&#xa;fields:&#xa;offer_id uuid NN — 一版 Offer 稳定主键。&#xa;application_id uuid NN — Offer 对应候选申请。&#xa;supersedes_offer_id uuid NULL — 本版替代的上一版 Offer。&#xa;location_id uuid NN — Offer 主要工作地点。&#xa;role_id uuid NULL — Offer 标准岗位。&#xa;version_no integer NN — 申请内 Offer 递增版本。&#xa;employment_type text NN — 拟议用工类型。&#xa;proposed_start_date date NN — Offer 中拟定的开始日期。&#xa;compensation_schema_version text NN — compensation_summary 对应的固定 JSON Schema 版本。&#xa;compensation_summary jsonb NN — 按 compensation_schema_version 校验的结构化薪酬项目和币种；未知键拒绝且仅授权人员可见。&#xa;expires_at timestamptz NULL — 候选人最迟接受时间。&#xa;status text NN — DRAFT、SENT、ACCEPTED、DECLINED、EXPIRED、WITHDRAWN 或 SUPERSEDED。&#xa;responded_at timestamptz NULL — 接受或拒绝时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_604fa1b122e01c05b4d8" value="hr_person&#xa;自然人主数据&#xa;grain: 每个自然人一行&#xa;comment: 为候选人和员工提供不随雇佣关系变化的稳定 person_id。&#xa;fields:&#xa;person_id uuid NN — 自然人的稳定身份；一人多次应聘或入职仍使用同一 ID。&#xa;display_name text NN — 日常业务界面使用的姓名。&#xa;legal_name text NULL — 合同或合规文件使用的姓名。&#xa;preferred_name text NULL — 本人希望在排班和内部沟通显示的名字。&#xa;dedupe_fingerprint char(64) NULL — 由受控身份要素生成的不可逆去重哈希。&#xa;status text NN — ACTIVE、MERGED、DECEASED 或 RESTRICTED。&#xa;merged_into_person_id uuid NULL — 重复身份合并后指向保留的 person_id。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_27edc16238e59585dbd2" value="hr_person_contact&#xa;人员联系方式&#xa;grain: 人员 × 联系方式类型 × 有效期一行&#xa;comment: 把电话和邮箱等联系方式从一般人员主档隔离，便于最小权限和历史管理。&#xa;fields:&#xa;person_contact_id uuid NN — 一条联系方式稳定主键。&#xa;person_id uuid NN — 联系方式所属自然人。&#xa;contact_type text NN — PHONE、EMAIL 或 OTHER。&#xa;contact_ciphertext bytea NN — 由应用层加密后的电话或邮箱。&#xa;lookup_hash char(64) NN — 标准化联系方式的带密钥哈希。&#xa;is_primary boolean NN — 是否为当前首选联系方式。&#xa;verified_at timestamptz NULL — 通过验证码或人工核验的时间。&#xa;valid_from timestamptz NN — 联系方式开始有效时间。&#xa;valid_to timestamptz NULL — 联系方式停止使用时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="4420" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ffc7d870421fcadf3ffa" value="hr_screening_rule&#xa;招聘筛选规则&#xa;grain: 一个规则版本一行&#xa;comment: 保存经人工批准、带证据和适用范围的招聘筛选规则。&#xa;fields:&#xa;screening_rule_id uuid NN — 一版筛选规则稳定主键。&#xa;rule_code text NN — 稳定规则标识。&#xa;version_no integer NN — 规则代码内递增版本。&#xa;role_id uuid NULL — 规则只适用某岗位时记录。&#xa;rule_type text NN — ELIGIBILITY、RISK_SIGNAL 或 QUESTION_PROMPT。&#xa;rule_schema_version text NN — rule_definition 对应的固定 JSON Schema 版本。&#xa;rule_definition jsonb NN — 按 rule_type + rule_schema_version 校验的条件和输出；未知键及受保护歧视字段拒绝。&#xa;evidence_summary text NN — 规则依据、样本和限制。&#xa;sample_size integer NULL — 提炼规则使用的样本数。&#xa;confidence numeric(5,4) NULL — 规则证据的 0 至 1 评分。&#xa;status text NN — DRAFT、APPROVED、ACTIVE 或 RETIRED。&#xa;approved_by_user_id uuid NULL — 人工批准规则的账号。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_38e10284fb194b9412da" value="mkt_campaign_member&#xa;活动会员参与&#xa;grain: 活动版本 × 会员一行&#xa;comment: 记录会员在某活动版本中的资格、邀请、开始、完成和取消历史，不再把活动状态覆盖在 pos_member 当前快照上。&#xa;fields:&#xa;campaign_member_id uuid NN — 一次会员活动参与稳定身份。&#xa;campaign_version_id uuid NN — 会员参与的具体活动版本。&#xa;member_id uuid NN — 参与活动的 POS 会员。&#xa;eligibility_status text NN — ELIGIBLE、INELIGIBLE、PENDING 或 OVERRIDDEN。&#xa;eligibility_evidence jsonb NN — 资格规则结果和输入快照。&#xa;invited_at timestamptz NULL — 首次发送活动邀请时间。&#xa;started_at timestamptz NULL — 会员首次进入并开始活动的时间。&#xa;completed_at timestamptz NULL — 满足活动完成条件的时间。&#xa;status text NN — INVITED、STARTED、COMPLETED、EXPIRED、CANCELLED 或 BLOCKED。&#xa;completion_version text NULL — 判定完成时使用的服务或规则版本。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_dc3b4bc799ddafa01fd5" value="mkt_campaign_version&#xa;营销活动版本&#xa;grain: 活动代码 × 版本号一行&#xa;comment: 一行冻结一个活动代码版本的名称、类型、时间窗、适用地点、参与规则、问卷算法和奖励政策；不再为只有版本表引用的活动另建主档。&#xa;fields:&#xa;campaign_version_id uuid NN — 一版活动稳定身份。&#xa;campaign_code text NN — 跨版本稳定且不可复用的活动代码。&#xa;campaign_name text NN — 本版本发布时展示的活动名称。&#xa;campaign_type text NN — SURVEY、PROMOTION、LOYALTY、COUPON 或 OTHER。&#xa;location_id uuid NULL — 活动只适用某地点时填写；全企业活动为空。&#xa;version_no integer NN — 活动内递增版本。&#xa;starts_at timestamptz NULL — 活动版本允许参与的开始时间；只有无法证明开始时点的历史归档版本可为空。&#xa;ends_at timestamptz NULL — 活动版本停止接受新参与的时间。&#xa;rule_schema_version text NN — audience_rule、participation_rule 和 reward_rule 共用的固定 JSON Schema 版本。&#xa;audience_rule jsonb NN — 按 rule_schema_version 校验的会员状态、地点或邀请条件；未知键拒绝。&#xa;participation_rule jsonb NN — 按 rule_schema_version 校验的次数限制、完成条件和重复参与政策；未知键拒绝。&#xa;result_algorithm_version text NULL — 本活动版本正式采用的答案到 result_code 算法版本；非测评活动可为空。&#xa;result_schema_version text NULL — result_dimensions 和展示字段遵循的结构版本；非测评活动可为空。&#xa;reward_rule jsonb NN — 按 rule_schema_version 校验的奖励选择和库存扣减规则；未知键拒绝。&#xa;status text NN — DRAFT、APPROVED、PUBLISHED、PAUSED、COMPLETED、ARCHIVED、SUPERSEDED 或 CANCELLED。&#xa;approved_by_user_id uuid NULL — 批准该活动版本的账号。&#xa;approved_at timestamptz NULL — 活动版本获批时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_356fa9fb48de3a66885c" value="mkt_reward&#xa;活动奖励主数据&#xa;grain: 一个可发放奖励一行&#xa;comment: 维护礼品、优惠券或权益的稳定身份。&#xa;fields:&#xa;reward_id uuid NN — 奖励稳定身份。&#xa;reward_code text NN — 企业内部唯一奖励代码。&#xa;reward_name text NN — 当前显示名称。&#xa;reward_type text NN — PHYSICAL_GIFT、COUPON、POINTS 或 BENEFIT。&#xa;product_id uuid NULL — 奖励本身是企业产品时关联。&#xa;status text NN — ACTIVE、SUSPENDED 或 RETIRED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_147753737fbbde664754" value="mkt_reward_claim&#xa;活动奖励领取&#xa;grain: 活动会员 × 一次奖励领取一行&#xa;comment: 记录会员选择、预留、发放、到期或取消一份奖励的完整状态。&#xa;fields:&#xa;reward_claim_id uuid NN — 一次奖励领取稳定主键。&#xa;campaign_member_id uuid NN — 领取奖励的会员参与。&#xa;reward_stock_id uuid NULL — 本次领取确实来自目标活动库存时填写；外部独立发券且没有可证明库存行时为空。&#xa;reward_id uuid NN — 本次领取或外部履约的直接奖励身份。&#xa;survey_result_id uuid NULL — 奖励由具体问卷结果触发或选择时记录；与结果无关的活动可为空。&#xa;idempotency_key char(64) NN — 按活动参与、奖励、触发结果或客户端请求号规范化计算的 SHA-256。&#xa;quantity integer NN — 本次领取数量。&#xa;status text NN — RESERVED、REDEEMED、EXPIRED、CANCELLED 或 REJECTED；REDEEMED 只表示奖励履约完成，数字券已发放，不证明会员已在 POS 消费。&#xa;reserved_at timestamptz NULL — 来源明确保存库存成功预留时间时填写；外部来源没有真实预留时刻时为空。&#xa;expires_at timestamptz NULL — 未核销预留自动释放时间。&#xa;redeemed_at timestamptz NULL — 现场实物发放或数字权益/新券实例成功发出的时间；RES confirmedAt 迁入这里。&#xa;redeemed_by_user_id uuid NULL — 现场确认发放的账号。&#xa;source_system_id uuid NULL — 外部系统完成奖励履约时标明 source_fulfillment_id 所属命名空间；内部库存领取可为空。&#xa;source_fulfillment_id text NULL — 外部奖励履约或新券实例的来源内稳定ID，例如 RES newCouponId；绝不表示 POS 消费或券核销。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_27efe5dcf8cb79b89286" value="mkt_reward_stock&#xa;活动奖励库存&#xa;grain: 活动版本 × 地点 × 奖励一行&#xa;comment: 保存活动版本、地点和奖励的可用、预留和已发数量。&#xa;fields:&#xa;reward_stock_id uuid NN — 一条活动奖励库存稳定主键。&#xa;campaign_version_id uuid NN — 库存分配给的活动版本。&#xa;location_id uuid NULL — 奖励可领取地点；数字权益可为空。&#xa;reward_id uuid NN — 库存对应奖励。&#xa;allocated_quantity integer NN — 活动版本最初或追加分配的总数量。&#xa;unit_cost_estimate numeric(18,4) NULL — 本活动版本和地点分配奖励时批准的单位预算成本。&#xa;currency char(3) NULL — 本次分配单位成本估算的 ISO 4217 币种；没有单位成本证据时为空。&#xa;reserved_quantity integer NN — 已被会员选择但尚未发放的数量。&#xa;redeemed_quantity integer NN — 已完成发放的数量。&#xa;damaged_quantity integer NN — 不可发放的损坏或调整数量。&#xa;version_no integer NN — 每次原子库存变更递增的乐观锁版本。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_630f9cac18a30e9a9102" value="mkt_survey_answer&#xa;问卷题目答案&#xa;grain: 作答 × 题目 × 原子答案值一行&#xa;comment: 逐个原子值保存选项、评分、布尔或文本答案；多选题每个被选选项各占一行，不把多个外键塞进数组。&#xa;fields:&#xa;survey_answer_id uuid NN — 一个原子答案值的稳定主键。&#xa;survey_response_id uuid NN — 所属问卷作答。&#xa;survey_question_id uuid NN — 被回答的具体版本题目。&#xa;value_index integer NN — 同一次作答同一题内从 1 递增的原子值序号；单值题固定为 1。&#xa;selected_option_id uuid NULL — 单选或多选题本行选择的一个选项。&#xa;rating_value numeric(9,4) NULL — 评分题的数值答案。&#xa;boolean_value boolean NULL — 是非题答案。&#xa;text_value text NULL — 开放题回答；必须经过内容和 PII 策略。&#xa;answered_at timestamptz NN — 该题答案最后确认时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="5150" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_819287b3bb35c970af71" value="mkt_survey_question&#xa;问卷题目&#xa;grain: 活动版本 × 题目代码一行&#xa;comment: 版本化保存活动问卷题目、类型、顺序和必答规则。&#xa;fields:&#xa;survey_question_id uuid NN — 一条活动版本题目稳定身份。&#xa;campaign_version_id uuid NN — 题目所属具体活动版本。&#xa;question_code text NN — 活动内稳定题目代码。&#xa;question_text text NN — 发布时展示的题目文本。&#xa;question_type text NN — SINGLE_CHOICE、MULTIPLE_CHOICE、RATING、TEXT 或 BOOLEAN。&#xa;sequence_no integer NN — 问卷中的展示顺序。&#xa;is_required boolean NN — 完成问卷是否必须回答该题。&#xa;validation_schema_version text NN — validation_rule 对应的固定 JSON Schema 版本。&#xa;validation_rule jsonb NN — 按 question_type + validation_schema_version 校验的分值范围、最大选择数或文本长度；未知键拒绝。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_9cf41afd135c238fe5c5" value="mkt_survey_question_option&#xa;问卷选项&#xa;grain: 题目 × 选项代码一行&#xa;comment: 保存选择题选项代码、文本、顺序和可选分析标签。&#xa;fields:&#xa;survey_question_option_id uuid NN — 一条题目选项稳定身份。&#xa;survey_question_id uuid NN — 选项所属题目。&#xa;option_code text NN — 题目内稳定选项代码。&#xa;option_text text NN — 会员看到的选项文本。&#xa;sequence_no integer NN — 题目内展示顺序。&#xa;analysis_tags text[] NN — 批准的产品偏好或分群标签。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ee6dc31fdbb13c62675b" value="mkt_survey_response&#xa;问卷作答&#xa;grain: 活动会员 × 尝试次数一行&#xa;comment: 保存会员对某活动版本的一次完整、部分或仅有历史结果锚点的问卷尝试。&#xa;fields:&#xa;survey_response_id uuid NN — 一次问卷尝试稳定身份。&#xa;campaign_member_id uuid NN — 作答所属会员参与。&#xa;source_system_id uuid NN — 外部作答ID所属的来源命名空间；纯内部首次作答也登记 HBTI 应用来源。&#xa;source_response_id text NN — 真实作答保存来源 attempt_id；只有历史 result-only 迁移允许保存 migration-only:&lt;typed-JCS UUIDv5&gt; 锚点，并在迁移清单标明它不是来源观察。&#xa;attempt_no integer NULL — 真实来源作答在同一参与中的正整数尝试序号；只有没有来源作答事实的 result-only 历史迁移锚点为空。&#xa;started_at timestamptz NULL — 本次作答开始时间；历史终态记录未保存开始时点时可为空。&#xa;submitted_at timestamptz NULL — 会员提交本次答案的时间。&#xa;status text NN — IN_PROGRESS、SUBMITTED、VALIDATED、REJECTED 或 ABANDONED。&#xa;validation_result jsonb NN — 必答题、选项和重复提交检查。&#xa;client_context jsonb NN — 非敏感的应用版本、语言和流程版本。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_39294bb19863acee215d" value="mkt_survey_result&#xa;问卷测评结果&#xa;grain: 问卷作答 × 结果类型 × 算法版本一行&#xa;comment: 保存一次问卷作答锚点经具体算法版本计算或由历史来源迁入的 HBTI 类型及其他测评结果；历史结果可能缺少原答案，不能冒充可复算。&#xa;fields:&#xa;survey_result_id uuid NN — 一次问卷测评结果稳定主键。&#xa;survey_response_id uuid NN — 产生该结果或承接历史结果的问卷作答锚点；不自动证明答案完整。&#xa;result_type text NN — HBTI_PROFILE 或未来批准的其他测评类型。&#xa;result_code text NN — 算法输出的稳定类别代码；现有 hbti_code 迁入此列。&#xa;result_label text NULL — 计算时面向用户显示的结果名称快照。&#xa;result_color text NULL — 计算时使用的颜色代码或名称快照。&#xa;algorithm_version text NN — 将答案转换为 result_code 的批准算法版本。&#xa;input_sha256 char(64) NULL — 按固定顺序规范化真实答案后的 SHA-256；历史来源没有答案时为空。&#xa;result_dimensions jsonb NN — 算法输出的分数、维度或解释标签。&#xa;quality_status text NN — VALID、INCOMPLETE_INPUT、ALGORITHM_ERROR 或 REJECTED。&#xa;calculated_at timestamptz NN — 该算法完成结果计算的绝对时间。&#xa;source_system_id uuid NULL — 迁移既有结果时标明旧结果ID所属命名空间；本系统新计算结果为空。&#xa;source_result_id text NULL — 迁移现有 HBTI 结果时保存旧记录稳定标识；新结果可为空。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_737cb9c7f210c20557c6" value="msg_conversation&#xa;消息会话&#xa;grain: 一个渠道会话一行&#xa;comment: 统一表示内部助手、候选人 WhatsApp 或会员活动的一段会话，并用类型化外键连接业务对象。&#xa;fields:&#xa;conversation_id uuid NN — 跨消息和状态稳定的会话身份。&#xa;channel_code text NN — WHATSAPP、WEB_CHAT、LARK 或 OTHER。&#xa;external_conversation_id text NULL — 渠道提供的稳定会话或号码哈希标识。&#xa;application_id uuid NULL — 招聘会话对应申请；不适用为空。&#xa;person_id uuid NULL — 内部或候选人会话对应自然人；不适用为空。&#xa;member_id uuid NULL — 会员活动会话对应会员；不适用为空。&#xa;app_user_id uuid NULL — 内部用户助手会话对应账号；不适用为空。&#xa;status text NN — OPEN、WAITING_USER、WAITING_AGENT、CLOSED、OPTED_OUT 或 BLOCKED。&#xa;opened_at timestamptz NN — 会话首次创建时间。&#xa;closed_at timestamptz NULL — 会话结束时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_17efa0b0c6e2b68db810" value="msg_conversation_state&#xa;会话流程状态&#xa;grain: 会话 × 工作流代码一行&#xa;comment: 保存招聘或助手多轮流程的当前节点、已收集参数和到期时间；完成后仍保留最终状态摘要。&#xa;fields:&#xa;conversation_state_id uuid NN — 一条会话工作流状态稳定主键。&#xa;conversation_id uuid NN — 状态所属会话。&#xa;workflow_code text NN — RECRUITMENT、DAILY_REVIEW、ORDERING 等稳定流程代码。&#xa;workflow_version text NN — 状态机结构版本。&#xa;state_code text NN — 工作流内当前节点代码。&#xa;collected_data jsonb NN — 已通过 schema 校验的非敏感或受限参数。&#xa;pending_action jsonb NULL — 需要用户确认后才执行的结构化动作。&#xa;expires_at timestamptz NULL — 无活动时状态自动失效时间。&#xa;status text NN — ACTIVE、COMPLETED、EXPIRED、CANCELLED 或 ERROR。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_3e5b0ae5be4ac5fb399c" value="msg_delivery_attempt&#xa;消息投递尝试&#xa;grain: 外发消息 × 一次发送尝试一行&#xa;comment: 只追加记录外发消息每次调用渠道、结果、外部消息ID和脱敏错误。&#xa;fields:&#xa;delivery_attempt_id uuid NN — 一次发送尝试稳定主键。&#xa;outbound_message_id uuid NN — 所属队列消息。&#xa;attempt_no integer NN — 消息内从1递增的尝试次数。&#xa;started_at timestamptz NN — 调用渠道开始时间。&#xa;finished_at timestamptz NULL — 渠道调用结束时间。&#xa;result text NN — SENT、RETRYABLE_FAILURE、PERMANENT_FAILURE 或 UNKNOWN。&#xa;external_message_id text NULL — 渠道成功返回的消息标识。&#xa;http_status integer NULL — 渠道 API HTTP 状态码。&#xa;error_code text NULL — 渠道或适配器标准错误代码。&#xa;error_detail text NULL — 经过脱敏的错误信息。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="5880" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4aff02eda0538dda2cc6" value="msg_message&#xa;会话消息&#xa;grain: 会话 × 一条消息一行&#xa;comment: 只追加保存会话中的入站、出站和系统消息及经过审核的正文。&#xa;fields:&#xa;message_id uuid NN — 一条消息稳定主键。&#xa;conversation_id uuid NN — 消息所属会话。&#xa;outbound_message_id uuid NULL — 该消息由队列发送时连接原外发任务；入站或系统消息为空。&#xa;external_message_id text NULL — 渠道提供的稳定消息ID。&#xa;direction text NN — INBOUND、OUTBOUND 或 SYSTEM。&#xa;sender_type text NN — PERSON、MEMBER、APP_USER、SERVICE 或 CHANNEL。&#xa;content_type text NN — TEXT、IMAGE、FILE、AUDIO、TEMPLATE 或 EVENT。&#xa;content_text text NULL — 经过保留政策和必要脱敏的文本内容。&#xa;content_ref text NULL — 受控对象存储中的媒体或文件引用。&#xa;occurred_at timestamptz NN — 渠道认定的发送或接收时间。&#xa;acceptance_status text NN — RECEIVED、QUEUED、SENT、FAILED 或 REJECTED。&#xa;metadata jsonb NN — 模板代码、语言和不含秘密的渠道属性。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_c0d059705b460fae6908" value="msg_outbound_message&#xa;外发消息队列&#xa;grain: 一次计划外发消息一行&#xa;comment: 保存待发送消息、业务推送自然键、最早发送时间、幂等键和队列状态；投递次数、最后错误和成功去重结论从投递事实派生。&#xa;fields:&#xa;outbound_message_id uuid NN — 一次外发任务稳定主键。&#xa;conversation_id uuid NULL — 消息所属会话；一次性广播可为空并由 recipient_ref 指定。&#xa;job_run_id uuid NULL — 由定时或批处理任务产生时连接具体运行。&#xa;review_action_id uuid NULL — 消息用于推动某项复盘改进行动时连接该行动。&#xa;ai_call_id uuid NULL — 消息内容由某次 AI 调用建议或生成时连接该调用。&#xa;appointment_id uuid NULL — 招聘面试或试工提醒连接具体预约。&#xa;campaign_member_id uuid NULL — 营销或 HBTI 通知连接具体会员活动参与。&#xa;queued_by_user_id uuid NULL — 人工创建消息时记录操作账号；系统任务可为空并使用 job_run_id。&#xa;channel_code text NN — WHATSAPP、LARK、EMAIL 或 OTHER。&#xa;recipient_ref text NN — 受控联系方式ID、渠道用户ID或哈希引用，不保存散落明文手机号。&#xa;push_kind text NULL — MORNING_BRIEF、PRODUCTION_PLAN、ORDER_REMINDER 等稳定代码；非按日业务推送为空。&#xa;business_date date NULL — 该业务推送针对的营业或日历日期；非按日消息为空。&#xa;template_code text NULL — 批准模板代码；自由文本消息可为空。&#xa;template_version integer NULL — payload 校验与渲染采用的批准模板版本；自由文本消息为空。&#xa;payload jsonb NN — 通过模板 schema 校验的参数。&#xa;idempotency_key text NN — 业务生成的唯一去重键。&#xa;earliest_send_at timestamptz NN — 消息允许发送的最早时间。&#xa;expires_at timestamptz NULL — 超过此时间不再发送。&#xa;priority smallint NN — 数字越小优先级越高。&#xa;status text NN — QUEUED、PROCESSING、SENT、FAILED、CANCELLED 或 EXPIRED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ccbb6d55fd78d740db84" value="ops_business_rule&#xa;运营业务规则&#xa;grain: 适用地点/产品组合或企业全局 × 规则代码 × 版本一行&#xa;comment: 版本化保存企业级、地点级、产品级或地点产品级的排产阈值、产品策略、招聘可预约窗口和断货排除等低频配置。&#xa;fields:&#xa;business_rule_id uuid NN — 一版业务规则稳定主键。&#xa;scope_location_id uuid NULL — 规则只适用于某门店、厨房或仓库时填写；企业全局规则为空。&#xa;scope_product_id uuid NULL — 规则只适用于某企业产品时填写；非产品规则或全产品规则为空。&#xa;rule_code text NN — 程序读取的稳定规则名称。&#xa;version_no integer NN — 规则代码内递增版本。&#xa;rule_value jsonb NN — 符合 schema_version 所指固定 JSON Schema 的结构化规则内容；不接受未登记键。&#xa;schema_version text NN — rule_value 的 JSON Schema 版本。&#xa;valid_from timestamptz NN — 规则开始用于新计算的时间。&#xa;valid_to timestamptz NULL — 规则停止生效时间。&#xa;status text NN — DRAFT、APPROVED、ACTIVE 或 RETIRED。&#xa;approved_by_user_id uuid NULL — 批准规则的账号。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_d5c8da53eda5294c8a3c" value="ops_calendar_event&#xa;日历事件&#xa;grain: 辖区 × 日期 × 事件一行&#xa;comment: 保存已解析的节假日、学校假期和其他可验证日历事件。&#xa;fields:&#xa;calendar_event_id uuid NN — 一条日历事件稳定主键。&#xa;job_run_id uuid NN — 产生事件的日历抓取任务；来源网址、内容哈希、解析器版本和批准证据放在该运行的 input_manifest 与审计事件。&#xa;jurisdiction_code text NN — 事件适用辖区。&#xa;event_date date NN — 事件在当地日历发生的日期。&#xa;event_type text NN — PUBLIC_HOLIDAY、SCHOOL_HOLIDAY、EVENT 或 CLOSURE。&#xa;event_code text NULL — 跨年份或来源可识别的标准事件代码。&#xa;event_name text NN — 来源确认的事件名称。&#xa;is_paid_holiday boolean NULL — 该地点员工是否按批准规则视为带薪公共假日。&#xa;status text NN — ACTIVE、CANCELLED 或 SUPERSEDED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_d0b3e7cfb0f3627342ff" value="ops_daily_review&#xa;每日运营复盘&#xa;grain: 地点 × 营业日 × 复盘版本一行&#xa;comment: 保存某地点营业日的结构化复盘版本，区分人工事实、AI总结和采纳状态。&#xa;fields:&#xa;daily_review_id uuid NN — 一版每日复盘稳定主键。&#xa;location_id uuid NN — 复盘地点。&#xa;business_date date NN — 被复盘的营业日。&#xa;version_no integer NN — 同地点同日期的复盘版本。&#xa;ai_call_id uuid NULL — 生成或辅助该复盘的 AI 调用。&#xa;manager_revenue numeric(18,4) NULL — 店长对该营业日确认或录入的营收金额。&#xa;manager_transaction_count integer NULL — 店长确认的该营业日交易笔数。&#xa;manager_avg_transaction numeric(18,4) NULL — 店长或现有来源独立报告的平均每笔交易金额；若只是 manager_revenue ÷ manager_transaction_count 的系统计算结果则必须留空。&#xa;manager_avg_transaction_source text NULL — manager_avg_transaction 非空时必须说明 INDEPENDENT_MANAGER_REPORT、INDEPENDENT_SOURCE_REPORT 或 MIGRATED_LEGACY。&#xa;manager_revenue_at timestamptz NULL — 店长营收数字被确认的绝对时间。&#xa;manager_currency char(3) NN — 店长录入营收和平均客单的币种。&#xa;manager_input_schema_version text NN — manager_input JSON 的批准结构版本。&#xa;manager_input jsonb NN — 店长确认的突发事件、原因、备注和暂未升格的低频信息。&#xa;review_summary_schema_version text NN — review_summary JSON 采用的批准结构版本。&#xa;review_summary jsonb NN — 按批准 schema 保存结论、指标和证据引用。&#xa;status text NN — DRAFT、SUBMITTED、APPROVED 或 SUPERSEDED。&#xa;approved_by_user_id uuid NULL — 批准复盘的账号。&#xa;approved_at timestamptz NULL — 复盘批准时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_944a9d18c5dbfdcc5bfa" value="ops_forecast_line&#xa;产品预测行&#xa;grain: 预测运行 × 产品一行&#xa;comment: 保存一次预测对每个产品的数量区间和解释。&#xa;fields:&#xa;forecast_line_id uuid NN — 产品预测行稳定主键。&#xa;forecast_run_id uuid NN — 所属预测运行。&#xa;product_id uuid NN — 被预测产品。&#xa;forecast_quantity numeric(18,4) NN — 按 forecast_run 执行时 product.base_unit 计算的中心预测数量。&#xa;lower_bound numeric(18,4) NULL — 批准置信水平下的需求下界。&#xa;upper_bound numeric(18,4) NULL — 批准置信水平下的需求上界。&#xa;model_explanation jsonb NN — 主要特征、日历因子和异常说明。&#xa;quality_status text NN — COMPLETE、LOW_HISTORY、UNMAPPED_INPUT 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_7b697b2c25648eeaf7fe" value="ops_forecast_run&#xa;需求预测运行&#xa;grain: 地点 × 目标营业日 × 一次算法运行一行&#xa;comment: 冻结一次预测使用的目标日期、算法、输入清单和结果状态。&#xa;fields:&#xa;forecast_run_id uuid NN — 一次预测运行稳定身份。&#xa;job_run_id uuid NN — 执行预测的自动任务。&#xa;location_id uuid NN — 预测目标门店或生产地点。&#xa;target_business_date date NN — 预测要回答的营业日期。&#xa;algorithm_version text NN — 预测算法和参数版本。&#xa;input_manifest jsonb NN — 销售批次、日历批次、规则版本和人工事件 ID。&#xa;status text NN — RUNNING、SUCCEEDED、PARTIAL、FAILED 或 REJECTED。&#xa;started_at timestamptz NN — 预测计算开始时间。&#xa;completed_at timestamptz NULL — 预测计算结束时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="6610" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_0d48211a06875b4c545a" value="ops_location&#xa;统一地点主数据&#xa;grain: 每个真实经营地点一行&#xa;comment: 统一表示门店、中央厨房、仓库、办公室或兼具多种能力的地点。&#xa;fields:&#xa;location_id uuid NN — 跨所有模块稳定不变的地点身份。&#xa;parent_location_id uuid NULL — 地点层级中的直接上级，例如区域或园区。&#xa;location_code text NN — 程序、文件和业务人员共同使用的唯一不可变代码。&#xa;location_name text NN — 地点当前正式展示名称。&#xa;address_text text NULL — 当前经人工确认的营业或收货地址文本。&#xa;area_code text NULL — 企业治理的城市、商圈或运营区域代码。&#xa;location_type text NN — STORE、KITCHEN、WAREHOUSE、OFFICE 或 HYBRID。&#xa;country_code char(2) NN — ISO 3166-1 alpha-2 国家代码。&#xa;timezone_name text NN — IANA 时区名称。&#xa;business_day_cutoff time NN — 跨午夜营业时，时间归属下一营业日的切点。&#xa;status text NN — PLANNED、ACTIVE、SUSPENDED 或 CLOSED。&#xa;opened_on date NULL — 地点正式开始经营的日期。&#xa;closed_on date NULL — 地点永久停止经营的日期。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_bbc265b16d877014d444" value="ops_location_source_identity&#xa;地点来源身份映射&#xa;grain: 来源系统 × 外部地点ID × 有效期一行&#xa;comment: 把 RES、Lark、财务模板等外部地点编号映射到统一 location_id，并保留有效期。&#xa;fields:&#xa;location_source_identity_id uuid NN — 一次地点来源映射稳定主键。&#xa;location_id uuid NN — 映射后的企业统一地点。&#xa;source_system_id uuid NN — 提供外部地点编号的来源系统。&#xa;source_container_id text NULL — 外部地点标识所在的组织、应用、Base 或其他命名空间原始ID；来源没有容器层时为空。&#xa;source_location_id text NN — 来源系统在 source_container_id 范围内给出的地点、门店或地点专属集合标识，原样保存。&#xa;source_location_name text NULL — 映射时来源显示的地点名称快照。&#xa;valid_from timestamptz NN — 该映射开始有效的时间。&#xa;valid_to timestamptz NULL — 该映射停止有效的时间。&#xa;mapping_status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;evidence jsonb NN — 人工确认所依据的来源 URL、截图哈希或业务说明。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_c9fb1fbfb287880dccb3" value="ops_operational_event&#xa;运营突发事件&#xa;grain: 一个地点的一次连续运营事件一行&#xa;comment: 记录停电、设备故障、人流异常、促销或其他当日突发情况及人工证据。&#xa;fields:&#xa;operational_event_id uuid NN — 一次运营突发稳定主键。&#xa;location_id uuid NN — 事件发生地点。&#xa;event_type text NN — POWER_OUTAGE、EQUIPMENT_FAILURE、PROMOTION、FOOTFALL_SURGE、STAFF_SHORTAGE 或 OTHER。&#xa;event_title text NN — 简短可读的事件概述。&#xa;started_at timestamptz NN — 事件实际或估计开始时间。&#xa;ended_at timestamptz NULL — 事件恢复时间；仍持续时为空。&#xa;impact_direction text NN — INCREASE、DECREASE、MIXED 或 UNKNOWN。&#xa;impact_summary text NN — 对产能、销售、人员或服务的可读说明。&#xa;evidence jsonb NN — 照片链接哈希、设备工单或销售差异等脱敏证据。&#xa;status text NN — OPEN、CONFIRMED、RESOLVED 或 REJECTED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_6f6a537afd77d7c2458d" value="ops_operational_event_product&#xa;运营事件受影响产品&#xa;grain: 运营事件 × 产品一行&#xa;comment: 明确运营事件影响哪些产品以及影响方向和数量。&#xa;fields:&#xa;operational_event_product_id uuid NN — 事件产品影响稳定主键。&#xa;operational_event_id uuid NN — 所属运营事件。&#xa;product_id uuid NN — 受影响统一产品。&#xa;impact_direction text NN — INCREASE、DECREASE、UNAVAILABLE 或 UNKNOWN。&#xa;estimated_quantity_impact numeric(18,4) NULL — 按事件发生时 product.base_unit 估计的少产或多卖数量，未知为空。&#xa;note text NULL — 产品层面的人工说明。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_223feab619d0daff788a" value="ops_product&#xa;统一产品主数据&#xa;grain: 每个企业产品一行&#xa;comment: 维护 HOT CRUSH 可销售、可生产产品的稳定身份，不等同于某门店 POS listing。&#xa;fields:&#xa;product_id uuid NN — 跨预测、销售、配方、成本和营销稳定不变的产品身份。&#xa;product_code text NN — 企业内部唯一不可变产品代码。&#xa;product_name text NN — 当前正式中文或主要展示名称。&#xa;english_name text NULL — 当前正式英文展示名称。&#xa;product_type text NN — SELLABLE、PRODUCED、SERVICE 或 BUNDLE。&#xa;category_code text NN — 稳定的开放治理产品品类代码；历史成本卡尚未归类时保留 LEGACY_COST_CARD_UNCLASSIFIED。&#xa;base_unit_id uuid NN — 产品计划、生产、配送和销售统一采用的受控计量单位。&#xa;pack_multiple numeric(18,4) NN — 排产或配送允许的最小包装倍数。&#xa;planning_rounding_mode text NN — BATCH_MULTIPLE 或 INDIVIDUAL；前者按 pack_multiple 取整，后者允许按单个基础单位调整。&#xa;temperature_profile_code text NULL — HOT、COLD、AMBIENT 或 MIXED。&#xa;is_production_planned boolean NN — 该产品是否进入生产预估和排产。&#xa;is_inventory_tracked boolean NN — 是否需要记录成品库存或配送。&#xa;status text NN — DRAFT、ACTIVE、SUSPENDED 或 RETIRED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_7d5288cae9aab8618b0d" value="ops_product_alias&#xa;产品别名&#xa;grain: 来源范围 × 一个别名 × 有效期一行&#xa;comment: 保存人工输入、Excel和历史系统中的产品别称，并明确归一到 product_id。&#xa;fields:&#xa;product_alias_id uuid NN — 产品别名稳定主键。&#xa;product_id uuid NN — 别名明确指向的统一产品。&#xa;source_system_id uuid NULL — 别名来自哪个系统；企业通用别名可以为空。&#xa;alias_text text NN — 来源中出现的原始产品写法。&#xa;language_code text NULL — 别名语言，例如 zh-CN 或 en。&#xa;valid_from date NN — 别名开始有效日期。&#xa;valid_to date NULL — 别名停止有效的日期上界，该日期本身不再有效。&#xa;status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_965bfa4dd8d15f21c279" value="ops_production_plan_line&#xa;生产预估单产品行&#xa;grain: 预估单版本 × 产品一行&#xa;comment: 保存某版本每个产品的计划数量和人工判断来源。&#xa;fields:&#xa;production_plan_line_id uuid NN — 一条产品计划行稳定主键。&#xa;production_plan_version_id uuid NN — 所属预估单版本。&#xa;product_id uuid NN — 计划生产的统一产品。&#xa;forecast_line_id uuid NULL — 该计划行采用的预测建议；纯人工添加可为空。&#xa;based_on_plan_line_id uuid NULL — 本产品行从上一版本哪一行复制或调整；首次或新增产品为空。&#xa;planned_quantity numeric(18,4) NN — 该版本按本行 unit_id 批准准备的总数量。&#xa;unit_id uuid NN — 计划数量采用的受控单位，发布时必须等于产品基础单位。&#xa;adjustment_reason_code text NULL — 若偏离预测，记录批准原因。&#xa;adjustment_note text NULL — 本产品相对基础行发生变化时的必要理由。&#xa;suggested_by_ai_call_id uuid NULL — 若该产品数量来自 AI 建议，连接产生建议的调用。&#xa;confirmed_by_user_id uuid NULL — 确认采用该产品数量的应用账号。&#xa;note text NULL — 产品层面的简短执行说明。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="7340" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_a4a5bbc4084020346fc9" value="ops_production_plan_version&#xa;生产预估单版本&#xa;grain: 生产地点 × 计划营业日 × 版本号一行&#xa;comment: 直接保留某地点某营业日每次预测建议、人工调整、审批、发布或取消，不再为同一自然键另建空壳主单。&#xa;fields:&#xa;production_plan_version_id uuid NN — 一版预估单稳定身份。&#xa;location_id uuid NN — 执行生产的门店或中央厨房。&#xa;plan_business_date date NN — 该版本计划产出服务的营业日期。&#xa;forecast_run_id uuid NULL — 该版本起点的预测运行；纯人工版本可以为空。&#xa;based_on_version_id uuid NULL — 本版本从哪一旧版本复制或调整。&#xa;version_no integer NN — 同一生产地点和计划营业日内从 1 递增的版本号。&#xa;status text NN — DRAFT、SUBMITTED、APPROVED、PUBLISHED、SUPERSEDED、REJECTED 或 CANCELLED。&#xa;change_summary text NULL — 相对基础版本的人工或系统改动说明。&#xa;approved_at timestamptz NULL — 审批完成时间。&#xa;approved_by_user_id uuid NULL — 批准该版本的账号。&#xa;published_at timestamptz NULL — 版本成为正式下游输入的时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_525f5f78b6eab41d4733" value="ops_review_action&#xa;复盘改进行动&#xa;grain: 复盘 × 一项改进行动一行&#xa;comment: 把复盘建议变成有负责人、期限和完成状态的动作。&#xa;fields:&#xa;review_action_id uuid NN — 一项改进行动稳定主键。&#xa;daily_review_id uuid NN — 行动来源复盘。&#xa;action_type text NN — PLAN_ADJUSTMENT、TRAINING、MAINTENANCE、SUPPLY、STAFFING 或 OTHER。&#xa;action_description text NN — 具体、可验证的下一步。&#xa;owner_employment_id uuid NULL — 负责完成行动的员工。&#xa;due_at timestamptz NULL — 行动应完成时间。&#xa;status text NN — OPEN、IN_PROGRESS、COMPLETED、CANCELLED 或 REJECTED。&#xa;completed_at timestamptz NULL — 行动实际完成时间。&#xa;completion_evidence jsonb NN — 相关新计划版本、培训结果或工单 ID。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_367eb04238ea0abe0227" value="ops_role&#xa;标准岗位&#xa;grain: 一个标准岗位一行&#xa;comment: 维护排班、招聘和培训共同使用的标准岗位身份。&#xa;fields:&#xa;role_id uuid NN — 跨招聘、培训和班表稳定岗位身份。&#xa;role_code text NN — 程序和业务共同使用的唯一代码。&#xa;role_name text NN — 当前岗位显示名称。&#xa;role_family text NN — KITCHEN、FRONT、LOGISTICS、MANAGEMENT 或 SUPPORT。&#xa;is_critical boolean NN — 该岗位是否通常属于必须明确覆盖的关键岗位。&#xa;status text NN — ACTIVE 或 RETIRED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_edf4d3ba46bd6a9d8490" value="ops_stockout_event&#xa;商品断货事件&#xa;grain: 地点 × listing × 一次连续断货区间一行&#xa;comment: 记录人工确认或算法识别的断货时段、证据及估算损失。&#xa;fields:&#xa;stockout_event_id uuid NN — 一次连续断货事件稳定主键。&#xa;location_id uuid NN — 发生断货的门店。&#xa;listing_id uuid NN — 断货商品的来源 listing。&#xa;detected_job_run_id uuid NULL — 自动识别该事件的任务运行；纯人工录入可为空。&#xa;business_date date NN — 断货主要归属营业日。&#xa;started_at timestamptz NN — 确认或估算的售罄开始时间。&#xa;ended_at timestamptz NULL — 补货恢复或营业结束时间。&#xa;detection_method text NN — AUTOMATIC、MANUAL 或 CONFIRMED_AUTOMATIC。&#xa;lost_quantity_estimate numeric(18,4) NULL — 按该 listing 的 POS 商品单位和批准算法估计因断货少卖的数量。&#xa;lost_sales_estimate numeric(18,4) NULL — 按批准算法估计的销售额损失。&#xa;currency char(3) NN — lost_sales_estimate 采用的 ISO 4217 币种。&#xa;estimation_version text NULL — 生成损失估算的算法版本。&#xa;evidence jsonb NN — 最后销售时刻、后续零销量、人工说明等证据。&#xa;status text NN — DETECTED、CONFIRMED、REJECTED 或 CLOSED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ad357cda3f8b8d9bbb5a" value="pos_daily_breakdown&#xa;POS日销售维度拆分&#xa;grain: 地点 × 营业日 × 维度类型 × 维度值 × POS批次一行&#xa;comment: 保存支付方式、就餐方式或渠道等日销售拆分，避免把不同维度做成固定宽列。&#xa;fields:&#xa;daily_breakdown_id uuid NN — 一条日维度拆分稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该拆分的来源批次。&#xa;location_id uuid NN — 拆分所属门店。&#xa;business_date date NN — 拆分事实所属营业日。&#xa;dimension_type text NN — PAYMENT_METHOD、DINING_TYPE、CHANNEL 或其他批准类型。&#xa;dimension_value text NN — 来源维度的原始或标准代码。&#xa;quantity numeric(18,4) NULL — 该维度对应的订单、交易或其他来源数量。&#xa;quantity_unit text NULL — ORDER、TRANSACTION、GUEST 或来源批准的其他计数单位。&#xa;gross_sales numeric(18,4) NULL — 该维度的流水金额。&#xa;net_sales numeric(18,4) NN — 该维度的净销售金额。&#xa;currency char(3) NN — 金额币种。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_12f61af875fc8ab93c78" value="pos_ingest_batch&#xa;POS导入批次&#xa;grain: 某地点 × 某数据集 × 一次抓取或重跑一行&#xa;comment: 记录每次 RES/POS 抓取的数据集、窗口、游标、校验值和完整性。&#xa;fields:&#xa;pos_ingest_batch_id uuid NN — 一次 POS 导入批次稳定身份。&#xa;job_run_id uuid NN — 执行本批次的自动任务。&#xa;source_system_id uuid NN — 本批数据的 POS 来源。&#xa;location_id uuid NN — 该批数据所属企业地点；未确认映射时批次进入失败或审核状态。&#xa;supersedes_pos_ingest_batch_id uuid NULL — 本批明确更正并替代的旧批次；首次采集或并行数据集为空。&#xa;dataset_code text NN — 本批唯一的数据契约代码，只允许 PRODUCT_LISTING、SALES_DAY、SALES_HOUR、ITEM_SALES_HOUR、DAILY_BREAKDOWN、ITEM_WASTE、ORDER、ORDER_ITEM、MEMBER_PROFILE、MEMBER_CARD_TRANSACTION、MEMBER_DAILY_METRIC、PAYMENT 或 REFUND。&#xa;coverage_scope text NULL — 该批次订单明细覆盖范围；旧会员标记订单只能 MEMBER_FLAGGED_ONLY，只有经完整性证明的全量批次才 ALL_ORDER_ITEMS，不可由单行反推。&#xa;parser_version text NN — 把来源字段、原始枚举和金额符号解释为规范字段时采用的不可变解析器版本。&#xa;window_start timestamptz NN — 向来源请求的数据时间窗口起点。&#xa;window_end timestamptz NN — 向来源请求的数据时间窗口终点，不包含该时刻。&#xa;source_cursor text NULL — 分页或增量同步使用的来源游标。&#xa;source_batch_id text NULL — 来源系统提供的稳定批次或报表任务 ID。&#xa;payload_sha256 char(64) NULL — 原始响应或规范化文件的 SHA-256。&#xa;idempotency_key char(64) NN — 按来源、地点、数据集、请求窗口、外部批次或内容校验值规范化计算的 SHA-256。&#xa;expected_row_count bigint NULL — 来源声明或预检得到的行数。&#xa;loaded_row_count bigint NN — 本批成功写入或确认幂等存在的行数。&#xa;status text NN — RUNNING、SUCCEEDED、PARTIAL、FAILED 或 REJECTED。&#xa;completed_at timestamptz NULL — 批次进入终态的时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4e6e87a6259980e74a51" value="pos_item_sales_hour&#xa;POS商品小时销售事实&#xa;grain: 地点 × 营业小时 × POS listing × POS批次一行&#xa;comment: 保存 listing 在每个营业小时的销量和销售额；即使尚未映射 product_id 也能完整入库。&#xa;fields:&#xa;item_sales_hour_id uuid NN — 商品小时事实稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该事实的来源批次。&#xa;location_id uuid NN — 销售发生的门店地点。&#xa;listing_id uuid NN — 来源 POS 商品身份。&#xa;business_date date NN — 该销售小时所属营业日。&#xa;hour_started_at timestamptz NN — 统计桶绝对开始时间。&#xa;currency char(3) NN — 本行所有销售金额采用的 ISO 4217 币种。&#xa;quantity numeric(18,4) NN — 该 listing 在该小时按 POS 商品销售单位统计的净数量，退款口径由来源定义。&#xa;gross_sales numeric(18,4) NN — 该 listing 在该小时折扣前金额。&#xa;discount_amount numeric(18,4) NN — 该 listing 在该小时的来源折扣金额；来源未返回独立折扣时为空。&#xa;net_sales numeric(18,4) NN — 该 listing 在该小时的最终销售额。&#xa;source_name_snapshot text NN — 抓取该事实时 POS 返回的商品名称。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="8070" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_1f37331f891bd2bc3321" value="pos_item_waste&#xa;POS商品报废事实&#xa;grain: 地点 × 营业日 × listing × 来源报废记录 × POS批次一行&#xa;comment: 保存来源报废记录及标准原因，不把试吃等营销用途默认算作损失。&#xa;fields:&#xa;waste_id uuid NN — 一条报废事实稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该事实的来源批次。&#xa;location_id uuid NN — 报废发生地点。&#xa;listing_id uuid NN — 报废商品的来源 listing。&#xa;source_waste_id text NULL — 来源有稳定记录 ID 时原样保存。&#xa;source_row_fingerprint char(64) NN — 按本数据集固定版本的规范化规则，对原始来源行和稳定上下文计算的 SHA-256。&#xa;business_date date NN — 报废归属营业日。&#xa;occurred_at timestamptz NULL — 来源能提供时记录具体报废时刻。&#xa;source_name_snapshot text NN — 报废报表该行返回的商品名称原文。&#xa;quantity numeric(18,4) NN — 按该 listing 的 POS 商品单位记录的报废数量。&#xa;source_waste_amount numeric(18,4) NULL — RES/POS 报废报表直接返回的金额原值；来源无值时为空。&#xa;currency char(3) NN — source_waste_amount 使用的 ISO 4217 币种。&#xa;reason_raw text NULL — POS 返回的原始报废原因。&#xa;reason_code text NULL — 映射后的标准报废、试吃、质量、损坏等原因。&#xa;reason_mapping_version text NULL — 把 reason_raw 转为 reason_code 的规则版本。&#xa;is_financial_loss boolean NN — 该原因是否纳入经营损失计算。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4c6f71271790ec53c2ff" value="pos_member&#xa;POS会员主档&#xa;grain: 每个企业内可识别的 POS 会员一行&#xa;comment: 只保存会员非敏感稳定身份和企业治理状态；每天变化的等级、积分、累计值和余额进入会员状态快照，联系方式另表隔离。&#xa;fields:&#xa;member_id uuid NN — 企业库内会员稳定身份。&#xa;source_system_id uuid NN — 当前会员来源的 POS 系统。&#xa;home_location_id uuid NULL — 来源可确认的注册或主归属门店；未知为空。&#xa;source_member_id text NN — POS customerId 等稳定会员标识。&#xa;registered_on date NULL — 会员在来源系统登记日期。&#xa;source_type text NULL — POS 提供的注册来源或渠道代码。&#xa;status text NN — 企业内部治理状态：ACTIVE、BLOCKED 或 MERGED；它不是 POS 每日来源会员状态。&#xa;merged_into_member_id uuid NULL — 重复会员合并后指向保留会员。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_ea1e4ffebe636bb5af52" value="pos_member_balance_snapshot&#xa;会员状态与余额快照&#xa;grain: 会员 × 快照日期 × POS批次一行&#xa;comment: 保存来源在某日直接观察到、无法从不完整流水可靠反推的会员等级、积分、累计值和会员名下全部卡余额。&#xa;fields:&#xa;member_balance_snapshot_id uuid NN — 一条余额快照稳定主键。&#xa;member_id uuid NN — 余额所属会员；当前来源只证明会员名下全部卡合计，不能伪造到具体卡。&#xa;pos_ingest_batch_id uuid NN — 产生余额快照的来源批次。&#xa;snapshot_date date NN — 余额被来源观察到的营业日期。&#xa;profile_present boolean NN — 该批 MEMBER_PROFILE 抓取是否直接观察到该会员的客户档案。&#xa;level_name text NULL — 该快照日 POS 客户档案直接报告的会员等级原文。&#xa;growth integer NULL — 该快照日 POS 直接报告的当前成长值。&#xa;point_balance integer NULL — 该快照日 POS 直接报告的可用积分存量。&#xa;lifetime_topup_amount numeric(18,4) NULL — 该快照日 POS 直接报告的生命周期累计充值金额。&#xa;lifetime_topup_count integer NULL — 该快照日 POS 直接报告的生命周期累计充值次数。&#xa;lifetime_consume_amount numeric(18,4) NULL — 该快照日 POS 直接报告的生命周期累计消费金额。&#xa;lifetime_consume_count integer NULL — 该快照日 POS 直接报告的生命周期累计消费次数。&#xa;first_card_created_on date NULL — 该快照日 POS 客户档案直接报告的最早会员卡创建日期。&#xa;last_recharge_at timestamptz NULL — 该快照日 POS 客户档案直接报告的最近充值时刻。&#xa;last_transaction_at timestamptz NULL — 该快照日 POS 客户档案直接报告的最近交易时刻。&#xa;cash_balance numeric(18,4) NULL — 会员实际充值现金形成的剩余余额。&#xa;gift_balance numeric(18,4) NULL — 促销赠送形成的剩余余额。&#xa;frozen_balance numeric(18,4) NULL — 来源直接报告、当前不可用的冻结余额。&#xa;total_balance numeric(18,4) NULL — 来源直接报告的会员名下现金与赠送等余额总计。&#xa;currency char(3) NN — 余额及累计充值、消费金额采用的 ISO 4217 币种。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_9c6660bf4802fbad3450" value="pos_member_card&#xa;会员卡&#xa;grain: 每张来源会员卡一行&#xa;comment: 把一名会员的多张卡拆为独立身份，避免把卡余额永远聚合进会员主档。&#xa;fields:&#xa;member_card_id uuid NN — 企业库内会员卡稳定身份。&#xa;member_id uuid NN — 卡所属会员。&#xa;source_system_id uuid NN — 该外部卡ID所属的来源命名空间。&#xa;issued_location_id uuid NULL — 来源可确认的发卡地点；未知为空。&#xa;source_card_id text NN — POS 中稳定的卡标识。&#xa;card_type_code text NULL — 来源卡种或企业标准卡类型。&#xa;issued_at timestamptz NULL — 来源可提供时记录发卡时刻。&#xa;expires_at timestamptz NULL — 卡的业务到期时间。&#xa;status text NN — ACTIVE、FROZEN、EXPIRED、CLOSED 或 UNKNOWN。&#xa;last_snapshot_date date NN — 最近一次在卡列表观察到的日期。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_232cf347d8e6a0a05e39" value="pos_member_card_transaction&#xa;会员卡交易流水&#xa;grain: 每笔来源会员卡交易一行&#xa;comment: 保存充值、消费核销、退款和余额调整的不可变事件。&#xa;fields:&#xa;member_card_transaction_id uuid NN — 企业库内卡交易稳定主键。&#xa;member_id uuid NULL — 已成功解析到企业稳定会员身份时记录；来源缺失或会员快照尚未覆盖时为空，绝不猜配。&#xa;source_member_id text NULL — 当前流水 member_id 的来源原值；来源为空则保持 NULL。&#xa;member_card_id uuid NULL — 来源能确认时对应具体卡。&#xa;source_card_id text NULL — 当前流水 card_no 的原始文本，可能是长数字、短数字或含字母。&#xa;source_system_id uuid NN — 外部交易和订单ID所属来源命名空间。&#xa;location_id uuid NN — 交易发生或归属门店。&#xa;pos_ingest_batch_id uuid NN — 采集该流水的来源批次。&#xa;source_transaction_id text NN — 来源稳定交易标识。&#xa;source_transaction_type_code smallint NN — POS 原始 txn_type 数值代码，按来源原样保存；当前已观察 10、20、30、40、50、60，但不把未来未知代码拒绝或猜成现有类型。&#xa;source_transaction_type_label text NN — POS 同步结果中的 txn_type_label 原值。&#xa;transaction_type text NN — 由原始代码和标签按批次 parser_version 规范成 TOP_UP、CONSUME、TOP_UP_REFUND、CONSUME_REFUND、ADJUST_UP、ADJUST_DOWN 或 UNKNOWN。&#xa;occurred_at timestamptz NULL — 来源 txn_at 经明确 KL 墙上时间规则转换后的绝对时刻；来源缺失时为空。&#xa;business_date date NN — 按地点切点归属的营业日。&#xa;cash_amount numeric(18,4) NULL — 来源 money_amount 原值；表示交易中的现金储值或核销部分，来源缺失时保持 NULL。&#xa;gift_amount numeric(18,4) NULL — 来源 gift_amount 原值；表示交易中的赠送额度部分，来源缺失时保持 NULL。&#xa;total_amount numeric(18,4) NULL — 来源 total_amount 原值，当前来源定义为 money_amount + gift_amount，来源缺失时保持 NULL。&#xa;trade_amount numeric(18,4) NULL — 来源 trade_amount 原值；语义随原始类型变化：充值为本金、消费/退款为含赠送卡值、调整当前观察为0。&#xa;before_money_balance numeric(18,4) NULL — 来源在该交易发生前直接报告的卡现金余额。&#xa;after_money_balance numeric(18,4) NULL — 来源在该交易发生后直接报告的卡现金余额。&#xa;before_gift_balance numeric(18,4) NULL — 来源在该交易发生前直接报告的卡赠送余额。&#xa;after_gift_balance numeric(18,4) NULL — 来源在该交易发生后直接报告的卡赠送余额。&#xa;point_delta integer NULL — 来源随该交易直接报告的积分增加或扣减数量；无积分信息时为空。&#xa;currency char(3) NN — 交易金额币种。&#xa;order_id uuid NULL — 已解析到稳定订单身份时的强连接；充值等非订单流水或尚未解析时为空。&#xa;source_pos_order_no text NULL — 当前表 pos_order_no 的原始文本；来源未提供或没有订单语义时为空。&#xa;source_order_id text NULL — 当前表 order_id 的外部原值；没有订单语义时为空。&#xa;source_code text NULL — 当前交易行 source_code 的原始值；来源为空则保持 NULL。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_c431ce3a97beceda485e" value="pos_member_contact&#xa;会员联系方式&#xa;grain: 会员 × 联系方式类型 × 有效期一行&#xa;comment: 隔离存放业务明确批准保留的会员手机号，并支持换号历史。&#xa;fields:&#xa;member_contact_id uuid NN — 一条会员联系方式稳定主键。&#xa;member_id uuid NN — 联系方式所属会员。&#xa;contact_type text NN — 当前批准 PHONE；未来扩展必须重新做字段隐私评审。&#xa;contact_ciphertext bytea NN — 应用层加密后的 E.164 手机号。&#xa;lookup_hash char(64) NN — 标准化号码的带密钥哈希。&#xa;country_calling_code text NULL — 非敏感的电话国家代码，例如 +60。&#xa;valid_from timestamptz NN — 号码开始被观察为当前号码的时间。&#xa;valid_to timestamptz NULL — 号码不再有效的时间。&#xa;verified_at timestamptz NULL — 号码经过验证码或权威来源确认的时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_11d2e0b5ed1ed041fa89" value="pos_member_daily_metric&#xa;会员日指标&#xa;grain: 地点 × 营业日 × POS批次一行&#xa;comment: 保存会员人数、消费、充值、核销、调整和期末余额等来源日报原值；比率和可重算净额只在视图派生。&#xa;fields:&#xa;member_daily_metric_id uuid NN — 一条会员日指标稳定主键。&#xa;location_id uuid NN — 指标所属门店。&#xa;pos_ingest_batch_id uuid NN — 产生指标的来源批次。&#xa;business_date date NN — 指标所属营业日。&#xa;new_member_count integer NULL — 来源日报直接报告的当日新增会员人数。&#xa;consumed_member_count integer NULL — 来源日报直接报告的当日发生消费的去重会员数。&#xa;recharged_member_count integer NULL — 来源日报直接报告的当日发生充值的去重会员数。&#xa;points_member_count integer NULL — 来源日报直接报告的当日发生积分变化的去重会员数。&#xa;member_sales numeric(18,4) NULL — 已识别会员订单的全部销售额，不限支付方式。&#xa;total_consume_amount numeric(18,4) NULL — 会员日报接口直接报告、用于其会员贡献率和卡支付率的当日总消费分母。&#xa;topup_cash numeric(18,4) NULL — 来源日报直接报告的正常充值现金本金。&#xa;topup_gift numeric(18,4) NULL — 来源日报直接报告的充值赠送价值。&#xa;topup_face_value numeric(18,4) NULL — 来源日报直接报告的正常充值总面值。&#xa;topup_count integer NULL — 来源日报直接报告的正常充值交易笔数。&#xa;topup_refund numeric(18,4) NULL — 来源日报直接报告的充值退款金额；符号遵循来源。&#xa;redeem_amount numeric(18,4) NULL — 来源日报直接报告的会员卡消费核销总额。&#xa;redeem_cash numeric(18,4) NULL — 来源日报直接报告的核销现金余额部分。&#xa;redeem_gift numeric(18,4) NULL — 来源日报直接报告的核销赠送余额部分。&#xa;redeem_count integer NULL — 来源日报直接报告的会员卡核销交易笔数。&#xa;consume_refund numeric(18,4) NULL — 来源日报直接报告的卡消费退款金额；符号遵循来源。&#xa;adjust_net numeric(18,4) NULL — 来源日报直接报告的卡余额后台调增减净额。&#xa;topup_adjust_amount numeric(18,4) NULL — 写入规则从后台调整中分类为客户预存的金额。&#xa;adjust_correction numeric(18,4) NULL — 后台调整中不计入充值、被分类为补偿或纠错的金额。&#xa;stored_value_cash_net numeric(18,4) NULL — 现金充值、退款和调整后的日净变化。&#xa;balance_end_total numeric(18,4) NULL — 来源累计区间直接报告的期末现金加赠送余额总额。&#xa;balance_end_cash numeric(18,4) NULL — 当日抓取的会员卡现金余额总存量。&#xa;balance_end_gift numeric(18,4) NULL — 当日抓取的会员卡赠送余额总存量。&#xa;currency char(3) NN — 所有金额币种。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="8800" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_29b53494b8a3aa104ad7" value="pos_order&#xa;POS订单稳定身份&#xa;grain: 来源系统 × 地点 × 外部订单ID一行&#xa;comment: 只保存来源订单的稳定身份，不把尚未证明存在的订单头金额、状态或时间硬塞进同一行。&#xa;fields:&#xa;order_id uuid NN — 企业库内订单稳定主键。&#xa;source_system_id uuid NN — 外部订单ID所属来源命名空间。&#xa;location_id uuid NN — 订单发生门店。&#xa;first_seen_pos_ingest_batch_id uuid NN — 第一次观察到该订单身份的合格批次。&#xa;source_order_id text NN — 来源在同一来源系统和地点内跨分页、跨重跑稳定的订单ID。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_71f7086734728a47ec10" value="pos_order_item&#xa;POS订单商品最小事实&#xa;grain: POS 摄取批次 × 订单 × source_order_item_id × source_reversal_order_code 一行&#xa;comment: 保存 Report211 未聚合原始订单冲销行，保留来源行身份与 signed 数量/金额。&#xa;fields:&#xa;order_item_id uuid NN — 某批次内一条订单商品合计事实的稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该订单商品快照的来源批次。&#xa;order_id uuid NN — 所属稳定订单身份。&#xa;listing_id uuid NN — 来源 POS 商品身份。&#xa;business_date date NN — 来源报表明确返回或按地点口径筛选的营业日。&#xa;source_item_key_snapshot text NN — 本批来源返回的 D_itemName 实值；在已验证报表中实际为 POS item_key，而不是展示名称。&#xa;source_order_item_id text NN — RES Report211 D_itemId 原始稳定行身份。&#xa;source_order_status_code text NN — Report211 原始订单状态码。&#xa;source_reversal_order_code text NN — Report211 原始冲销方向代码。&#xa;gross_quantity numeric(18,4) NN — 原始行毛数量；允许负、零和正值。&#xa;gross_sales numeric(18,4) NN — 原始行毛销售额；允许负、零和正值。&#xa;discount_promotion_amount numeric(18,4) NN — M_OrderDetail_SUM_discountPromotionAmount 原始行值；signed。&#xa;refund_quantity numeric(18,4) NN — 原始冲销行退款数量；signed。&#xa;refund_amount numeric(18,4) NN — 原始冲销行退款金额；signed。&#xa;net_quantity numeric(18,4) NN — 原始行净数量；允许负、零和正值。&#xa;net_sales numeric(18,4) NN — 该批同一订单和 listing 的 M_Item_SUM_netSales 合计，可为零或负数。&#xa;currency char(3) NN — 净额币种。&#xa;member_consumption_flag boolean NN — RES 的 D_isMemberConsume 口径；当前回填因过滤条件全部为 true。&#xa;quality_status text NN — COMPLETE、PRODUCT_MAPPING_PENDING、PARTIAL 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_f7541f5c0cf8c495975d" value="pos_product_listing&#xa;POS商品listing&#xa;grain: 来源系统 × 来源组织 × 外部商品ID一行&#xa;comment: 保存某来源组织/门店菜单中的商品身份和当前目录属性，不直接等同于企业 product_id。&#xa;fields:&#xa;listing_id uuid NN — POS listing 在企业库内的稳定身份。&#xa;source_system_id uuid NN — 提供该商品目录的 POS 来源。&#xa;location_id uuid NULL — listing 所属地点；全组织 listing 可为空并通过来源组织解析。&#xa;source_organization_id text NN — 来源系统中的组织或品牌标识。&#xa;source_item_id text NN — 来源系统稳定商品标识，原样保存。&#xa;source_item_key text NN — 来源系统提供的完整 menu item key。&#xa;source_organization_type_code smallint NULL — RES/POS 返回的原始组织类型数值码。&#xa;source_menu_item_code text NULL — RES/POS 目录中的原始菜单商品代码。&#xa;source_name text NN — 目录同步时的原始显示名称。&#xa;source_name_en text NULL — RES/POS 返回的英文商品名称原值。&#xa;source_name_zh text NULL — RES/POS 返回的中文商品名称原值。&#xa;source_category text NULL — POS 目录中的原始品类。&#xa;source_category_id text NULL — RES/POS 返回的原始品类标识。&#xa;source_category_en text NULL — RES/POS 返回的英文品类名称原值。&#xa;source_category_zh text NULL — RES/POS 返回的中文品类名称原值。&#xa;source_specification text NULL — RES/POS 目录返回的原始规格文本。&#xa;current_price numeric(18,4) NULL — 目录同步时该 listing 的当前含义售价。&#xa;currency char(3) NN — 目录售价的 ISO 4217 币种。&#xa;source_cost_card_id text NULL — RES 目录返回的成本卡外部标识。&#xa;source_cost_spec_id text NULL — RES 成本卡返回的规格外部标识。&#xa;source_has_cost_card boolean NULL — RES 目录同步时返回的是否已建成本卡标记；来源未返回时为空。&#xa;source_total_cost numeric(18,6) NULL — RES 目录在最近同步时返回的总成本观察原值。&#xa;source_theoretical_cost numeric(18,6) NULL — RES 成本卡在最近同步时返回的理论成本观察原值。&#xa;source_status_code smallint NULL — RES/POS 目录返回的原始商品状态数值码。&#xa;display_name_override text NULL — 现有目录人工校正的中文显示名；为空时展示来源名称或企业产品名。&#xa;display_category_override text NULL — 现有目录人工校正的展示品类；为空时使用来源或企业品类。&#xa;is_active boolean NN — POS 当前是否允许销售该 listing。&#xa;first_seen_at timestamptz NN — 同步首次看到该 listing 的时间。&#xa;last_seen_at timestamptz NN — 最近一次目录同步仍看到该 listing 的时间。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_7f1dd98683e7c4316d48" value="pos_product_mapping&#xa;POS商品到统一产品映射&#xa;grain: POS listing × 有效期一行&#xa;comment: 版本化保存 listing 与 product_id 的确认关系，使历史销售按当时映射重现。&#xa;fields:&#xa;product_mapping_id uuid NN — 一条 listing 映射稳定主键。&#xa;listing_id uuid NN — 被映射的 POS listing。&#xa;product_id uuid NN — 确认后的企业统一产品。&#xa;valid_from timestamptz NN — 映射开始用于业务事实的时间。&#xa;valid_to timestamptz NULL — 映射停止有效时间。&#xa;mapping_method text NN — MANUAL、SOURCE_ID、APPROVED_RULE 或 MIGRATION。&#xa;confidence numeric(5,4) NULL — 候选或规则给出的 0 至 1 置信度。&#xa;status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;evidence jsonb NN — 来源 ID、产品代码、人工说明等结构化证据。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_74fec832ab296b01a025" value="pos_product_mapping_review&#xa;POS商品映射审核队列&#xa;grain: 一个 listing 的一次待审核问题一行&#xa;comment: 保存无法自动唯一映射的 listing 候选和处理结论。&#xa;fields:&#xa;mapping_review_id uuid NN — 一次商品映射审核稳定主键。&#xa;listing_id uuid NN — 需要审核的 POS listing。&#xa;candidate_product_id uuid NULL — 算法或人工提出的候选产品；无候选时为空。&#xa;candidate_score numeric(5,4) NULL — 候选匹配模型或规则得分。&#xa;reason_code text NN — NO_CANDIDATE、MULTIPLE_CANDIDATES、CONFLICT 或 LOW_CONFIDENCE。&#xa;evidence jsonb NN — 名称、来源 ID、售价、品类等候选证据。&#xa;status text NN — OPEN、APPROVED、REJECTED 或 DEFERRED。&#xa;reviewed_by_user_id uuid NULL — 完成审核的账号。&#xa;reviewed_at timestamptz NULL — 审核进入终态的时间。&#xa;review_note text NULL — 人工结论与必要的业务解释。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_89d196abc8e2c798c9d3" value="pos_sales_day&#xa;POS门店日销售事实&#xa;grain: 地点 × 营业日 × POS批次一行&#xa;comment: 保存某地点某营业日某批次的销售、折扣、订单和来源平均客单观察。&#xa;fields:&#xa;sales_day_id uuid NN — 日销售事实稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该事实的来源批次。&#xa;location_id uuid NN — 销售发生的门店地点。&#xa;business_date date NN — 按地点营业日切点归属的业务日期。&#xa;currency char(3) NN — 所有金额的 ISO 4217 币种。&#xa;gross_sales numeric(18,4) NULL — 折扣和退款处理前、按来源口径定义的销售金额；来源未返回时为空。&#xa;discount_amount numeric(18,4) NULL — 当日来源直接返回或由该来源明确字段归一化的折扣总额；来源未返回时为空。&#xa;refund_amount numeric(18,4) NULL — 当日来源明确计入本口径的退款总额；来源没有独立退款字段时为空。&#xa;net_sales numeric(18,4) NN — 来源最终认定的当日销售额。&#xa;order_count integer NULL — 来源日汇总中的有效订单数量；来源未返回时为空。&#xa;source_average_order_value numeric(18,4) NULL — 上游日汇总直接返回的平均客单原值；只有来源独立提供时才保存，系统自行相除得到的值不写入。&#xa;source_guest_count integer NULL — 上游日汇总提供的顾客/人数原始计数；来源无值时为空。&#xa;quality_status text NN — COMPLETE、PARTIAL、RECONCILIATION_WARNING 或 REJECTED。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_4b5549380012f9ed2b35" value="pos_sales_hour&#xa;POS门店小时销售事实&#xa;grain: 地点 × 营业日 × 营业小时 × POS批次一行&#xa;comment: 保存门店每个营业小时的销售和订单汇总。&#xa;fields:&#xa;sales_hour_id uuid NN — 小时销售事实稳定主键。&#xa;pos_ingest_batch_id uuid NN — 产生该事实的来源批次。&#xa;location_id uuid NN — 销售发生的门店地点。&#xa;business_date date NN — 该小时所属营业日。&#xa;hour_started_at timestamptz NN — 该统计桶的绝对开始时间。&#xa;currency char(3) NN — 金额币种。&#xa;gross_sales numeric(18,4) NN — 该小时来源口径的流水金额。&#xa;discount_amount numeric(18,4) NN — 该小时 RES/POS 汇总直接返回的折扣金额；来源缺失时为空。&#xa;net_sales numeric(18,4) NN — 该小时来源口径的净销售额。&#xa;order_count integer NN — 该小时有效订单数量。&#xa;source_guest_count integer NN — 该小时 RES 字段 num_of_guests 的原始计数；来源无值时为空。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="9530" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_54c302ea21ce44c631c9" value="scm_material&#xa;统一原料主数据&#xa;grain: 每个可采购、库存或作为配方组件的物料一行&#xa;comment: 统一表示原料、包材和半成品，不让供应链依赖财务成本卡内部编号。&#xa;fields:&#xa;material_id uuid NN — 连接配方、供应商 SKU、库存、订货、收货和采购价的稳定身份。&#xa;material_code text NN — 企业内部唯一不可变原料代码。&#xa;material_name text NN — 当前正式显示名称。&#xa;material_type text NN — INGREDIENT、PACKAGING、SEMI_FINISHED、CONSUMABLE 或 FINISHED_GOOD。&#xa;base_unit_id uuid NN — 库存、配方和成本归一化采用的受控计量单位。&#xa;shelf_life_days integer NULL — 未开封标准条件下的参考保质期。&#xa;is_lot_tracked boolean NN — 库存是否必须记录批号或效期。&#xa;status text NN — DRAFT、ACTIVE、SUSPENDED 或 RETIRED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_63b29c2dd8d67f7c8a9e" value="scm_material_alias&#xa;原料别名&#xa;grain: 来源范围 × 原料别名 × 有效期一行&#xa;comment: 保存供应商、财务模板和历史配方里的原料不同写法。&#xa;fields:&#xa;material_alias_id uuid NN — 原料别名稳定主键。&#xa;material_id uuid NN — 别名明确指向的统一原料。&#xa;source_system_id uuid NULL — 别名来自的系统；企业通用别名可以为空。&#xa;alias_text text NN — 来源中的原始物料名称。&#xa;valid_from date NN — 别名开始有效日期。&#xa;valid_to date NULL — 别名停止有效的日期上界，该日期本身不再有效。&#xa;status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_dd2dd12ceea0bad7b009" value="scm_material_price_observation&#xa;原料价格观察&#xa;grain: 原料 × 来源稳定记录 × 修订前驱一行&#xa;comment: 保存某原料的一次原始采购价格观察，不存任何换汇或 MYR 派生值。&#xa;fields:&#xa;material_price_observation_id uuid NN — 价格观察稳定主键。&#xa;material_id uuid NN — 被观察价格的稳定原料身份。&#xa;supplier_item_id uuid NULL — 若来源已解析供应商商品则记录；复合外键同时验证原料。&#xa;source_system_id uuid NN — 价格事实的权威来源系统。&#xa;source_record_id text NN — 来源中的稳定行身份；解释版本由证据定位。&#xa;source_payload_sha256 char(64) NN — 原始来源载荷的 lowercase SHA-256。&#xa;goods_receipt_line_id uuid NULL — RECEIPT_ACTUAL 的扩展包证据行。&#xa;purchase_order_line_id uuid NULL — PO_CONFIRMED 的扩展包证据行。&#xa;observation_type text NN — QUOTE、PO_CONFIRMED、RECEIPT_ACTUAL、MANUAL_MARKET_CHECK 或 LEGACY_MIGRATION。&#xa;observed_at timestamptz NN — 价格事实对应的业务观察时点。&#xa;raw_price_amount numeric(24,8) NN — 来源报价分子金额；允许有证据的零价，不允许负值。&#xa;raw_price_quantity numeric(24,8) NN — 该金额覆盖的原始计价数量。&#xa;raw_price_unit_text text NN — 来源原样单位文本，不以推断值覆盖。&#xa;raw_price_unit_id uuid NULL — 已解析的计价单位；未解析时为空。&#xa;material_unit_conversion_id uuid NULL — 获核验的原料/原始单位换算；复合外键验证原料和 from_unit。&#xa;transaction_currency_code char(3) NN — 来源价格的 ISO 4217 原币种，无默认。&#xa;zero_price_reason_code text NULL — 结构化零价原因；正价必须为空。&#xa;verification_evidence jsonb NN — 单位、价格、零价、parser 版本和来源证据；无默认空对象。&#xa;quality_status text NN — UNVERIFIED、VERIFIED、UNIT_ERROR 或 REJECTED。&#xa;verified_by_user_id uuid NULL — 人工核验者；权威自动核验时可空。&#xa;verified_at timestamptz NULL — VERIFIED 时必填的核验时间。&#xa;supersedes_material_price_observation_id uuid NULL — 本修订替代的当前终态价格观察；初始行为空。&#xa;created_at timestamptz NN — 记录创建时间。&#xa;updated_at timestamptz NN — 受控状态更新时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_1f2944b46cd7d0d1969e" value="scm_material_source_identity&#xa;原料来源身份映射&#xa;grain: 来源系统 × 外部原料ID × 有效期一行&#xa;comment: 把成本卡迁移编号、WMS编号等外部物料身份映射到 material_id。&#xa;fields:&#xa;material_source_identity_id uuid NN — 一条原料来源映射稳定主键。&#xa;material_id uuid NN — 映射后的统一原料。&#xa;source_system_id uuid NN — 提供外部物料编号的来源系统。&#xa;source_material_id text NN — 来源系统原始物料标识。&#xa;valid_from timestamptz NN — 映射开始有效时间。&#xa;valid_to timestamptz NULL — 映射停止有效时间。&#xa;mapping_status text NN — CONFIRMED、PENDING 或 REJECTED。&#xa;evidence jsonb NN — 规格、单位、供应商等核对证据。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="1720" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_c1f58e898ca2c39a0147" value="scm_material_unit_conversion&#xa;物料单位换算&#xa;grain: 原料 × 起始单位 × 目标单位 × 生效区间一行&#xa;comment: 版本化维护某种原料或包材在采购包装、配方用量和库存基础单位之间的可审核换算。&#xa;fields:&#xa;material_unit_conversion_id uuid NN — 一条有生效期的物料单位换算稳定主键。&#xa;material_id uuid NN — 该换算仅适用的统一原料或包材。&#xa;from_unit_id uuid NN — 原始数量使用的受控单位。&#xa;to_unit_id uuid NN — 换算后数量使用的受控单位，通常为 material.base_unit_id。&#xa;conversion_factor numeric(24,12) NN — 一个 from_unit 等于多少个 to_unit。&#xa;valid_from timestamptz NN — 该规格换算开始有效的时间。&#xa;valid_to timestamptz NULL — 该换算停止适用的时间；仍有效时为空。&#xa;source_system_id uuid NULL — 提供规格或换算证据的来源；纯人工称量可以为空。&#xa;evidence jsonb NN — 包装净含量、称量记录、供应商规格或迁移来源。&#xa;status text NN — PENDING、VERIFIED、REJECTED 或 RETIRED。&#xa;verified_by_user_id uuid NULL — 确认该换算证据的应用账号。&#xa;verified_at timestamptz NULL — 换算进入 VERIFIED 的时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2280" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_2b8dbdf8039ec9000082" value="scm_supplier&#xa;供应商主数据&#xa;grain: 一个法律或经营供应商一行&#xa;comment: 维护供应商稳定身份、采购币种、付款条件和状态。&#xa;fields:&#xa;supplier_id uuid NN — 跨报价、供应商SKU、PO、收货和财务核对的稳定身份。&#xa;supplier_code text NN — 企业内部唯一不可变供应商代码。&#xa;supplier_name text NN — 当前正式显示名称。&#xa;legal_name text NULL — 合同和发票使用的法定实体名称。&#xa;registration_no text NULL — 供应商公司注册或税务标识。&#xa;country_code char(2) NULL — 供应商所在 ISO 国家代码。&#xa;default_quote_currency_code char(3) NULL — 供应商常用报价币种；未知时为空，不覆盖 PO、收货或发票事实。&#xa;payment_terms_days integer NULL — 标准付款到期天数。&#xa;lead_time_days integer NULL — 未在 SKU 层覆盖时的标准交货提前期。&#xa;status text NN — PENDING、ACTIVE、SUSPENDED 或 RETIRED。&#xa;contact_data jsonb NN — 采购联系人和渠道的受限结构化信息。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="2840" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="table_84bdc2a99fc9d98d2e0b" value="scm_supplier_item&#xa;供应商商品&#xa;grain: 供应商 × 外部SKU × 生效版本一行&#xa;comment: 以版本行维护供应商 SKU、对应统一物料、包装换算、MOQ和商业条件；规格变化新增版本，不再拆一张一对一映射表。&#xa;fields:&#xa;supplier_item_id uuid NN — 供应商 SKU 的一个有效版本身份。&#xa;supplier_id uuid NN — SKU所属供应商。&#xa;supersedes_supplier_item_id uuid NULL — 本版本替代的上一版本；首次为空。&#xa;supplier_sku text NN — 供应商提供的稳定商品编号。&#xa;supplier_item_name text NN — 报价或目录中的原始名称。&#xa;order_unit_id uuid NN — PO 上使用的受控包装或计量单位。&#xa;material_id uuid NULL — 本版本确认对应的统一原料；尚未完成映射时为空。&#xa;material_unit_conversion_id uuid NULL — 把订购单位换算到物料基础单位的已核验规格；尚未核验时为空。&#xa;minimum_order_quantity numeric(18,4) NULL — 供应商要求的最小 order_unit 数量。&#xa;order_multiple numeric(18,4) NN — 允许下单数量的倍数。&#xa;lead_time_days integer NULL — 该 SKU 特有交货提前期。&#xa;valid_from timestamptz NN — 该映射和包装规格开始可用于业务的时间。&#xa;valid_to timestamptz NULL — 该映射停止适用的时间上界；仍有效时为空。&#xa;mapping_status text NN — PENDING、CONFIRMED、REJECTED 或 RETIRED。&#xa;evidence jsonb NN — 供应商规格、包装照片、称量、目录或迁移证据。&#xa;confirmed_by_user_id uuid NULL — 确认物料和包装规格的应用账号。&#xa;confirmed_at timestamptz NULL — 映射进入 CONFIRMED 的时间。&#xa;created_by_user_id uuid NULL — 触发该次人工或受控系统写入的应用账号。自动任务可以为空并由 job_run_id 追踪。&#xa;created_at timestamptz NN — 该行首次写入数据库的绝对时间。&#xa;updated_at timestamptz NN — 该行最后一次被允许修改的绝对时间。" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#666666;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="3400" y="10260" width="520" height="690" as="geometry"/></mxCell>
        <mxCell id="fk_7c15dc8a2f9e688fff1b" value="actor_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4569a99c8a1ee6e5c23b" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_cba732bc558335e1d8ae" value="job_run_id -&gt; job_run_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4569a99c8a1ee6e5c23b" target="table_4f6ea62cc923a3d9301a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_5f83335e988042950bdf" value="prompt_template_id -&gt; prompt_template_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4569a99c8a1ee6e5c23b" target="table_9defb840dc7aa3f24340"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_c3b5e85199236f9f25ea" value="approved_by_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4fccbcc4b4519408f142" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_a96a33916f8678de28f1" value="created_by_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4fccbcc4b4519408f142" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_4ff7a58c0459a1ff1761" value="approved_by_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_9defb840dc7aa3f24340" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_e437e1a730970dfa0d01" value="created_by_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_9defb840dc7aa3f24340" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_66d9b367588894646c9c" value="prompt_segment_id -&gt; prompt_segment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_94c45110e1de71c436c2" target="table_4fccbcc4b4519408f142"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_8786c1c1c0039c91aa95" value="prompt_template_id -&gt; prompt_template_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_94c45110e1de71c436c2" target="table_9defb840dc7aa3f24340"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_99e66afe6f14ddd56884" value="actor_user_id -&gt; user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_b264c2e28c9b744c5900" target="table_5351815c5d4500447d2c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_b2b41163305d4fe53976" value="job_run_id -&gt; job_run_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_b264c2e28c9b744c5900" target="table_4f6ea62cc923a3d9301a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_1e7b241741a39249f0e7" value="source_system_id -&gt; source_system_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_4f6ea62cc923a3d9301a" target="table_b6a904132dfc2107de2e"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_1d5ba08e6aa476502853" value="application_id -&gt; application_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_47ce1f088926483b80e8" target="table_ad16f1bd4b9975af8649"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_77588b1395ec99961bb2" value="campaign_member_id -&gt; campaign_member_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_47ce1f088926483b80e8" target="table_38e10284fb194b9412da"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fk_2284496eb7a2087ab7c7" value="member_id -&gt; member_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#6c8ebf;fontSize=8;" edge="1" parent="1" source="table_47ce1f088926483b80e8" target="table_4c6f71271790ec53c2ff"><mxGeometry relative="1" as="geometry"/></mxCell>
