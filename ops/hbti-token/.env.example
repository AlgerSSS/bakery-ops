# RES_VULCAN_TOKEN 轮换配置。root-only 0600。
# 本文件不含 RES_VULCAN_TOKEN —— 那个由 rotate.mjs 每次现借。

RES_BASE_URL=<填入实际值>
RES_CORPORATION_ID=<填入实际值>
RES_ORGANIZATION_ID=<填入实际值>
RES_ORGANIZATION_TYPE=<填入实际值>
RES_BRAND_ID=<填入实际值>
RES_SHOP_ID=<填入实际值>
RES_TENANT=<填入实际值>
RES_COUPON_TEMPLATE_NAME=<填入实际值>

VERCEL_PROJECT_ID=<填入实际值>
VERCEL_ORG_ID=<填入实际值>
VERCEL_SCOPE=algersss-projects
RES_API_ROOT=/opt/hotcrush/res_api
HBTI_DOMAIN=hbti-test.hotcrush.net
HBTI_HEALTH_URL=https://hbti-test.hotcrush.net/api/health

# ↓ 可选:Vercel 面板 Account Settings -> Tokens 新建(scope: algersss-projects)
# 留空时 run.sh 会干净地跳过并返回 78(EX_CONFIG),不告警 —— 因为轮换只是兜底，
# 日常保活靠 keepalive.sh，那条不需要任何凭据。填上则每 6 小时自动兜底一次。
VERCEL_TOKEN=

# 失败告警(留空则只写哨兵文件 logs/LAST_FAILURE，没有人会被主动通知)
# 生产填的是本机中转 ops/alert-relay(systemd hotcrush-alert-relay，只听 127.0.0.1:8791)，
# 它复用 /opt/hotcrush/scripts/lark_app.json 的应用凭据发 Lark 私聊 ——
# 这样不必再引入、保管、轮换一个 Lark 群机器人 webhook 那样的新长期密钥。
# 也可以直接填群机器人地址，keepalive.sh/run.sh 会自动切成 Lark 的包体格式。
ALERT_WEBHOOK=http://127.0.0.1:8791/alert
