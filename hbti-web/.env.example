# Independent key for encrypted OTP challenges and member sessions.
HBTI_AUTH_SECRET=
# Campaign idempotency key; member identity is the RES member_id from migration 066.
HBTI_CAMPAIGN_VERSION=2026-08-pistachio-v1
HBTI_LINK_BASE_URL=https://hbti-test.hotcrush.net
# 共享 Supabase 生产库（迁移 066 的 pos_member.hbti_* 状态、
# 077 的 hbti_gift_stock，以及 HBTI 身份验证/限流表）。
# 与财务站、~/hot/res_api、~/hot/bakery-ops 是同一个库、同一个 postgres 角色。
# Vercel 必须使用 Supabase transaction pooler 的 :6543 地址；:5432 会被运行时拒绝。
DATABASE_URL=
# pos_member 复合主键里的门店名，必须与 res_api 的 MEMBER_STORE 完全一致，
# 否则同一个会员会被写成两行。留空则用默认值 吉隆坡Pavilion门店。
HBTI_MEMBER_STORE=
CRON_SECRET=
# 人工复核/库存补偿失败的主动告警。生产环境必须配置；
# /api/health 会在缺失时返回 503，阻止发送活动批次。
ALERT_WEBHOOK=
RES_BASE_URL=https://bo.sea.restosuite.ai
RES_VULCAN_TOKEN=
RES_TENANT=
RES_CORPORATION_ID=450020844
RES_ORGANIZATION_ID=1991027325256417283
RES_ORGANIZATION_TYPE=7
RES_BRAND_ID=1990716608733069315
RES_SHOP_ID=406994127
RES_COUPON_TEMPLATE_NAME=Pistachio Green Jewel
RES_MEMBER_WALLET_URL=https://f4klzbmr9n2d.m.sea.restosuite.ai/couponIndex
RES_H5_BASE_URL=https://f4klzbmr9n2d.m.sea.restosuite.ai
RES_H5_CORPORATION_ID=450020844
RES_H5_APP_ID=1991043406914285569
RES_H5_CARD_PROGRAM_ID=1991044916737863680
# 同一应用部署在多个自有域名时的额外允许来源（CSRF Origin 白名单并集），
# 逗号分隔完整 origin。birthday 域名走动态生日卡，必须列上。
HBTI_EXTRA_ORIGINS=

# ── 生日贺卡（2026-08-15 动态化）──────────────────────────────
# 专属链接签名密钥：≥32 字节随机串，门店推送的链接靠它防伪。
# 与 scripts/generate-birthday-links.mjs 用的必须一致，轮换后旧链接立即失效。
BIRTHDAY_LINK_SECRET=
# 活动年度；默认按吉隆坡时区取当前年，跨年活动再显式指定。
BIRTHDAY_CAMPAIGN_YEAR=
# 预约需提前的天数（默认 2）与最远可约天数（默认 30）。
BIRTHDAY_PICKUP_LEAD_DAYS=
BIRTHDAY_PICKUP_WINDOW_DAYS=
# 等级 → 可选权益组（数组）的 JSON 覆盖。默认：L1=[]（只有贺卡）、
# L2=[免费巴斯克]、L3=[免费巴斯克, 450积分限自己]、L4=[免费巴斯克, 450积分可送亲友]；
# 未列等级落默认=只有贺卡。
BIRTHDAY_BENEFITS_JSON=
# 预约成功后的 Lark 群机器人 webhook；未配置时预约照常落库、通知记为 skipped。
BIRTHDAY_NOTIFY_WEBHOOK=
