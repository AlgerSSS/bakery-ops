        <mxCell id="p4_shift_req" value="&lt;b&gt;ops_shift_requirement&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;每时段需要多少岗位；关键岗位必须标明&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：班表 × 时段 × 岗位 × 工作站&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：shift_plan_id, role_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1E8;strokeColor=#D97706;fontColor=#7A3E00;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_2">
          <mxGeometry x="354" y="194" width="250" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="p4_shift_assign" value="&lt;b&gt;ops_shift_assignment&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;具体员工的起止时间、岗位和工作站&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：班表 × 雇佣关系 × 时间区间&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：employment_id, role_id&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EDFA;strokeColor=#7C5AA6;fontColor=#493263;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_2">
          <mxGeometry x="354" y="24" width="250" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="p4_gate" value="&lt;b&gt;发布门禁&lt;/b&gt;&lt;br&gt;所有 is_critical = true 的需求都已指派；&lt;br&gt;且被指派者在该日期具备岗位资格。&lt;br&gt;&lt;font color='#7D2525'&gt;不满足就不能发布班表。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C94A4A;fontColor=#7D2525;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_2">
