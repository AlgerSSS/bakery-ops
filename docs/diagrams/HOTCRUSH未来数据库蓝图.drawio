          <mxGeometry x="376" y="6" width="348" height="648" as="geometry"/>
        </mxCell>
        <mxCell id="group_4" value="没有来源、版本和责任人，就不是企业事实" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;fontColor=#d6b656;verticalAlign=top;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1486" y="116" width="1488" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p5_title" value="共享身份与治理&lt;br&gt;&lt;font style='font-size:13px;font-weight:normal'&gt;跨表抓取速度来自稳定 ID、来源批次和单一写者；不是来自模糊名称或万能宽表&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="0" y="810" width="320" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="p5_pos_source" value="&lt;b&gt;RES / POS 标识&lt;/b&gt;&lt;br&gt;item_id、menu/listing_id、shop_id" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A74B5;fontColor=#17324D;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_0">
