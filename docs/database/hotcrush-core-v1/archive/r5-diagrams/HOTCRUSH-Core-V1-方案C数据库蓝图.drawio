"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_question" target="chain_12_tbl_ops_role_training_requirement"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_ops_role_training_requirement" target="chain_12_tbl_hr_training_assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="training_assignment_id → training_assignment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_hr_training_assignment" target="chain_12_tbl_hr_training_result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_hr_training_result" target="chain_12_tbl_ops_shift_requirement"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="shift_requirement_id → shift_requirement_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_ops_shift_requirement" target="chain_12_tbl_ops_shift_assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="shift_assignment_id → shift_assignment_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_ops_shift_assignment" target="chain_12_tbl_hr_timesheet_entry"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_tbl_hr_timesheet_entry" target="chain_12_view_v_ops_shift_publish_readiness"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="location_id + business_date" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_view_v_ops_shift_publish_readiness" target="chain_12_view_v_ops_labor_productivity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_view_v_ops_labor_productivity" target="chain_12_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_12_joins" target="chain_12_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_12_title" label="端到端 12 · 培训资格到关键岗位班表与实际工时&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E12｜培训资格到关键岗位班表与实际工时 · 关键岗位是否安排了具备有效培训资格的人，实际上班多久？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_12_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;关键岗位是否安排了具备有效培训资格的人，实际上班多久？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="332.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_ops_role_training_requirement" label="&lt;b&gt;ops_role_training_requirement&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：定义岗位需要哪些课程、是否强制和有效期规则。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：岗位 × 课程 × 生效区间一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; role_training_requirement_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_course_id &lt;font color='#64748B'&gt;: uuid → hr_training_course.training_course_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ role_id + training_course_id + valid_from&lt;/font&gt;&lt;br&gt;&lt;font color='#7C3AED'&gt;EXCL NO_OVERLAP(role_id, training_course_id, daterange(valid_from, valid_to, &amp;#x27;[)&amp;#x27;))&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：运营与HR共同维护&lt;/font&gt;" link="data:page/id,detail-10-ops-roles"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1202.00" y="233.00" width="310.00" height="290.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_hr_training_assignment" label="&lt;b&gt;hr_training_assignment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录员工被要求完成的具体课程版本、期限和原因。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：雇佣关系 × 课程版本 × 一次指派一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_assignment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_course_version_id &lt;font color='#64748B'&gt;: uuid → hr_training_course_version.training_course_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; assigned_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HR或门店培训负责人&lt;/font&gt;" link="data:page/id,detail-23-hr-training"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1576.98" y="259.50" width="310.00" height="237.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_hr_training_result" label="&lt;b&gt;hr_training_result&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次课程学习或考试的分数、结果和资格有效期。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：培训指派 × 一次尝试一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; training_result_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; training_assignment_id &lt;font color='#64748B'&gt;: uuid → hr_training_assignment.training_assignment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; verified_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_from &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY ?&lt;/b&gt;&lt;/font&gt; valid_to &lt;font color='#64748B'&gt;: timestamptz&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ training_assignment_id + attempt_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：培训系统或负责人&lt;/font&gt;" link="data:page/id,detail-23-hr-training"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#667085;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="1952.02" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_ops_shift_requirement" label="&lt;b&gt;ops_shift_requirement&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[PLANNED]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：明确每个时段需要的岗位、工位、人数和关键岗位属性。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：班表版本 × 时段 × 岗位 × 工位一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; shift_requirement_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; shift_plan_version_id &lt;font color='#64748B'&gt;: uuid → ops_shift_plan_version.shift_plan_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; workload_line_id &lt;font color='#64748B'&gt;: uuid → ops_workload_line.workload_line_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND shift_plan_version_id + shift_start + shift_end + role_id + station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 排班流程&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#667085;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=9 5;strokeWidth=2.1;opacity=88;" vertex="1" parent="1"><mxGeometry x="2327.00" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_ops_shift_assignment" label="&lt;b&gt;ops_shift_assignment&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把合资格员工明确指派到班表时段、岗位和工位。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：班次需求 × 雇佣关系 × 一段指派一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; shift_assignment_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; shift_requirement_id &lt;font color='#64748B'&gt;: uuid → ops_shift_requirement.shift_requirement_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; override_approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 排班流程&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="251.00" width="310.00" height="254.00" as="geometry"/></mxCell></object><object id="chain_12_tbl_hr_timesheet_entry" label="&lt;b&gt;hr_timesheet_entry&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[SOURCE?]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存员工在地点、日期和工作区域的实际净工时原值与来源，不把班表当实际工时。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源工时记录 × 雇佣关系 × 地点 × 工作时段一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_WITH_SOURCE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; timesheet_entry_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; timesheet_sync_batch_id &lt;font color='#64748B'&gt;: uuid → hr_timesheet_sync_batch.timesheet_sync_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; employment_id &lt;font color='#64748B'&gt;: uuid → hr_employment.employment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; shift_assignment_id &lt;font color='#64748B'&gt;: uuid → ops_shift_assignment.shift_assignment_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; role_id &lt;font color='#64748B'&gt;: uuid → ops_role.role_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; station_id &lt;font color='#64748B'&gt;: uuid → ops_station.station_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ timesheet_sync_batch_id + source_entry_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：BakeryOps 工时同步任务&lt;/font&gt;" link="data:page/id,detail-24-hr-timesheet"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F1E9FA;strokeColor=#C94A4A;fontColor=#56357B;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;dashed=1;dashPattern=3 4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3077.02" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_12_view_v_ops_shift_publish_readiness" label="&lt;b&gt;v_ops_shift_publish_readiness&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：汇总班表版本的关键岗位覆盖、资格违规、需求人数和重叠指派。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：班表版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：ops_shift_plan / ops_shift_plan_version / ops_shift_requirement / ops_shift_assignment / v_hr_role_eligibility&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• shift_plan_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• required_headcount : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• assigned_headcount : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3452.01" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_12_view_v_ops_labor_productivity" label="&lt;b&gt;v_ops_labor_productivity&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：在地点营业日粒度比较实际净工时与 POS 净销售；不伪造产品级人工成本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：hr_timesheet_entry / v_pos_sales_day_current / ops_shift_assignment / ops_shift_requirement&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_work_minutes : bigint&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• net_work_hours : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-11-ops-shift"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF0E6;strokeColor=#E47A16;fontColor=#7A3C00;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3847.00" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_12_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 岗位要求使用 role_id + course_version_id + 有效期&lt;br&gt;2. 班表使用 employment_id + role_id + station_id，关键岗不得只写自由文本&lt;br&gt;3. 工时通过 employment_id + location_id + 时间重叠与班表核对"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="4242.02" y="290.00" width="500.00" height="176.00" as="geometry"/></mxCell></object><object id="chain_12_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;计划工时和实际工时分开；过期、失败或缺失培训结果时关键岗指派必须形成明确告警。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4807.01" y="322.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_12_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#E47A16'&gt;■&lt;/font&gt; &lt;b&gt;OPS&lt;/b&gt; = 地点、产品、预测、计划、执行与班表&lt;br&gt;&lt;font color='#8B5FBF'&gt;■&lt;/font&gt; &lt;b&gt;HR&lt;/b&gt; = 人员、招聘、培训与工时&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-13" name="E13｜会员关联商品到 HBTI 问卷和奖励"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="7254" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="298.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="199.50" width="4901.97" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="6120.99" y="214.00" width="1096.99" height="310.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.00" width="317.00" height="236.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_13_title" target="chain_13_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_question" target="chain_13_tbl_pos_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="member_id → member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_pos_member" target="chain_13_tbl_pos_member_card_transaction"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="order_id → order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_pos_member_card_transaction" target="chain_13_tbl_pos_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="order_id → order_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_pos_order" target="chain_13_tbl_pos_order_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="受控业务血缘" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_pos_order_item" target="chain_13_view_v_pos_order_member_attribution"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_view_v_pos_order_member_attribution" target="chain_13_view_v_pos_member_order_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_view_v_pos_member_order_item" target="chain_13_tbl_mkt_campaign_version"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="campaign_version_id → campaign_version_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_campaign_version" target="chain_13_tbl_mkt_campaign_member"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="campaign_member_id → campaign_member_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_campaign_member" target="chain_13_tbl_mkt_survey_response"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_10" value="survey_response_id → survey_response_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_survey_response" target="chain_13_tbl_mkt_survey_result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_11" value="survey_result_id → survey_result_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_survey_result" target="chain_13_tbl_mkt_reward_claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_12" value="reward_stock_id → reward_stock_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_reward_claim" target="chain_13_tbl_mkt_reward_stock"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_13" value="source feeds view" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_tbl_mkt_reward_stock" target="chain_13_view_v_mkt_reward_stock_reconciliation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_14" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_view_v_mkt_reward_stock_reconciliation" target="chain_13_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_15" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_13_joins" target="chain_13_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_13_title" label="端到端 13 · 会员关联商品到 HBTI 问卷和奖励&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E13｜会员关联商品到 HBTI 问卷和奖励 · 会员账号关联过哪些订单商品、口径是否唯一，又参加哪一版活动并获得什么奖励？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="325.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_13_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;会员账号关联过哪些订单商品、口径是否唯一，又参加哪一版活动并获得什么奖励？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="332.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_pos_member" label="&lt;b&gt;pos_member&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存会员非敏感稳定身份和当前来源覆盖状态；联系方式另表隔离。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每个企业内可识别的 POS 会员一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UPDATE&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; home_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; merged_into_member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-17-pos-member-identity"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_pos_member_card_transaction" label="&lt;b&gt;pos_member_card_transaction&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存充值、消费核销、退款和余额调整的不可变事件。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：每笔来源会员卡交易一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; member_card_transaction_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; member_card_id &lt;font color='#64748B'&gt;: uuid → pos_member_card.member_card_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid → pos_order.order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + source_transaction_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-18-pos-member-value"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_pos_order" label="&lt;b&gt;pos_order&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：只保存来源订单的稳定身份，不把尚未证明存在的订单头金额、状态或时间硬塞进同一行。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源系统 × 地点 × 外部订单ID一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; first_seen_pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ source_system_id + location_id + source_order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-16-pos-orders"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="259.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_pos_order_item" label="&lt;b&gt;pos_order_item&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：按一次来源批次保存订单内同一 listing 的合计数量与净额；这是当前可稳定重跑的最小商品粒度。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：POS批次 × 订单 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; order_item_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; pos_ingest_batch_id &lt;font color='#64748B'&gt;: uuid → pos_ingest_batch.pos_ingest_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; order_id &lt;font color='#64748B'&gt;: uuid → pos_order.order_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; listing_id &lt;font color='#64748B'&gt;: uuid → pos_product_listing.listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ pos_ingest_batch_id + order_id + listing_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：RES/POS 同步服务&lt;/font&gt;" link="data:page/id,detail-16-pos-orders"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_13_view_v_pos_order_member_attribution" label="&lt;b&gt;v_pos_order_member_attribution&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：从会员卡交易的订单连接计算唯一、歧义或未匹配归属，不在订单商品事实里复制会员ID。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：一个稳定订单一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：pos_order / pos_member_card_transaction / pos_member&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• source_order_id : text&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• resolved_member_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• candidate_member_count : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-16-pos-orders"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="2701.98" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_13_view_v_pos_member_order_item" label="&lt;b&gt;v_pos_member_order_item&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：把当前订单商品、可解释会员归属和发生时点产品映射组合成个性化分析的唯一只读入口。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日 × 订单 × listing 一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_pos_order_item_current / v_pos_order_member_attribution / pos_product_mapping / ops_product&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• order_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• resolved_member_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• attribution_status : text&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-16-pos-orders"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#E3F6F5;strokeColor=#249C98;fontColor=#155D5A;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3096.98" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_campaign_version" label="&lt;b&gt;mkt_campaign_version&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：冻结活动时间窗、适用地点、参与规则、问卷结构版本和奖励政策。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动 × 版本号一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; campaign_version_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; campaign_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign.campaign_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ campaign_id + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：营销/HBTI后台&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3492.03" y="233.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_campaign_member" label="&lt;b&gt;mkt_campaign_member&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录会员在某活动版本中的资格、邀请、开始、完成和取消历史，不再把活动状态覆盖在 pos_member 当前快照上。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动版本 × 会员一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; campaign_member_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; campaign_version_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_version.campaign_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; member_id &lt;font color='#64748B'&gt;: uuid → pos_member.member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ campaign_version_id + member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：营销/HBTI后台&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3867.01" y="259.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_survey_response" label="&lt;b&gt;mkt_survey_response&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存会员对某活动版本的一次完整或部分问卷尝试。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动会员 × 尝试次数一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; survey_response_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; campaign_member_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_member.campaign_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ campaign_member_id + attempt_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HBTI应用&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4241.98" y="267.50" width="310.00" height="221.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_survey_result" label="&lt;b&gt;mkt_survey_result&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存一次已验证问卷作答经具体算法版本计算出的 HBTI 类型或其他可复算测评结果，不把结果只留在会员当前快照。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：问卷作答 × 结果类型 × 算法版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_FROZEN_DERIVED · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; survey_result_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; survey_response_id &lt;font color='#64748B'&gt;: uuid → mkt_survey_response.survey_response_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ survey_response_id + result_type + algorithm_version&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HBTI结果计算服务&lt;/font&gt;" link="data:page/id,detail-40-mkt-campaign-survey"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4617.03" y="267.50" width="310.00" height="221.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_reward_claim" label="&lt;b&gt;mkt_reward_claim&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录会员选择、预留、发放、到期或取消一份奖励的完整状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动会员 × 一次奖励领取一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_WORKFLOW · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; reward_claim_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; campaign_member_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_member.campaign_member_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; reward_stock_id &lt;font color='#64748B'&gt;: uuid → mkt_reward_stock.reward_stock_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; survey_result_id &lt;font color='#64748B'&gt;: uuid → mkt_survey_result.survey_result_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; redeemed_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quantity &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HBTI/营销库存服务&lt;/font&gt;" link="data:page/id,detail-41-mkt-reward"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4992.01" y="242.50" width="310.00" height="271.00" as="geometry"/></mxCell></object><object id="chain_13_tbl_mkt_reward_stock" label="&lt;b&gt;mkt_reward_stock&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存活动版本、地点和奖励的可用、预留和已发数量。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动版本 × 地点 × 奖励一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：WORKFLOW&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; reward_stock_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; campaign_version_id &lt;font color='#64748B'&gt;: uuid → mkt_campaign_version.campaign_version_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; reward_id &lt;font color='#64748B'&gt;: uuid → mkt_reward.reward_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND campaign_version_id + location_id + reward_id&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：HBTI/营销库存服务&lt;/font&gt;" link="data:page/id,detail-41-mkt-reward"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5366.98" y="250.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_13_view_v_mkt_reward_stock_reconciliation" label="&lt;b&gt;v_mkt_reward_stock_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较奖励库存事务控制行与领取事实按状态汇总的数量，识别并发失败或异常修复造成的漂移。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：活动版本 × 地点 × 奖励一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：mkt_reward_stock / mkt_reward_claim&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• reward_stock_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• campaign_version_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• reward_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• cached_reserved_quantity : integer&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-41-mkt-reward"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCE8F3;strokeColor=#C94F8C;fontColor=#793052;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="5741.97" y="269.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_13_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 订单商品使用 batch_id + order_id + listing_id；同批重复来源行 SUM 并保留 source_row_count，不做 DISTINCT&lt;br&gt;2. 会员卡流水通过 source_system_id + location_id + source_order_id 解析 order_id；恰好一个不同 member_id 才标 UNIQUE&lt;br&gt;3. v_pos_member_order_item 只做派生连接，保留 AMBIGUOUS/UNMATCHED、产品映射状态和 MEMBER_FLAGGED_ONLY 覆盖口径&lt;br&gt;4. campaign_member 使用 member_id + campaign_version_id&lt;br&gt;5. survey_result 使用 survey_response_id + result_type + algorithm_version，现有 hbti_code 迁 result_code；campaign_version 明确钉住正式算法版本&lt;br&gt;6. reward_claim 连接 campaign_member_id + survey_result_id + reward_stock_id，并原子更新 reward_stock；核对视图独立复算缓存计数"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="6136.99" y="248.00" width="500.00" height="260.00" as="geometry"/></mxCell></object><object id="chain_13_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;POS 会员主档不保存商品偏好或某次活动当前结果；个性化文案只能说账号关联订单中记录了什么，不能把共享卡、团购或多人订单推断成本人亲自消费。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="6701.98" y="322.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_13_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#249C98'&gt;■&lt;/font&gt; &lt;b&gt;POS&lt;/b&gt; = POS目录、销售与会员&lt;br&gt;&lt;font color='#C94F8C'&gt;■&lt;/font&gt; &lt;b&gt;MKT&lt;/b&gt; = 营销、HBTI问卷与奖励&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.00" width="285.00" height="186.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
<diagram id="e2e-14" name="E14｜财务导入到独立核对口径"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4985" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object id="layout_group_0" label="01 问题"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="701.02" y="280.00" width="452.00" height="142.00" as="geometry"/></mxCell></object><object id="layout_group_1" label="02 业务链路"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1186.00" y="181.50" width="2632.02" height="339.00" as="geometry"/></mxCell></object><object id="layout_group_2" label="03 规则与门禁"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="3850.98" y="224.00" width="1097.05" height="254.00" as="geometry"/></mxCell></object><object id="layout_group_3" label="99 颜色图例"><mxCell style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fillColor=#F8FAFC;fillOpacity=35;strokeColor=#CBD5E1;dashed=1;dashPattern=5 4;fontColor=#475569;fontStyle=1;fontSize=12;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="193.50" y="59.50" width="317.00" height="217.00" as="geometry"/></mxCell></object><mxCell id="layout_edge_0" value="" style="endArrow=none;strokeOpacity=0;html=1;" edge="1" parent="1" source="chain_14_title" target="chain_14_question"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_1" value="业务入口" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_question" target="chain_14_tbl_finance_import_batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_2" value="finance_import_batch_id → finance_import_batch_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_tbl_finance_import_batch" target="chain_14_tbl_finance_sales_daily"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_3" value="location_id + currency" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_tbl_finance_sales_daily" target="chain_14_tbl_finance_monthly_cost_line"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_4" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_tbl_finance_monthly_cost_line" target="chain_14_tbl_finance_monthly_metric"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_5" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_tbl_finance_monthly_metric" target="chain_14_tbl_finance_target"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_6" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_tbl_finance_target" target="chain_14_view_v_finance_sales_reconciliation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_7" value="location_id" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_view_v_finance_sales_reconciliation" target="chain_14_view_v_finance_margin_reconciliation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_8" value="解释关系" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_view_v_finance_margin_reconciliation" target="chain_14_joins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layout_edge_9" value="质量门禁" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#4A74B5;strokeWidth=1.8;fontColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chain_14_joins" target="chain_14_control"><mxGeometry relative="1" as="geometry"/></mxCell><object id="chain_14_title" label="端到端 14 · 财务导入到独立核对口径&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;E14｜财务导入到独立核对口径 · 财务模板与 POS、采购和工时不一致时，如何保留双方事实并查出差异？&lt;/font&gt;"><mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#17324D;strokeColor=#17324D;fontColor=#FFFFFF;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;spacingLeft=18;spacingRight=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="52.00" y="307.50" width="600.00" height="105.00" as="geometry"/></mxCell></object><object id="chain_14_question" label="&lt;b&gt;要回答的问题&lt;/b&gt;&lt;br&gt;财务模板与 POS、采购和工时不一致时，如何保留双方事实并查出差异？"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="717.02" y="314.00" width="420.00" height="92.00" as="geometry"/></mxCell></object><object id="chain_14_tbl_finance_import_batch" label="&lt;b&gt;finance_import_batch&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：记录财务模板、银行文件或人工数据每次导入的文件、期间、校验值和批准状态。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：来源文件或数据集 × 一次导入一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：UNTIL TERMINAL&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_TECHNICAL · PASS_WITH_RECONCILIATION_OR_FREEZE_GUARD&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; finance_import_batch_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; source_system_id &lt;font color='#64748B'&gt;: uuid → app_source_system.source_system_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; job_run_id &lt;font color='#64748B'&gt;: uuid → app_job_run.job_run_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; scope_location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; supersedes_finance_import_batch_id &lt;font color='#64748B'&gt;: uuid → finance_import_batch.finance_import_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ ND dataset_code + file_sha256&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务网站&lt;/font&gt;" link="data:page/id,detail-36-finance-sales"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1202.00" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_14_tbl_finance_sales_daily" label="&lt;b&gt;finance_sales_daily&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存财务模板口径的门店日销售，保持与 POS 事实独立用于核对。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：财务批次 × 地点 × 日期一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; finance_sales_daily_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; finance_import_batch_id &lt;font color='#64748B'&gt;: uuid → finance_import_batch.finance_import_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; business_date &lt;font color='#64748B'&gt;: date&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; net_sales &lt;font color='#64748B'&gt;: numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ finance_import_batch_id + location_id + business_date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务网站&lt;/font&gt;" link="data:page/id,detail-36-finance-sales"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1576.98" y="215.50" width="310.00" height="289.00" as="geometry"/></mxCell></object><object id="chain_14_tbl_finance_monthly_cost_line" label="&lt;b&gt;finance_monthly_cost_line&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：用统一粒度保存材料、人工、仓运和期间费用，同时保留类别和组织来源。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：财务批次 × 地点 × 月份 × 成本域 × 类别 × 子类 × 组织或来源一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; finance_monthly_cost_line_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; finance_import_batch_id &lt;font color='#64748B'&gt;: uuid → finance_import_batch.finance_import_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; currency &lt;font color='#64748B'&gt;: char(3)&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ finance_import_batch_id + source_row_ref&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务网站&lt;/font&gt;" link="data:page/id,detail-38-finance-cost-cash"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1952.02" y="232.50" width="310.00" height="255.00" as="geometry"/></mxCell></object><object id="chain_14_tbl_finance_monthly_metric" label="&lt;b&gt;finance_monthly_metric&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存财务模板提供的营业利润、净利润、摊销费、储值净额等标准月指标。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：财务批次 × 地点 × 月份 × 指标代码一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：APPEND&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_BASE · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; finance_monthly_metric_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; finance_import_batch_id &lt;font color='#64748B'&gt;: uuid → finance_import_batch.finance_import_batch_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; quality_status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ finance_import_batch_id + location_id + business_month + metric_code&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务网站&lt;/font&gt;" link="data:page/id,detail-37-finance-target-metric"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2327.00" y="241.00" width="310.00" height="238.00" as="geometry"/></mxCell></object><object id="chain_14_tbl_finance_target" label="&lt;b&gt;finance_target&lt;/b&gt; &lt;font color='#64748B'&gt;&lt;b&gt;[CORE]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：保存地点、月份和指标的目标值及版本。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 月份 × 指标代码 × 版本一行&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入策略：DRAFT→FROZEN&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;存储终审：KEEP_MASTER · PASS_MINIMUM_GRAIN&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#B42318'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; finance_target_id &lt;font color='#64748B'&gt;: uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; location_id &lt;font color='#64748B'&gt;: uuid → ops_location.location_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; approved_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#1D4ED8'&gt;&lt;b&gt;FK ?&lt;/b&gt;&lt;/font&gt; created_by_user_id &lt;font color='#64748B'&gt;: uuid → app_user.user_id&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; version_no &lt;font color='#64748B'&gt;: integer&lt;/font&gt;&lt;br&gt;&lt;font color='#59636E'&gt;&lt;b&gt;KEY&lt;/b&gt;&lt;/font&gt; status &lt;font color='#64748B'&gt;: text&lt;/font&gt;&lt;br&gt;&lt;font color='#9A6700'&gt;UQ NND location_id + business_month + metric_code + version_no&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;写入：财务网站&lt;/font&gt;" link="data:page/id,detail-37-finance-target-metric"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;spacingBottom=7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2701.98" y="224.00" width="310.00" height="272.00" as="geometry"/></mxCell></object><object id="chain_14_view_v_finance_sales_reconciliation" label="&lt;b&gt;v_finance_sales_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较财务日销售与POS日销售，保留两侧口径和差异而不互相覆盖。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 营业日一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：finance_sales_daily / v_finance_import_batch_current / v_pos_sales_day_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_date : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• pos_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• finance_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• difference_amount : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-36-finance-sales"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3077.03" y="251.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_14_view_v_finance_margin_reconciliation" label="&lt;b&gt;v_finance_margin_reconciliation&lt;/b&gt; &lt;font color='#967A22'&gt;&lt;b&gt;[VIEW]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#334155'&gt;用途：比较产品日毛利聚合与财务月度利润指标，并显示成本覆盖。&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;粒度：地点 × 月份一行&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;血缘：v_cost_card_product_daily_margin / finance_monthly_metric / finance_sales_daily / v_finance_import_batch_current&lt;/font&gt;&lt;br&gt;&lt;font color='#CBD5E1'&gt;────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• location_id : uuid&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• business_month : date&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• ops_net_sales : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• ops_cogs : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;• ops_gross_margin : numeric(18,4)&lt;/font&gt;&lt;br&gt;&lt;font color='#967A22'&gt;只读；不接受业务写入&lt;/font&gt;" link="data:page/id,detail-38-finance-cost-cash"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFE8EA;strokeColor=#D9534F;fontColor=#7F2926;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="3472.02" y="251.50" width="330.00" height="217.00" as="geometry"/></mxCell></object><object id="chain_14_joins" label="&lt;b&gt;连接规则&lt;/b&gt;&lt;br&gt;1. 所有财务事实先回指 import_batch_id，并使用 location_id + 日期/月 + currency&lt;br&gt;2. import_batch 明确 source_layer、recognition_status 与 supersedes；raw、management report 和 posted ledger 分层读取&lt;br&gt;3. 与 POS、供应链、工时只在治理视图核对，不覆盖来源表&lt;br&gt;4. target 是版本化目标；metric 保留来源口径代码"><mxCell style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDF3;strokeColor=#B88916;fontColor=#5F4B12;align=left;verticalAlign=top;fontSize=12;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="3866.98" y="258.00" width="500.00" height="204.00" as="geometry"/></mxCell></object><object id="chain_14_control" label="&lt;b&gt;必须阻断/标记的情况&lt;/b&gt;&lt;br&gt;差异是一条需要解释的事实，不以最后写入者为准；来源缺失不得补 0。"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE9E9;strokeColor=#D9534F;fontColor=#7F2926;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="4432.03" y="304.00" width="500.00" height="112.00" as="geometry"/></mxCell></object><object id="chain_14_legend" label="&lt;b&gt;颜色图例&lt;/b&gt;&lt;br&gt;&lt;font color='#D9534F'&gt;■&lt;/font&gt; &lt;b&gt;FINANCE&lt;/b&gt; = 财务来源事实与核对&lt;br&gt;&lt;b&gt;━ 实线边框&lt;/b&gt; = CORE_MIGRATION，承接现有数据/契约&lt;br&gt;&lt;b&gt;┄ 长虚线灰边&lt;/b&gt; = PLANNED_MODULE，批准模块后才实施&lt;br&gt;&lt;font color='#C94A4A'&gt;&lt;b&gt;┄ 短虚线红边&lt;/b&gt;&lt;/font&gt; = SOURCE_CONDITIONAL，先验证外部来源&lt;br&gt;&lt;b&gt;圆角虚线框 VIEW&lt;/b&gt; = 治理视图，只读分析接口&lt;br&gt;&lt;font color='#9A6700'&gt;&lt;b&gt;UQ NND&lt;/b&gt;&lt;/font&gt; = 空值也算重复；&lt;b&gt;UQ ND&lt;/b&gt; = 只限制非空值&lt;br&gt;&lt;font color='#7C3AED'&gt;&lt;b&gt;EXCL&lt;/b&gt;&lt;/font&gt; = 正式生效区间禁止重叠；统一 [from, to)"><mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="209.50" y="93.50" width="285.00" height="167.00" as="geometry"/></mxCell></object></root></mxGraphModel></diagram>
