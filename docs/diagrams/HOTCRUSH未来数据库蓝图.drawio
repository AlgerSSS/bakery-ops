        </mxCell>
        <mxCell id="p4_sync" value="&lt;b&gt;hr_timesheet_sync_batch&lt;/b&gt;&lt;br&gt;&lt;font color='#455160'&gt;Lark 月度实际工时读取批次&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;粒度：来源文件 × sheet × 读取时间&lt;/font&gt;&lt;br&gt;&lt;font color='#6C7683'&gt;关键键：batch_id, source&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A74B5;fontColor=#17324D;align=left;verticalAlign=middle;fontSize=13;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1.5;" vertex="1" parent="group_3">
